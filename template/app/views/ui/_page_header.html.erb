<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div class="min-w-0">
    <% if breadcrumbs.present? %>
      <nav aria-label="<%= t("ui.breadcrumbs") %>" class="mb-2 flex flex-wrap items-center gap-1 text-sm text-muted">
        <% breadcrumbs.each_with_index do |(name, path), index| %>
          <% if index.positive? %>
            <span aria-hidden="true">/</span>
          <% end %>
          <% if path.present? && index < breadcrumbs.length - 1 %>
            <%= link_to name, path, class: "hover:text-ink" %>
          <% else %>
            <span class="text-ink"><%= name %></span>
          <% end %>
        <% end %>
      </nav>
    <% end %>
    <h1 class="text-2xl font-semibold tracking-tight text-ink"><%= title %></h1>
    <% if description %>
      <p class="mt-1 max-w-2xl text-sm text-muted"><%= description %></p>
    <% end %>
  </div>
  <% if actions %>
    <div class="flex flex-wrap items-center gap-2"><%= actions %></div>
  <% end %>
</div>
