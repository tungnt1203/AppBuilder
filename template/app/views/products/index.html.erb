<% content_for :title, t(".title") %>

<div class="mx-auto max-w-6xl px-4 py-12">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h1 class="font-display text-3xl font-semibold tracking-tight"><%= t(".title") %></h1>
    <%= form_with url: products_path, method: :get, class: "flex flex-wrap items-center gap-2", data: { controller: "autosubmit", turbo_action: "replace" } do |form| %>
      <%= form.search_field :q, value: params[:q], placeholder: t(".search"), aria: { label: t(".search") }, class: "w-44 #{field_classes}" %>
      <%= form.select :sort, ProductsController::SORTS.keys.map { |sort| [ t(".sorts.#{sort}"), sort ] }, { selected: @sort },
            aria: { label: t(".sort") }, class: "w-auto #{field_classes}", data: { action: "autosubmit#submit" } %>
    <% end %>
  </div>

  <div class="mt-8">
    <% if @page.records.any? %>
      <%= render "products/grid", products: @page.records %>
      <%= render "ui/pagination", page: @page %>
    <% else %>
      <p class="rounded-xl border border-dashed border-line px-6 py-16 text-center text-muted">
        <%= params[:q].present? ? t(".no_results", query: params[:q]) : t(".empty") %>
      </p>
    <% end %>
  </div>
</div>
