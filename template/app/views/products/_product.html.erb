<%# A product in a grid: photo, title, price, and a sale badge when one of its variants is on sale. %>
<% on_sale = product.variants.any?(&:on_sale?) %>
<%= link_to product_path(product), class: "group block" do %>
  <div class="relative aspect-4/5 overflow-hidden rounded-xl">
    <%= product_image product, size: :card, class: "size-full transition duration-300 group-hover:scale-[1.03]" %>
    <% if on_sale && product.available? %>
      <span class="absolute top-3 left-3 rounded-full bg-brand-600 px-2.5 py-1 text-xs font-semibold text-white"><%= t("products.product.sale") %></span>
    <% end %>
  </div>
  <h3 class="mt-3 text-sm font-medium text-ink"><%= product.title %></h3>
  <p class="mt-1 text-sm text-muted">
    <%= price_range(product) %>
    <% if on_sale && product.price_range&.uniq&.one? && (variant = product.variants.find(&:on_sale?)) %>
      <s class="ml-1"><%= money(variant.compare_at_price_cents) %></s>
    <% end %>
    <% unless product.available? %>
      · <%= t("products.product.sold_out") %>
    <% end %>
  </p>
<% end %>
