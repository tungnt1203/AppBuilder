<%= page_header t(".title"), t(".description") do %>
  <%= link_to t(".new"), new_admin_service_path, class: button_classes %>
<% end %>

<% if @services.any? %>
  <%= card padded: false do %>
    <ul class="divide-y divide-line">
      <% @services.each do |service| %>
        <li>
          <%= link_to edit_admin_service_path(service), class: "flex items-center gap-4 px-6 py-3 hover:bg-surface-muted" do %>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-medium text-ink"><%= service.name %></span>
              <span class="block truncate text-xs text-muted">
                <%= t("booking.minutes", count: service.duration_minutes) %> ·
                <%= service.staff_members.any? ? service.staff_members.map(&:name).to_sentence : t(".nobody") %>
              </span>
            </span>
            <span class="text-sm text-ink"><%= money(service.price_cents) %></span>
            <% if service.hidden? %><%= badge t(".hidden") %><% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% else %>
  <%= empty_state t(".empty_title"), t(".empty_description") do %>
    <%= link_to t(".new"), new_admin_service_path, class: button_classes %>
  <% end %>
<% end %>
