<%= form_with model: [ :admin, product ], class: "grid gap-6 lg:grid-cols-[1fr_20rem]" do |form| %>
  <div class="min-w-0 space-y-6">
    <%= form.errors %>

    <%= card class: "space-y-4" do %>
      <%= form.field :title, required: true, autofocus: product.new_record? %>
      <%= form.field :description, :text_area, rows: 6 %>
      <%= form.field :size_guide, :text_area, rows: 5, class: "font-mono text-sm", placeholder: "Size | Chest (in) | Length (in)\nS | 18 | 28\nM | 20 | 29", hint: t(".size_guide_hint") %>
    <% end %>

    <%= card do %>
      <h2 class="text-sm font-semibold text-ink"><%= t(".photos") %></h2>
      <% if product.persisted? && product.images.attached? %>
        <%# Which color (or other option value) each photo shows: picking it on the site shows the photo. %>
        <% _slot, photo_option_name, photo_option_values = product.options.find { |_, name, _| color_option?(name) } || product.options.first %>
        <ul class="mt-4 flex flex-wrap gap-3">
          <% product.images.each do |image| %>
            <li class="relative w-24">
              <%= product_image product, image:, size: :thumb, class: "size-24 rounded-lg" %>
              <% if photo_option_values %>
                <%= select_tag "product[photo_options][#{image.id}]", options_for_select([ [ "—", "" ] ] + photo_option_values, product.photo_option(image)),
                      class: "mt-1.5 w-full rounded-md border border-line bg-surface px-1.5 py-1 text-xs", aria: { label: t(".photo_shows", option: photo_option_name) } %>
              <% end %>
              <%# Removing is a separate form (forms can't nest), tied to its button with form=. %>
              <button type="submit" form="<%= dom_id(image, :remove) %>" class="absolute -top-2 -right-2 grid size-6 place-items-center rounded-full bg-surface text-muted shadow ring-1 ring-line hover:text-red-600" aria-label="<%= t(".remove_photo") %>">
                <%= icon "x", size: 14 %>
              </button>
            </li>
          <% end %>
        </ul>
      <% end %>
      <div class="mt-4 space-y-1.5">
        <%= form.label :images, t(".add_photos") %>
        <%= form.file_field :images, multiple: true, accept: "image/*" %>
        <p class="text-xs text-muted"><%= t(".photos_hint") %></p>
      </div>
    <% end %>

    <%= card do %>
      <h2 class="text-sm font-semibold text-ink"><%= t(".options") %></h2>
      <p class="mt-1 text-sm text-muted"><%= t(".options_hint") %></p>
      <div class="mt-4 space-y-4">
        <% Product::OPTION_SLOTS.each do |slot| %>
          <div class="grid gap-3 sm:grid-cols-[10rem_1fr]">
            <%= form.field :"option#{slot}_name", label: t(".option_name", number: slot), placeholder: t(".option_name_examples.#{slot}") %>
            <%= form.field :"option#{slot}_values_text", label: t(".option_values"), placeholder: t(".option_values_examples.#{slot}") %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if product.persisted? && product.variants.any? %>
      <%= card padded: false do %>
        <div class="px-6 pt-6">
          <h2 class="text-sm font-semibold text-ink"><%= product.has_options? ? t(".variants") : t(".pricing") %></h2>
        </div>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-surface-muted text-left text-xs text-muted">
              <tr>
                <% if product.has_options? %><th class="px-6 py-2 font-medium"><%= t(".variant") %></th><% end %>
                <th class="px-3 py-2 font-medium"><%= Variant.human_attribute_name(:price) %></th>
                <th class="px-3 py-2 font-medium"><%= Variant.human_attribute_name(:compare_at_price) %></th>
                <th class="px-3 py-2 font-medium"><%= Variant.human_attribute_name(:sku) %></th>
                <th class="px-3 py-2 font-medium"><%= Variant.human_attribute_name(:cost) %></th>
                <th class="px-3 py-2 font-medium"><%= Variant.human_attribute_name(:track_inventory) %></th>
                <th class="px-3 py-2 font-medium"><%= Variant.human_attribute_name(:inventory_quantity) %></th>
                <th class="px-3 py-2 pr-6 font-medium"><%= Variant.human_attribute_name(:available) %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              <%= form.fields_for :variants do |fields| %>
                <tr>
                  <% if product.has_options? %><td class="px-6 py-2 whitespace-nowrap text-ink"><%= fields.object.title %></td><% end %>
                  <td class="px-3 py-2"><%= fields.number_field :price, step: 0.01, min: 0, required: true, class: "min-w-24", aria: { label: Variant.human_attribute_name(:price) } %></td>
                  <td class="px-3 py-2"><%= fields.number_field :compare_at_price, step: 0.01, min: 0, class: "min-w-24", aria: { label: Variant.human_attribute_name(:compare_at_price) } %></td>
                  <td class="px-3 py-2"><%= fields.text_field :sku, class: "min-w-28", aria: { label: Variant.human_attribute_name(:sku) } %></td>
                  <td class="px-3 py-2"><%= fields.number_field :cost, step: 0.01, min: 0, class: "min-w-24", aria: { label: Variant.human_attribute_name(:cost) } %></td>
                  <td class="px-3 py-2"><%= fields.check_box :track_inventory, aria: { label: Variant.human_attribute_name(:track_inventory) } %></td>
                  <td class="px-3 py-2"><%= fields.number_field :inventory_quantity, min: 0, step: 1, class: "w-20", aria: { label: Variant.human_attribute_name(:inventory_quantity) } %></td>
                  <td class="px-3 py-2 pr-6"><%= fields.check_box :available, aria: { label: Variant.human_attribute_name(:available) } %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <p class="px-6 py-4 text-xs text-muted"><%= t(".variants_hint") %></p>
      <% end %>
    <% end %>
  </div>

  <div class="space-y-6">
    <%= card class: "space-y-4" do %>
      <div class="space-y-1.5">
        <%= form.label :status %>
        <%= form.select :status, Product.statuses.keys.map { |status| [ t(status, scope: "products.statuses"), status ] } %>
        <p class="text-xs text-muted"><%= t(".status_hint") %></p>
      </div>
      <% if product.new_record? || product.variants.empty? %>
        <%= form.field :base_price, :number_field, step: 0.01, min: 0, required: true, hint: t(".base_price_hint") %>
      <% end %>
      <% if product.persisted? %>
        <%= form.field :slug, hint: t(".slug_hint", url: product_url(product)) %>
      <% end %>
    <% end %>

    <% collections = Collection.ordered %>
    <% if collections.any? %>
      <%= card do %>
        <fieldset>
          <legend class="text-sm font-semibold text-ink"><%= t(".collections") %></legend>
          <%= hidden_field_tag "product[collection_ids][]", "" %>
          <div class="mt-3 space-y-2">
            <% collections.each do |collection| %>
              <label class="flex items-center gap-2 text-sm">
                <%= check_box_tag "product[collection_ids][]", collection.id, product.collection_ids.include?(collection.id), id: dom_id(collection, :product), class: "size-4 rounded border-line accent-brand-600" %>
                <%= collection.title %>
              </label>
            <% end %>
          </div>
        </fieldset>
      <% end %>
    <% end %>

    <%= form.submit product.new_record? ? t(".create") : t(".save"), class: "w-full" %>
  </div>
<% end %>

<% if product.persisted? %>
  <% product.images.each do |image| %>
    <%= form_with url: admin_product_image_path(product, image), method: :delete, id: dom_id(image, :remove), class: "hidden" do %><% end %>
  <% end %>
<% end %>
