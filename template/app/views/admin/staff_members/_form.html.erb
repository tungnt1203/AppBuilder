<%= form_with model: [ :admin, staff_member ], class: "max-w-2xl space-y-6" do |form| %>
  <%= card class: "space-y-4" do %>
    <%= form.errors %>
    <%= form.field :name, required: true, autofocus: staff_member.new_record? %>
    <%= form.field :bio, :text_area, rows: 3, hint: t(".bio_hint") %>
    <%= form.field :photo, :file_field, accept: "image/*" %>
    <label class="flex items-center gap-2 text-sm">
      <%= form.check_box :active %>
      <%= StaffMember.human_attribute_name(:active) %>
    </label>
  <% end %>

  <%= card do %>
    <h2 class="text-sm font-semibold text-ink"><%= t(".hours") %></h2>
    <p class="mt-1 text-sm text-muted"><%= t(".hours_hint") %></p>
    <div class="mt-4 divide-y divide-line">
      <% StaffMember::WEEKDAYS.rotate(1).each do |weekday| %>
        <% rows = staff_member.working_hours.select { |hours| hours.weekday == weekday } %>
        <% rows = [ staff_member.working_hours.build(weekday:) ] if rows.empty? %>
        <div class="grid grid-cols-[6rem_1fr] items-start gap-3 py-2">
          <span class="pt-2 text-sm font-medium text-ink"><%= weekday_name(weekday) %></span>
          <div class="space-y-2">
            <% rows.each do |hours| %>
              <%= form.fields_for :working_hours, hours do |fields| %>
                <%= fields.hidden_field :weekday %>
                <div class="flex items-center gap-2">
                  <%= fields.text_field :opens_at_text, placeholder: t(".day_off"), inputmode: "numeric", class: "w-24", aria: { label: t(".from", day: weekday_name(weekday)) } %>
                  <span class="text-muted">–</span>
                  <%= fields.text_field :closes_at_text, inputmode: "numeric", class: "w-24", aria: { label: t(".until", day: weekday_name(weekday)) } %>
                </div>
                <% hours.errors.full_messages.each do |message| %>
                  <p class="text-xs text-red-600"><%= message %></p>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= card do %>
    <fieldset>
      <legend class="text-sm font-semibold text-ink"><%= StaffMember.human_attribute_name(:service_ids) %></legend>
      <%= hidden_field_tag "staff_member[service_ids][]", "" %>
      <% services = Service.ordered %>
      <% if services.any? %>
        <div class="mt-3 space-y-2">
          <% services.each do |service| %>
            <label class="flex items-center gap-2 text-sm">
              <%= check_box_tag "staff_member[service_ids][]", service.id, staff_member.service_ids.include?(service.id), id: dom_id(service, :staff_member), class: "size-4 rounded border-line accent-brand-600" %>
              <%= service.name %>
            </label>
          <% end %>
        </div>
      <% else %>
        <p class="mt-2 text-sm text-muted"><%= t(".no_services_html", link: link_to(t(".add_service"), new_admin_service_path, class: link_classes)) %></p>
      <% end %>
    </fieldset>
  <% end %>

  <%= form.submit staff_member.new_record? ? t(".create") : t(".save") %>
<% end %>
