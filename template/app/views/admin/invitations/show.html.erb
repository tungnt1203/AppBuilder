<% content_for :title, t(".title") %>

<h1 class="text-2xl font-semibold tracking-tight"><%= t(".heading", name: @user.name) %></h1>
<p class="mt-2 mb-8 text-[0.9375rem] leading-relaxed text-muted"><%= t(".description", email: @user.email_address) %></p>

<%= form_with model: @user, url: admin_invitation_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
  <%= form.errors %>
  <%= form.field :password, :password_field, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72 %>
  <%= form.submit t(".submit"), class: "w-full" %>
<% end %>
