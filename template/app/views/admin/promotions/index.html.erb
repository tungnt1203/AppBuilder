<%= page_header t(".title"), t(".description") do %>
  <%= link_to t(".new"), new_admin_promotion_path, class: button_classes %>
<% end %>

<% if @promotions.any? %>
  <%= card padded: false do %>
    <ul class="divide-y divide-line">
      <% @promotions.each do |promotion| %>
        <li class="flex items-center gap-4 px-6 py-3">
          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-medium text-ink"><%= promotion.name %> · <%= promotion.percent_off.positive? ? "-#{promotion.percent_off}%" : "+#{-promotion.percent_off}%" %></span>
            <span class="block truncate text-xs text-muted">
              <%= l(promotion.starts_at, format: :short) %> – <%= l(promotion.ends_at, format: :short) %> ·
              <%= promotion.variants.map(&:product).uniq.map(&:title).to_sentence %>
            </span>
          </span>
          <%= badge t(".statuses.#{promotion.status}"), tone: { "active" => :green, "scheduled" => :brand }.fetch(promotion.status, :gray) %>
          <% if promotion.scheduled? || promotion.active? %>
            <%= button_to t(promotion.active? ? ".end_now" : ".call_off"), admin_promotion_cancellation_path(promotion), class: button_classes(:ghost, size: :sm),
                  form: { data: { turbo_confirm: t(".confirm_end", name: promotion.name) } } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% else %>
  <%= empty_state t(".empty_title"), t(".empty_description") do %>
    <%= link_to t(".new"), new_admin_promotion_path, class: button_classes %>
  <% end %>
<% end %>
