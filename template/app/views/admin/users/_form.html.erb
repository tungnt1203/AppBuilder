<%= form_with model: [ :admin, user ], class: "space-y-4" do |form| %>
  <%= form.errors %>
  <%= form.field :name, required: true, autofocus: true %>
  <%= form.field :email_address, :email_field, required: true %>
  <div class="space-y-1.5">
    <%= form.label :role %>
    <%= form.select :role, [ [ "Member", "member" ], [ "Admin — can manage people", "admin" ] ] %>
  </div>
  <div class="flex items-center gap-2 pt-2">
    <%= form.submit user.new_record? ? "Send invitation" : "Save changes" %>
    <%= link_to "Cancel", admin_users_path, class: button_classes(:ghost) %>
  </div>
<% end %>
