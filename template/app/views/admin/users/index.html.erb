<%= page_header t(".title"), t(".description", app: Rails.configuration.x.app_name) do %>
  <%= link_to t(".invite"), new_admin_user_path, class: button_classes %>
<% end %>

<%= card padded: false do %>
  <ul class="divide-y divide-line">
    <% @users.each do |user| %>
      <li class="flex items-center justify-between gap-4 px-6 py-4">
        <div class="flex min-w-0 items-center gap-3">
          <%= avatar user.name %>
          <div class="min-w-0">
            <p class="truncate text-sm font-medium text-ink"><%= user.name %></p>
            <p class="truncate text-sm text-muted"><%= user.email_address %></p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <%= badge user.role_name, tone: user.member? ? :gray : :brand %>
          <%= link_to t(".edit"), edit_admin_user_path(user), class: "text-sm #{link_classes}" unless user.owner? %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
