<%# Price list or menu: groups of services or dishes, each with a dotted line to its price, like
    a printed menu. Fits salons, spas, cafés, restaurants, repair shops. In a real page loop over
    the owner's records and format with money(cents). Two
    columns on wide screens, one on phones. %>
<section id="prices" class="bg-surface py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold text-ink md:text-4xl">Prices</h2>
      <p class="mt-3 text-lg leading-relaxed text-muted">Every service includes cuticle care. Nail art is priced by design.</p>
    </div>

    <div class="mt-10 grid gap-x-16 gap-y-12 md:grid-cols-2">
      <% { "Hands" => [ [ "Gel manicure", "45 min", 3500 ], [ "Gel + simple art", "60 min", 5000 ], [ "Acrylic full set", "90 min", 7000 ] ],
           "Feet" => [ [ "Gel pedicure", "45 min", 4500 ], [ "Spa pedicure", "60 min", 6000 ] ] }.each do |group, items| %>
        <div>
          <h3 class="border-b border-line pb-3 text-sm font-semibold tracking-wide text-brand-700 uppercase"><%= group %></h3>
          <ul class="mt-2">
            <% items.each do |name, duration, price| %>
              <li class="py-3">
                <div class="flex items-baseline gap-3">
                  <p class="font-medium text-ink"><%= name %></p>
                  <span class="flex-1 translate-y-[-0.3em] border-b-2 border-dotted border-muted/40" aria-hidden="true"></span>
                  <span class="font-display text-lg font-semibold whitespace-nowrap text-ink"><%= money(price) %></span>
                </div>
                <p class="text-sm text-muted"><%= duration %></p>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
</section>
