<%# Find us: address with a Google Maps link, opening hours with today marked, phone that dials,
    a text link that opens a message. What visitors of a local business look for most; it can also live in
    the footer. Keep the hours in one place
    (a constant or the owner's settings) and reuse them. %>
<% address = "123 Bedford Ave, Brooklyn, NY 11211"
   phone = "+12125550142"
   hours = [ [ "Sunday", "9 am – 8 pm" ], [ "Monday", "9 am – 9 pm" ], [ "Tuesday", "9 am – 9 pm" ], [ "Wednesday", "9 am – 9 pm" ],
             [ "Thursday", "9 am – 9 pm" ], [ "Friday", "9 am – 10 pm" ], [ "Saturday", "9 am – 10 pm" ] ] # by Date#wday %>
<section id="visit" class="bg-canvas py-16 md:py-24">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 md:grid-cols-2">
    <div>
      <h2 class="text-3xl font-bold text-ink md:text-4xl">Visit us</h2>
      <p class="mt-4 flex items-start gap-3 text-lg text-ink"><%= icon "map-pin", size: 22, class: "mt-1 text-brand-600" %> <%= address %></p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="https://www.google.com/maps/search/?api=1&query=<%= ERB::Util.url_encode(address) %>" target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 font-semibold text-white transition hover:bg-brand-500"><%= icon "navigation", size: 18 %> Directions</a>
        <a href="tel:<%= phone %>" class="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 font-semibold text-ink ring-1 ring-line transition ring-inset hover:bg-surface-muted"><%= icon "phone", size: 18 %> Call</a>
        <a href="sms:<%= phone %>" class="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 font-semibold text-ink ring-1 ring-line transition ring-inset hover:bg-surface-muted"><%= icon "message-circle", size: 18 %> Text us</a>
      </div>
    </div>

    <div class="rounded-xl bg-surface p-6 ring-1 ring-line">
      <h3 class="flex items-center gap-2 font-semibold text-ink"><%= icon "clock", size: 18, class: "text-muted" %> Opening hours</h3>
      <ul class="mt-4 space-y-2">
        <% today = Time.zone.today.wday %>
        <% (1..7).map { |n| n % 7 }.each do |wday| %>
          <% day, time = hours[wday] %>
          <li class="flex justify-between gap-4 rounded-md px-3 py-1.5 whitespace-nowrap <%= "bg-brand-50 font-semibold text-brand-800" if wday == today %>">
            <span><%= day %><%= tag.span(" (today)", class: "sr-only") if wday == today %></span><span class="tabular-nums"><%= time %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</section>
