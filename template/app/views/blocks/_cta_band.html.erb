<%# The closing nudge before the footer: one sentence and the main action again, on a block of
    brand color. Make the button say exactly what happens. Structure after HyperUI CTAs (MIT). %>
<section class="px-4 py-12 md:py-16">
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 rounded-xl bg-brand-600 p-8 text-white md:flex-row md:items-center md:justify-between md:p-12">
    <div>
      <h2 class="text-2xl font-bold text-balance md:text-3xl">Còn chỗ tối nay lúc 19:00 và 20:00</h2>
      <p class="mt-2 text-white/80">Đặt trong 30 giây, không cần tài khoản.</p>
    </div>
    <a href="#dat-lich" class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-white px-5 py-3 font-semibold text-brand-700 transition hover:bg-white/90">
