<%# Questions people ask before coming: parking, payment, cancelling, kids, how long it takes.
    details/summary opens without JavaScript. Write answers in the owner's voice. Structure after
    HyperUI FAQs (MIT). %>
<section class="bg-surface py-16 md:py-24">
  <div class="mx-auto max-w-3xl px-4">
    <h2 class="text-3xl font-bold text-ink md:text-4xl">Questions, answered</h2>

    <div class="mt-8 divide-y divide-line border-y border-line">
      <% [ [ "Do I need to book ahead?", "Booking means no wait, especially Friday to Sunday evenings. Walk-ins are welcome whenever a chair is free." ],
           [ "How can I pay?", "Cards, Apple Pay, Google Pay or cash at the desk." ],
           [ "Can I move my appointment?", "Text us at least 2 hours before and we'll move it, free of charge." ] ].each do |question, answer| %>
        <details class="group py-5 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-lg font-semibold text-ink">
            <%= question %>
            <span class="shrink-0 text-muted transition group-open:rotate-45"><%= icon "plus", size: 20 %></span>
          </summary>
          <p class="mt-3 leading-relaxed text-muted"><%= answer %></p>
        </details>
      <% end %>
    </div>
  </div>
</section>
