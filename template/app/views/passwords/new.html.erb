<% content_for :title, "Forgot password" %>

<h1 class="text-lg font-semibold">Forgot your password?</h1>
<p class="mt-1 mb-6 text-sm text-gray-500">We'll email you a link to reset it.</p>

<%= form_with url: passwords_path, class: "space-y-4" do |form| %>
  <div class="space-y-1.5">
    <%= form.label :email_address %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
  </div>

  <%= form.submit "Email reset link", class: "w-full" %>
<% end %>

<p class="mt-6 text-center text-sm">
  <%= link_to "Back to sign in", new_session_path, class: "text-brand-600 hover:text-brand-500" %>
</p>
