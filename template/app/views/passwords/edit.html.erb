<% content_for :title, t(".title") %>

<div class="mx-auto max-w-sm px-4 py-12 sm:py-20">
  <h1 class="mb-8 font-display text-3xl font-semibold tracking-tight"><%= t(".heading") %></h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
    <div class="space-y-1.5">
      <%= form.label :password, t(".password") %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", minlength: 8, maxlength: 72 %>
    </div>

    <div class="space-y-1.5">
      <%= form.label :password_confirmation, t(".password_confirmation") %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>

    <%= form.submit t(".submit"), class: "w-full" %>
  <% end %>
</div>
