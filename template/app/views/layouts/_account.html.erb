<%# Account cluster shared by the app shell and the public layout. %>
<div class="flex items-center gap-1">
  <% if authenticated? %>
    <span class="inline-flex items-center gap-2 px-2 text-sm text-muted">
      <%= avatar Current.user.name, size: :sm %>
      <span class="hidden max-w-40 truncate sm:inline"><%= Current.user.name %></span>
    </span>
    <%= button_to t("layouts.application.sign_out"), session_path, method: :delete, class: button_classes(:ghost) %>
  <% else %>
    <%= link_to t("layouts.application.sign_in"), new_session_path, class: button_classes(:ghost) %>
  <% end %>
</div>
