<%# The sidebar of /admin. Add one nav_link_to per screen the owner and staff use.
    Group them with nav_section once there are more than a handful. %>
<%= nav_link_to t("layouts.admin.dashboard"), admin_root_path %>
<% if shop? %>
  <%= nav_section t("layouts.admin.shop") do %>
    <%= nav_link_to t("layouts.admin.orders"), admin_orders_path, match: "/admin/orders" %>
    <%= nav_link_to t("layouts.admin.products"), admin_products_path, match: "/admin/products" %>
    <%= nav_link_to t("layouts.admin.collections"), admin_collections_path, match: "/admin/collections" %>
    <%= nav_link_to t("layouts.admin.discounts"), admin_discounts_path, match: "/admin/discounts" %>
    <%= nav_link_to t("layouts.admin.promotions"), admin_promotions_path, match: "/admin/promotions" %>
    <%= nav_link_to t("layouts.admin.reviews"), admin_product_reviews_path, match: "/admin/reviews" %>
    <% if Store.current.agent_key?("merchant") || AgentChange.staged.exists? %>
      <%= nav_link_to t("layouts.admin.agent_changes"), admin_agent_changes_path, match: "/admin/agent_changes" %>
    <% end %>
  <% end %>
<% end %>
<% if Current.user.administrator? %>
  <div class="pt-5"><%= nav_link_to t("layouts.admin.settings"), edit_admin_settings_path, match: "/admin/settings" %></div>
<% end %>
