<%# The site's header. Redesign it for the app: logo or wordmark, the few links visitors need,
    the main call to action. Keep a way for staff to sign in (here or in the footer).
    Pages can add links with content_for :public_nav. %>
<header class="sticky top-0 z-20 border-b border-line bg-surface/90 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-4 px-4">
    <%= link_to Rails.configuration.x.app_name, root_path, class: "font-display font-semibold text-ink" %>
    <% if content_for?(:public_nav) %>
      <nav class="flex flex-1 items-center gap-1 overflow-x-auto" aria-label="<%= t("ui.navigation") %>">
        <%= yield :public_nav %>
      </nav>
    <% else %>
      <div class="flex-1"></div>
    <% end %>
    <%= render "layouts/account" %>
  </div>
</header>
