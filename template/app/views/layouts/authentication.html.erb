<!DOCTYPE html>
<html class="h-full">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="flex min-h-full items-center justify-center bg-canvas px-4 py-12 font-sans text-ink antialiased">
    <div class="w-full max-w-sm">
      <p class="mb-6 text-center text-lg font-semibold"><%= link_to Rails.configuration.x.app_name, root_path, class: "text-ink" %></p>
