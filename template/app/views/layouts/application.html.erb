<!DOCTYPE html>
<html class="h-full">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="min-h-full bg-gray-50 text-gray-900 antialiased">
    <header class="border-b border-gray-200 bg-white">
      <div class="mx-auto flex h-14 max-w-6xl items-center gap-4 px-4">
        <%= link_to Rails.configuration.x.app_name, root_path, class: "font-semibold text-gray-900" %>

        <nav class="flex flex-1 items-center gap-1 overflow-x-auto text-sm">
          <%= render "layouts/navigation" %>
        </nav>

        <div class="flex items-center gap-1 text-sm">
          <%# Public pages render this layout for visitors too, so check before using Current.user. %>
          <% if authenticated? %>
            <% if Current.user.administrator? %>
              <%= nav_link_to t(".admin"), admin_users_path %>
            <% end %>
            <span class="hidden px-2 text-gray-500 sm:inline"><%= Current.user.name %></span>
            <%= button_to t(".sign_out"), session_path, method: :delete, class: button_classes(:ghost) %>
          <% else %>
            <%= link_to t(".sign_in"), new_session_path, class: button_classes(:ghost) %>
          <% end %>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8">
      <%= render "ui/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
