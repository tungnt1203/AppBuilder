<!DOCTYPE html>
<html class="h-full">
  <head>
    <%= render "layouts/head" %>
  </head>

  <%# The customers' site: home, catalog, product pages, cart, customers' sign in and account,
      everything outside /admin. It's an open canvas. Design the header, the footer and every
      section for this app (see DESIGN.md and the design skill); none of it has to look like /admin. %>
  <body class="min-h-full bg-canvas font-sans text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded-lg focus:bg-surface focus:px-3 focus:py-2"><%= t("ui.skip") %></a>

    <%= render "layouts/site/header" %>

    <main id="main">
      <% if flash[:notice] || flash[:alert] %>
        <div class="mx-auto max-w-6xl px-4 pt-8">
          <%= render "ui/flash" %>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <%= render "layouts/site/footer" %>
  </body>
</html>
