<% content_for :title, t(".title") %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>

<%# Buyers review each product of their order: stars, a few words, the name shown. %>
<div class="mx-auto max-w-2xl px-4 py-12">
  <h1 class="font-display text-3xl font-semibold tracking-tight"><%= t(".title") %></h1>
  <p class="mt-2 text-muted"><%= t(".intro", number: @order.name) %></p>

  <%= form_with url: order_review_path(@order), class: "mt-8 space-y-6" do |form| %>
    <% @products.each do |product| %>
      <% review = @reviews&.find { |candidate| candidate.product_id == product.id } %>
      <% fields = params.dig(:reviews, product.id.to_s) || {} %>
      <fieldset class="rounded-xl border border-line bg-surface p-5">
        <legend class="sr-only"><%= product.title %></legend>
        <div class="flex items-center gap-4">
          <div class="size-16 shrink-0 overflow-hidden rounded-lg"><%= product_image product, size: :thumb, class: "size-full" %></div>
          <p class="font-medium text-ink"><%= product.title %></p>
        </div>

        <div class="mt-4 flex flex-row-reverse justify-end gap-1" role="radiogroup" aria-label="<%= t(".rating_for", product: product.title) %>">
          <% 5.downto(1) do |stars| %>
            <input type="radio" id="rating_<%= product.id %>_<%= stars %>" name="reviews[<%= product.id %>][rating]" value="<%= stars %>"
                   class="peer sr-only" <%= "checked" if fields[:rating].to_s == stars.to_s %>>
            <label for="rating_<%= product.id %>_<%= stars %>" class="cursor-pointer text-line peer-checked:text-amber-500 peer-focus-visible:outline-2 peer-focus-visible:outline-brand-500" title="<%= t(".stars", count: stars) %>">
              <%= icon "star", size: 32, class: "fill-current" %><span class="sr-only"><%= t(".stars", count: stars) %></span>
            </label>
          <% end %>
        </div>
        <% if review&.errors&.include?(:rating) %>
          <p class="mt-1 text-xs text-red-600"><%= review.errors.full_messages_for(:rating).first %></p>
        <% end %>

        <div class="mt-4 space-y-1.5">
          <label for="review_body_<%= product.id %>" class="block text-sm font-medium text-ink"><%= t(".body") %></label>
          <textarea id="review_body_<%= product.id %>" name="reviews[<%= product.id %>][body]" rows="3" maxlength="2000"
                    placeholder="<%= t(".body_placeholder") %>" class="<%= field_classes %>"><%= fields[:body] %></textarea>
        </div>
      </fieldset>
    <% end %>

    <div class="space-y-1.5">
      <label for="author_name" class="block text-sm font-medium text-ink"><%= t(".author_name") %></label>
      <input id="author_name" type="text" name="author_name" value="<%= @author_name %>" maxlength="60" required class="<%= field_classes %>">
      <% if @reviews&.any? { |review| review.errors.include?(:author_name) } %>
        <p class="text-xs text-red-600"><%= @reviews.first.errors.full_messages_for(:author_name).first %></p>
      <% end %>
      <p class="text-xs text-muted"><%= t(".author_name_hint") %></p>
    </div>

    <button type="submit" class="<%= button_classes %> w-full py-3 text-base"><%= t(".submit") %></button>
  <% end %>
</div>
