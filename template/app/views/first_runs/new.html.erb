<% content_for :title, t(".title") %>

<h1 class="text-lg font-semibold"><%= t(".heading") %></h1>
<p class="mt-1 mb-6 text-sm text-gray-500"><%= t(".description") %></p>

<%= form_with model: @user, url: first_run_path, class: "space-y-4" do |form| %>
  <%= form.errors %>
  <%= form.field :name, required: true, autofocus: true, autocomplete: "name" %>
  <%= form.field :email_address, :email_field, required: true, autocomplete: "username" %>
  <%= form.field :password, :password_field, required: true, autocomplete: "new-password", maxlength: 72 %>
  <%= form.submit t(".submit"), class: "w-full" %>
<% end %>
