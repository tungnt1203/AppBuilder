<% content_for :title, t(".title") %>

<h1 class="text-lg font-semibold"><%= t(".heading", name: @user.name) %></h1>
<p class="mt-1 mb-6 text-sm text-muted"><%= t(".description", email: @user.email_address) %></p>

<%= form_with model: @user, url: invitation_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
  <%= form.errors %>
  <%= form.field :password, :password_field, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72 %>
  <%= form.submit t(".submit"), class: "w-full" %>
<% end %>
