<% content_for :title, t("policies.titles.#{@id}") %>

<article class="mx-auto max-w-3xl px-4 py-12 leading-relaxed text-ink">
  <h1 class="font-display text-3xl font-semibold tracking-tight md:text-4xl"><%= t("policies.titles.#{@id}") %></h1>
  <p class="mt-2 text-sm text-muted"><%= t("policies.updated", date: l(@store.updated_at.to_date, format: "%B %-d, %Y")) %></p>
  <div class="mt-4"><%= policy_text @store.policy(@id) %></div>
</article>
