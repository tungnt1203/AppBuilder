<h1><%= t(".heading", number: @order.name) %></h1>
<p><%= t(@order.refunded_cents.positive? ? ".intro_refunded" : ".intro", total: money(@order.refunded_cents.positive? ? @order.refunded_cents : @order.total_cents, @order.currency)) %></p>

<%= render "order_mailer/summary", order: @order %>

<% if @store.contact_email.present? %>
  <p><%= t(".questions", email: @store.contact_email) %></p>
<% end %>
<p><%= link_to t(".view"), order_url(@order) %></p>
