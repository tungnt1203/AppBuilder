<table role="presentation" cellpadding="0" cellspacing="0">
  <tr><td><strong><%= t("appointment_mailer.details.what") %></strong></td><td><%= appointment.service_name %> (<%= t("appointment_mailer.details.minutes", count: appointment.duration_minutes) %>)</td></tr>
  <tr><td><strong><%= t("appointment_mailer.details.when") %></strong></td><td><%= l(appointment.starts_at, format: :appointment) %></td></tr>
  <% if appointment.staff_member %>
    <tr><td><strong><%= t("appointment_mailer.details.with") %></strong></td><td><%= appointment.staff_member.name %></td></tr>
  <% end %>
  <% if appointment.price_cents.positive? %>
    <tr><td><strong><%= t("appointment_mailer.details.price") %></strong></td><td><%= money(appointment.price_cents, appointment.currency) %></td></tr>
  <% end %>
</table>
