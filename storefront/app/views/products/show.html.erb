<% content_for :title, @product.title %>
<% content_for :head do %>
  <meta name="description" content="<%= truncate(strip_tags(@product.description.to_s).squish, length: 160) %>">
  <meta property="og:type" content="product">
  <%= product_structured_data @product, @reviews %>
  <meta property="og:title" content="<%= @product.title %>">
  <% if @product.cover_image %>
    <meta property="og:image" content="<%= @product.cover_image.url(:large) %>">
  <% end %>
<% end %>

<%# A product page made to sell from an ad: photos, price, options, the button, and right under it
    what buyers want to know before they pay (when it arrives, shipping, returns). On a phone the
    button follows the buyer once the main one scrolls away. Restyle it; keep those parts. %>
<% images = @product.images %>
<%# Text the buyer types shows on the photos where the shop placed it (personalization/_layer). %>
<% placed = images.any? ? @product.buyer_inputs.select { |input| input["preview"] } : [] %>
<% personalized = placed.any? || @product.buyer_inputs.any? { |input| %w[ photo starmap ].include?(input["kind"]) } %>
<%# The photos take the wider side, as on Shopify's themes, and stay in view on wide screens while
    the buyer goes down the options and types what they add. %>
<%# Where the buyer is: the shop, the product's first collection, the product (one line, clipped on phones). %>
<% collection = @product.collections.first %>
<%# How the page is laid out on wide screens (theme setting product_layout): split, the photos on
    the left as Shopify's themes have them; flip, the words first and the photos on the right;
    thumbs, the thumbnails in a column beside the photo. Phones stack them all the same. %>
<% layout = theme_setting(:product_layout).presence_in(%w[ split flip thumbs ]) || "split" %>
<nav class="page-width pt-4 md:pt-6" aria-label="<%= t("ui.breadcrumbs") %>">
  <ol class="flex min-w-0 items-center gap-1.5 text-xs text-muted">
    <li class="shrink-0"><%= link_to t(".home"), root_path, class: "hover:text-ink hover:underline" %></li>
    <li class="shrink-0" aria-hidden="true"><%= icon "chevron-right", size: 12, stroke: 1.5 %></li>
    <li class="shrink-0"><%= collection ? link_to(collection.title, collection_path(collection), class: "hover:text-ink hover:underline") : link_to(t(".shop"), products_path, class: "hover:text-ink hover:underline") %></li>
    <li class="shrink-0" aria-hidden="true"><%= icon "chevron-right", size: 12, stroke: 1.5 %></li>
    <li class="truncate text-ink" aria-current="page"><%= @product.title %></li>
  </ol>
</nav>
<div class="page-width grid gap-6 pt-4 pb-6 <%= layout == "flip" ? "md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]" : "md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]" %> md:gap-14 md:pt-6 md:pb-10" data-layout="<%= layout %>" data-controller="sticky-buy<%= " personalize" if personalized %>" <%= tag.attributes(data: { personalize_upload_url: (uploads_path if personalized) }) %> data-action="variant-picker:change->sticky-buy#select">
  <div class="min-w-0 md:sticky md:top-28 md:self-start <%= "md:order-2" if layout == "flip" %> <%= "md:flex md:flex-row-reverse md:items-start md:gap-3" if layout == "thumbs" && images.many? %>" data-controller="gallery" data-action="variant-picker:image@window->gallery#showImage">
    <div class="relative aspect-4/5 overflow-hidden rounded-xl md:min-w-0 md:flex-1" data-personalize-frame>
      <% if images.any? %>
        <button type="button" class="block size-full cursor-zoom-in" data-action="gallery#zoom" aria-label="<%= t(".zoom") %>">
          <%= image_tag @product.image_for(@variant).url(:large), alt: @product.title, class: "size-full bg-surface-muted object-cover", data: { gallery_target: "main", personalize_target: ("photo" if placed.any?) } %>
        </button>
        <% placed.each do |input| %>
          <% photos = images.select { |image| input["preview"]["images"].to_a.include?(image.id) }.map { |image| image.url(:large) } %>
          <%= render "personalization/layer", layer: input["preview"].merge("key" => input["key"], "kind" => input["kind"], "options" => input["options"]), sample: t(".your_text"), photos: %>
        <% end %>
        <% if images.many? %>
          <%# Buyers on a phone page through the photos without hunting for the thumbnails. %>
          <div class="pointer-events-none absolute inset-x-3 top-1/2 flex -translate-y-1/2 justify-between">
            <% { "previous" => "chevron-left", "next" => "chevron-right" }.each do |direction, glyph| %>
              <button type="button" class="pointer-events-auto grid size-10 place-items-center rounded-full bg-canvas/90 text-ink shadow-sm ring-1 ring-line backdrop-blur transition hover:bg-canvas" data-action="gallery#<%= direction %>" aria-label="<%= t(".#{direction}_photo") %>"><%= icon glyph, size: 18, stroke: 1.5 %></button>
            <% end %>
          </div>
          <p class="pointer-events-none absolute right-3 bottom-3 rounded-full bg-canvas/90 px-2.5 py-1 text-xs text-ink tabular-nums ring-1 ring-line" data-gallery-target="counter" aria-hidden="true">1 / <%= images.size %></p>
        <% end %>
        <dialog class="m-auto max-h-[92vh] max-w-[92vw] overflow-hidden rounded-xl bg-canvas p-0 backdrop:bg-black/70" data-gallery-target="zoom" data-action="click->gallery#closeZoom">
          <%= image_tag @product.image_for(@variant).url(:large), alt: @product.title, loading: "lazy", class: "max-h-[92vh] w-auto object-contain", data: { gallery_target: "zoomImage" } %>
          <button type="button" class="absolute top-3 right-3 grid size-9 place-items-center rounded-full bg-surface/90 text-ink" aria-label="<%= t(".close") %>"><%= icon "x", size: 18 %></button>
        </dialog>
      <% else %>
        <%= product_image @product, class: "size-full" %>
      <% end %>
    </div>
    <% if images.many? %>
      <div class="relative mt-3 flex gap-2 overflow-x-auto p-1 [scrollbar-width:none] <%= "md:mt-0 md:max-h-[min(70vh,44rem)] md:shrink-0 md:flex-col md:overflow-x-visible md:overflow-y-auto" if layout == "thumbs" %>">
        <% images.each_with_index do |image, index| %>
          <button type="button" class="size-16 shrink-0 overflow-hidden rounded-lg bg-surface-muted opacity-70 ring-ink ring-offset-2 ring-offset-canvas transition hover:opacity-100 aria-[current=true]:opacity-100 aria-[current=true]:ring-1 md:size-20"
                  aria-current="<%= index.zero? %>" aria-label="<%= t(".photo", number: index + 1) %>"
                  data-gallery-target="thumb" data-large="<%= image.url(:large) %>" data-action="gallery#show">
            <%= image_tag image.url(:thumb), alt: "", class: "size-full object-cover" %>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>

  <div data-controller="variant-picker" data-variant-picker-variants-value="<%= variants_json(@product) %>">
    <h1 class="text-[1.75rem] leading-tight text-balance md:text-4xl"><%= @product.title %></h1>
    <% if (rating = @product.rating) %>
      <a href="#reviews" class="mt-2 inline-flex items-center gap-2 text-sm text-muted hover:text-ink">
        <%= rating_stars rating.average %> <span><%= rating.average %> · <%= t(".reviews", count: rating.count) %></span>
      </a>
    <% end %>
    <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-2xl text-ink">
      <span data-variant-picker-target="price"><%= money(@variant&.price_cents) %></span>
      <s class="text-base text-muted" data-variant-picker-target="compareAtPrice" <%= "hidden" unless @variant&.on_sale? %>><%= money(@variant.compare_at_price_cents) if @variant&.on_sale? %></s>
      <span class="rounded-full bg-accent px-2.5 py-1 text-xs font-medium text-on-accent" data-variant-picker-target="saving" <%= "hidden" unless @variant&.on_sale? %>><%= t(".save", percent: @variant.sale_percent) if @variant&.on_sale? %></span>
    </p>

    <%= form_with url: cart_items_path, id: "buy", class: "mt-8 space-y-6 border-t border-line pt-6" do |form| %>
      <% @product.options.each_with_index do |option, position| %>
        <% name, values = option.name, option.values %>
        <% swatches = option.color? && values.all? { |value| swatch_color(option, value) } %>
        <fieldset>
          <div class="flex items-baseline justify-between gap-4">
            <legend class="text-sm font-medium text-ink">
              <%= name %><span class="font-normal text-muted" data-variant-picker-target="choice" data-position="<%= position %>"><%= ": #{@variant.options[position]}" if @variant %></span>
            </legend>
            <% if name == @product.size_option && @product.size_guide.present? %>
              <button type="button" class="text-sm <%= link_classes %>" data-controller="dialog-trigger" data-dialog-trigger-id-value="size-guide" data-action="dialog-trigger#open"><%= t(".size_guide") %></button>
            <% end %>
          </div>
          <% if values.size > 12 %>
            <input type="search" placeholder="<%= t(".find_option", option: name.downcase) %>" aria-label="<%= t(".find_option", option: name.downcase) %>"
                   class="<%= field_classes %> mt-2 h-9 text-sm" data-position="<%= position %>" data-action="variant-picker#filter">
          <% end %>
          <div class="mt-2 flex flex-wrap gap-2">
            <% values.each do |value| %>
              <label class="cursor-pointer" title="<%= value %>">
                <input type="radio" name="options[<%= position %>]" value="<%= value %>" class="peer sr-only"
                       <%= "checked" if @variant&.options&.dig(position) == value %>
                       data-position="<%= position %>" data-variant-picker-target="option" data-action="variant-picker#update">
                <% if swatches %>
                  <span class="block size-9 rounded-full border border-line ring-offset-2 ring-offset-canvas peer-checked:ring-2 peer-checked:ring-ink peer-focus-visible:outline-2 peer-focus-visible:outline-brand-500" style="background-color: <%= swatch_color(option, value) %>"></span>
                  <span class="sr-only"><%= value %></span>
                <% else %>
                  <span class="inline-flex min-w-12 items-center justify-center rounded-lg border border-line bg-surface px-3 py-2 text-sm peer-checked:border-ink peer-checked:ring-1 peer-checked:ring-ink peer-focus-visible:outline-2 peer-focus-visible:outline-brand-500"><%= value %></span>
                <% end %>
              </label>
            <% end %>
          </div>
          <% if name == @product.size_option && @product.made_to_order? %>
            <p class="mt-2 text-xs text-muted"><%= t(".made_to_order_sizes") %></p>
          <% end %>
        </fieldset>
      <% end %>

      <%= hidden_field_tag :variant_id, @variant&.id, data: { variant_picker_target: "variantId" } %>

      <%# What the buyer types to have printed (a name on the shirt), when the product asks for it. %>
      <%# On phones, once the photo has scrolled away, a small copy of it shows beside the fields and
          stays in view as the buyer goes down them (personalize-beside: while the photo is still in
          view, the fields keep the whole width). %>
      <div class="<%= "personalize-beside md:block" if placed.any? %>" <%= tag.attributes(data: { personalize_target: ("beside" if placed.any?) }) %>>
        <div class="min-w-0 space-y-4">
          <% @product.buyer_inputs.each do |input| %>
            <%= render "buyer_input", input: %>
          <% end %>
        </div>
        <% if placed.any? %>
          <span class="sticky top-20 aspect-4/5 overflow-hidden rounded-lg shadow-sm ring-1 ring-line md:hidden" data-personalize-frame aria-hidden="true">
            <%= image_tag @product.image_for(@variant).url(:large), alt: "", class: "size-full bg-surface-muted object-cover", data: { personalize_target: "mirror" } %>
            <% placed.each do |input| %>
              <% photos = images.select { |image| input["preview"]["images"].to_a.include?(image.id) }.map { |image| image.url(:large) } %>
              <%= render "personalization/layer", layer: input["preview"].merge("key" => input["key"], "kind" => input["kind"], "options" => input["options"]), sample: t(".your_text"), photos: %>
            <% end %>
          </span>
        <% end %>
      </div>

      <div class="flex items-stretch gap-3">
        <%= render "ui/quantity", name: :quantity, value: 1, id: "quantity" %>
        <%= form.submit t(".add_to_cart"), class: "#{button_classes} min-h-12 flex-1 text-base", disabled: !@variant&.available?, data: { variant_picker_target: "submit", sticky_buy_target: "button" } %>
      </div>
      <p class="text-sm text-muted" data-variant-picker-target="unavailable" data-sold-out="<%= t(".sold_out") %>" data-not-made="<%= t(".unavailable") %>"
         <%= "hidden" if @variant&.available? %>><%= @variant&.stock == 0 ? t(".sold_out") : t(".unavailable") %></p>
    <% end %>

    <% shipping = current_shop.shipping %>
    <ul class="mt-6 divide-y divide-line rounded-xl border border-line text-sm text-ink [&>li]:px-4 [&>li]:py-3">
      <% made_to_order = @product.made_to_order? %>
      <% if made_to_order || delivery_estimate.nil? %>
        <li class="flex items-center gap-2.5">
          <%= icon "shirt", size: 18, class: "shrink-0 text-muted" %>
          <span><%= t(".made_to_order") %></span>
        </li>
      <% end %>
      <% if (estimate = delivery_estimate) %>
        <li class="flex items-center gap-2.5">
          <%= icon "truck", size: 18, class: "shrink-0 text-muted" %>
          <span><%= estimate %></span>
        </li>
      <% end %>
      <li class="flex items-center gap-2.5">
        <%= icon "package", size: 18, class: "shrink-0 text-muted" %>
        <span>
          <%# Made to order ships at what Printify charges for the address, known at checkout: never
              "Free shipping" because the shop's own rate is nothing. %>
          <% if shipping.free_over_cents %>
            <%= t(".free_shipping_over", amount: money(shipping.free_over_cents)) %>
          <% elsif @product.made_to_order? %>
            <%= t(".shipping_at_checkout") %>
          <% elsif shipping.first_item_cents.zero? %>
            <%= t(".free_shipping") %>
          <% else %>
            <%= t(".shipping_from", amount: money(shipping.first_item_cents)) %>
          <% end %>
        </span>
      </li>
      <% if current_shop.policy?("refund") %>
        <li class="flex items-center gap-2.5">
          <%= icon "rotate-ccw", size: 18, class: "shrink-0 text-muted" %>
          <%= link_to t(made_to_order ? ".returns_made_to_order" : ".returns"), policy_path("refund"), class: "underline decoration-muted/40 underline-offset-4 hover:decoration-ink" %>
        </li>
      <% end %>
      <li class="flex items-center gap-2.5">
        <%= icon "lock", size: 18, class: "shrink-0 text-muted" %>
        <span><%= t(".secure_checkout") %></span>
      </li>
    </ul>

    <div class="mt-10 divide-y divide-line border-y border-line">
      <% if @product.custom_fields.any? %>
        <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 py-4 text-sm">
          <% @product.custom_fields.each do |field| %>
            <dt class="text-muted"><%= field["label"] %></dt>
            <dd class="text-ink"><%= field["type"] == "boolean" ? t(field["value"] ? ".yes" : ".no") : field["value"] %></dd>
          <% end %>
        </dl>
      <% end %>
      <% if @product.description.present? %>
        <details class="group py-4" open>
          <summary class="flex cursor-pointer list-none items-center justify-between font-medium text-ink"><%= t(".details") %><%= icon "chevron-down", size: 18, class: "transition group-open:rotate-180" %></summary>
          <div class="mt-3 leading-relaxed text-ink/90"><%= simple_format @product.description %></div>
        </details>
      <% end %>
      <details class="group py-4">
        <summary class="flex cursor-pointer list-none items-center justify-between font-medium text-ink"><%= t(".shipping_and_returns") %><%= icon "chevron-down", size: 18, class: "transition group-open:rotate-180" %></summary>
        <div class="mt-3 space-y-2 text-sm leading-relaxed text-ink/90">
          <p><%= shipping_summary %></p>
          <% if (estimate = delivery_estimate) %>
            <p><%= estimate %>.</p>
          <% end %>
          <p class="flex gap-4">
            <%= link_to t(".shipping_policy"), policy_path("shipping"), class: link_classes if current_shop.policy?("shipping") %>
            <%= link_to t(".refund_policy"), policy_path("refund"), class: link_classes if current_shop.policy?("refund") %>
          </p>
        </div>
      </details>
    </div>
  </div>

  <%# On a phone, once the main button has scrolled away. %>
  <div class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-surface/95 px-4 py-3 backdrop-blur md:hidden" data-sticky-buy-target="bar" hidden>
    <div class="flex items-center gap-3">
      <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-medium text-ink"><%= @product.title %></p>
        <p class="truncate text-sm text-muted" data-sticky-buy-target="selection"><%= @variant ? [ @variant.title, money(@variant.price_cents) ].compact.join(" · ") : price_range(@product) %></p>
      </div>
      <button type="submit" form="buy" class="<%= button_classes %> px-6 py-3" data-sticky-buy-target="copy"><%= t(".add_to_cart") %></button>
    </div>
  </div>
</div>

<% if @product.size_guide.present? %>
  <%= dialog id: "size-guide", title: t(".size_guide") do %>
    <div class="text-sm leading-relaxed"><%= policy_text @product.size_guide %></div>
  <% end %>
<% end %>

<%# Reviews by people who bought it, newest first. Never make up reviews. %>
<% if (rating = @product.rating) %>
  <section id="reviews" class="page-width scroll-mt-24 border-t border-line pt-12 pb-12 md:pt-16">
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
      <h2 class="text-2xl"><%= t(".reviews_title") %></h2>
      <p class="flex items-center gap-2 text-sm text-muted"><%= rating_stars rating.average, size: 18 %> <%= t(".reviews_summary", average: rating.average, count: rating.count) %></p>
    </div>
    <ul class="mt-6 grid gap-4 md:grid-cols-2">
      <% @reviews.each do |review| %>
        <li class="rounded-xl border border-line bg-surface p-5">
          <div class="flex items-center justify-between gap-3">
            <%= rating_stars review.rating %>
            <time class="text-xs text-muted" datetime="<%= review.created_at.to_date.iso8601 %>"><%= l(review.created_at.to_date, format: :long) %></time>
          </div>
          <% if review.body %>
            <p class="mt-3 text-sm leading-relaxed text-ink/90"><%= review.body %></p>
          <% end %>
          <p class="mt-3 flex items-center gap-1.5 text-xs text-muted">
            <span class="font-medium text-ink"><%= review.author_name %></span> · <%= icon "badge-check", size: 14 %> <%= t(".verified_buyer") %>
          </p>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if @related.any? %>
  <section class="page-width border-t border-line pt-12 pb-8 md:pt-16">
    <h2 class="text-2xl md:text-[1.75rem]"><%= t(".related") %></h2>
    <div class="mt-6"><%= render "products/grid", products: @related %></div>
  </section>
<% end %>
