<%# A product in a grid: photo (its second photo on hover, when it has one), title, the lowest
    price ("From" when variants cost differently), the "was" price and how much a sale saves, and
    "Personalize" when the buyer adds their name or photo to it. %>
<% low, high, was = product.min_price_cents, product.max_price_cents, product.compare_at_cents %>
<% saves = ((was - low) * 100.0 / was).round if was && low && was > low %>
<%= link_to product_path(product), class: "group block" do %>
  <div class="relative aspect-4/5 overflow-hidden rounded-xl bg-surface-muted">
    <%= product_image product, size: :card, class: "size-full transition duration-500 group-hover:scale-[1.03]" %>
    <% if product.second_image %>
      <%= product_image product, size: :card, image: product.second_image, alt: "",
            class: "absolute inset-0 size-full opacity-0 transition duration-500 group-hover:opacity-100 max-md:hidden" %>
    <% end %>
    <% if !product.available? %>
      <span class="absolute top-3 left-3 rounded-full bg-ink/80 px-2.5 py-1 text-xs font-semibold text-canvas"><%= t("products.product.sold_out") %></span>
    <% elsif saves&.positive? %>
      <span class="absolute top-3 left-3 rounded-full bg-brand-600 px-2.5 py-1 text-xs font-semibold text-white"><%= t("products.product.saves", percent: saves) %></span>
    <% end %>
    <% if product.personalized? %>
      <span class="absolute bottom-3 left-3 inline-flex items-center gap-1 rounded-full bg-surface/90 px-2.5 py-1 text-xs font-semibold text-ink shadow-sm backdrop-blur">
        <%= icon "pencil-line", size: 12 %> <%= t("products.product.personalize") %>
      </span>
    <% end %>
  </div>
  <h3 class="mt-3 text-sm font-medium text-ink"><%= product.title %></h3>
  <p class="mt-1 flex flex-wrap items-baseline gap-x-2 text-sm">
    <span class="font-semibold <%= was ? "text-brand-700" : "text-ink" %>"><%= low == high ? money(low) : t("products.product.from", price: money(low)) %></span>
    <% if was %><s class="text-muted"><%= money(was) %></s><% end %>
  </p>
<% end %>
