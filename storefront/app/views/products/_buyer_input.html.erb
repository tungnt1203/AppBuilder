<%# What the buyer adds to have printed: a line of text (a name on the shirt) or a photo (kind
    "photo", sent to the Platform as they pick it: uploads#create). When the shop placed it on the
    photos, it shows there as they add it: text in the font and color they pick from the shop's,
    a photo they move (drag it on the photo) and zoom to frame it. %>
<% preview = input["preview"] %>
<% if input["kind"] == "photo" %>
<div class="space-y-2" data-personalize-photo-field="<%= input["key"] %>">
  <%= label_tag "photo_#{input["key"]}", input["label"] %>
  <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-dashed border-line px-4 py-3 text-sm hover:border-ink">
    <%= icon "image-plus", size: 20, class: "text-muted" %>
    <span data-personalize-status data-uploading="<%= t(".uploading") %>" data-small="<%= t(".small") %>" data-ready="<%= t(".ready") %>"><%= t(".pick") %></span>
    <%= file_field_tag "photo_#{input["key"]}", accept: "image/jpeg,image/png,image/webp", class: "sr-only", data: { personalize_pick: input["key"], action: "change->personalize#pick" } %>
  </label>
  <%= hidden_field_tag "properties[#{input["key"]}]", nil, id: nil, required: input["required"], data: { personalize_token: input["key"] } %>
  <%= hidden_field_tag "properties[#{input["key"]}_crop]", "1,0.5,0.5", id: nil, data: { personalize_crop: input["key"] } %>
  <% if preview %>
    <div class="flex items-center gap-3 text-sm text-muted" data-personalize-framing="<%= input["key"] %>" hidden>
      <%= icon "zoom-in", size: 16 %>
      <input type="range" min="1" max="4" step="0.05" value="1" class="flex-1 accent-ink" aria-label="<%= t(".zoom") %>" data-personalize-zoom="<%= input["key"] %>" data-action="input->personalize#zoom">
    </div>
    <p class="text-xs text-muted" data-personalize-framing="<%= input["key"] %>" hidden><%= t(".drag_hint") %></p>
    <% if preview["filters"].present? %>
      <fieldset data-personalize-framing="<%= input["key"] %>" hidden>
        <legend class="text-sm text-muted"><%= t(".look") %></legend>
        <div class="mt-1.5 flex flex-wrap gap-2">
          <% preview["filters"].each_with_index do |filter, index| %>
            <label class="cursor-pointer">
              <%= radio_button_tag "properties[#{input["key"]}_filter]", filter, index.zero?, class: "peer sr-only", data: { action: "personalize#update" } %>
              <span class="block rounded-lg border border-line px-3 py-1.5 text-sm peer-checked:border-ink peer-checked:ring-1 peer-checked:ring-ink peer-focus-visible:ring-2"><%= t(".looks.#{filter}") %></span>
            </label>
          <% end %>
        </div>
      </fieldset>
    <% end %>
  <% end %>
</div>
<% elsif input["kind"] == "choice" %>
<fieldset class="space-y-2">
  <legend class="font-medium"><%= input["label"] %></legend>
  <div class="grid grid-cols-4 gap-2 sm:grid-cols-5">
    <% input["options"].to_a.each_with_index do |option, index| %>
      <label class="cursor-pointer text-center" title="<%= option["label"] %>">
        <%= radio_button_tag "properties[#{input["key"]}]", option["id"], false, required: input["required"] && index.zero?, class: "peer sr-only", data: { action: "personalize#update" } %>
        <span class="block aspect-square rounded-lg border border-line bg-surface p-1.5 peer-checked:border-ink peer-checked:ring-1 peer-checked:ring-ink peer-focus-visible:ring-2">
          <%= image_tag option["thumb"], alt: "", class: "size-full object-contain", loading: "lazy" %>
        </span>
        <span class="mt-1 block truncate text-xs text-muted peer-checked:text-ink"><%= option["label"] %></span>
      </label>
    <% end %>
  </div>
</fieldset>
<% elsif input["kind"] == "color" %>
<fieldset class="space-y-2">
  <legend class="font-medium"><%= input["label"] %></legend>
  <div class="flex flex-wrap gap-2">
    <% preview.to_h["colors"].to_a.each_with_index do |color, index| %>
      <label class="cursor-pointer" title="<%= color %>">
        <%= radio_button_tag "properties[#{input["key"]}]", color, index.zero?, class: "peer sr-only", data: { action: "personalize#update" }, aria: { label: color } %>
        <span class="block size-9 rounded-full border border-line ring-offset-2 peer-checked:ring-2 peer-checked:ring-ink peer-focus-visible:ring-2" style="background: <%= color %>"></span>
      </label>
    <% end %>
  </div>
</fieldset>
<% else %>
<div class="space-y-2">
  <%= label_tag "properties_#{input["key"]}", input["label"] %>
  <% monogram = preview && preview["style"] == "monogram" %>
  <%= text_field_tag "properties[#{input["key"]}]", nil, id: "properties_#{input["key"]}", required: input["required"], maxlength: monogram ? 3 : input["max_length"], class: field_classes,
        autocomplete: "off", data: ({ personalize_input: input["key"], action: "input->personalize#update" } if preview) %>
  <% if monogram %>
    <p class="text-xs text-muted"><%= t(".monogram_hint") %></p>
  <% elsif input["max_length"] %>
    <p class="text-xs text-muted"><%= t(".max_length", count: input["max_length"]) %></p>
  <% end %>

  <% if preview && preview["fonts"].present? %>
    <fieldset>
      <legend class="text-sm text-muted"><%= t(".font") %></legend>
      <div class="mt-1.5 flex flex-wrap gap-2">
        <% preview["fonts"].each do |font| %>
          <label class="cursor-pointer">
            <%= radio_button_tag "properties[#{input["key"]}_font]", font, font == preview["font"], class: "peer sr-only", data: { action: "personalize#update" } %>
            <span class="block rounded-lg border border-line px-3 py-1.5 text-base peer-checked:border-ink peer-checked:ring-1 peer-checked:ring-ink peer-focus-visible:ring-2" style="font-family: '<%= font %>'"><%= font %></span>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  <% if preview && preview["colors"].present? %>
    <fieldset>
      <legend class="text-sm text-muted"><%= t(".text_color") %></legend>
      <div class="mt-1.5 flex flex-wrap gap-2">
        <% preview["colors"].each do |color| %>
          <label class="cursor-pointer" title="<%= color %>">
            <%= radio_button_tag "properties[#{input["key"]}_color]", color, color == preview["color"], class: "peer sr-only", data: { action: "personalize#update" }, aria: { label: color } %>
            <span class="block size-9 rounded-full border border-line ring-offset-2 peer-checked:ring-2 peer-checked:ring-ink peer-focus-visible:ring-2" style="background: <%= color %>"></span>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>
</div>
<% end %>
