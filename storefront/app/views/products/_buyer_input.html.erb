<%# A line of text the buyer types to have printed (a name on the shirt). When the shop placed it
    on the photos, it shows there as they type, and they pick its font and color from the shop's. %>
<% preview = input["preview"] %>
<div class="space-y-2">
  <%= label_tag "properties_#{input["key"]}", input["label"] %>
  <%= text_field_tag "properties[#{input["key"]}]", nil, id: "properties_#{input["key"]}", required: input["required"], maxlength: input["max_length"], class: field_classes,
        autocomplete: "off", data: ({ personalize_input: input["key"], action: "input->personalize#update" } if preview) %>
  <% if input["max_length"] %>
    <p class="text-xs text-muted"><%= t(".max_length", count: input["max_length"]) %></p>
  <% end %>

  <% if preview && preview["fonts"].present? %>
    <fieldset>
      <legend class="text-sm text-muted"><%= t(".font") %></legend>
      <div class="mt-1.5 flex flex-wrap gap-2">
        <% preview["fonts"].each do |font| %>
          <label class="cursor-pointer">
            <%= radio_button_tag "properties[#{input["key"]}_font]", font, font == preview["font"], class: "peer sr-only", data: { action: "personalize#update" } %>
            <span class="block rounded-lg border border-line px-3 py-1.5 text-base peer-checked:border-ink peer-checked:ring-1 peer-checked:ring-ink peer-focus-visible:ring-2" style="font-family: '<%= font %>'"><%= font %></span>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  <% if preview && preview["colors"].present? %>
    <fieldset>
      <legend class="text-sm text-muted"><%= t(".text_color") %></legend>
      <div class="mt-1.5 flex flex-wrap gap-2">
        <% preview["colors"].each do |color| %>
          <label class="cursor-pointer" title="<%= color %>">
            <%= radio_button_tag "properties[#{input["key"]}_color]", color, color == preview["color"], class: "peer sr-only", data: { action: "personalize#update" }, aria: { label: color } %>
            <span class="block size-9 rounded-full border border-line ring-offset-2 peer-checked:ring-2 peer-checked:ring-ink peer-focus-visible:ring-2" style="background: <%= color %>"></span>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>
</div>
