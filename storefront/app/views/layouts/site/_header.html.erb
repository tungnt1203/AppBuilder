<%# The site's header, as Dawn has it: the logo (a theme setting the owner uploads) or the name on
    the left, the collections and the owner's "header" menu beside it, search and the cart on the
    right. On phones: the menu button, the name in the middle, search and the cart. Pages can add
    links with content_for :site_nav, or show only the logo and the cart with content_for
    :focused (checkout: nothing to wander off to). %>
<% menu_items = shop_menu(:header)&.items.to_a %>
<% shop_collections = collections.select { |collection| collection.product_count.to_i.positive? }.first(6) %>
<% nav_link = "py-2 text-sm whitespace-nowrap text-muted underline-offset-4 hover:text-ink hover:underline aria-[current=page]:text-ink aria-[current=page]:underline" %>
<header class="sticky top-0 z-20 border-b border-line bg-canvas">
  <div class="page-width flex h-16 items-center gap-6 md:h-[84px]">
    <% unless content_for?(:focused) %>
    <div class="md:hidden" data-controller="menu" data-action="click@window->menu#close keydown@window->menu#escape turbo:before-cache@document->menu#hide">
      <button type="button" class="group -ml-2 grid size-10 place-items-center text-ink" data-menu-target="button" data-action="menu#toggle" aria-expanded="false" aria-label="<%= t("ui.menu") %>">
        <%= icon "menu", size: 22, stroke: 1.5, class: "group-aria-expanded:hidden" %>
        <%= icon "x", size: 22, stroke: 1.5, class: "hidden group-aria-expanded:block" %>
      </button>
      <nav data-menu-target="panel" class="absolute inset-x-0 top-full hidden max-h-[calc(100svh-4rem)] overflow-y-auto border-b border-line bg-canvas px-4 pt-2 pb-6" aria-label="<%= t("ui.navigation") %>">
        <ul>
          <li><%= link_to t("layouts.site.shop_all"), products_path, class: "block py-3 text-lg text-ink" %></li>
          <% shop_collections.each do |collection| %>
            <li>
              <%= link_to collection_path(collection), class: "flex items-center justify-between py-3 text-lg text-ink" do %>
                <%= collection.title %> <%= icon "chevron-right", size: 18, stroke: 1.5, class: "text-muted" %>
              <% end %>
            </li>
          <% end %>
          <% menu_items.each do |item| %>
            <li><%= shop_menu_link item, class: "block py-3 text-lg text-ink" %></li>
          <% end %>
        </ul>
        <ul class="mt-4 space-y-1 border-t border-line pt-4 text-sm text-muted">
          <li><%= link_to t("order_lookups.new.title"), new_order_lookup_path, class: "block py-2 hover:text-ink" %></li>
          <li><%= link_to t("contacts.show.title"), contact_path, class: "block py-2 hover:text-ink" %></li>
        </ul>
      </nav>
    </div>
    <% end %>

    <%= link_to root_path, class: "flex min-w-0 shrink items-center text-ink max-md:flex-1 max-md:justify-center" do %>
      <% if (logo = theme_setting(:logo).presence) %>
        <%= image_tag logo, alt: current_shop.name, class: "h-8 w-auto max-w-40 object-contain md:h-9" %>
      <% else %>
        <%# A long name wraps onto two balanced lines rather than losing its end. %>
        <span class="line-clamp-2 font-display text-xl leading-tight font-semibold text-balance max-md:text-center <%= "max-md:text-sm" if current_shop.name.length > 18 %>"><%= current_shop.name %></span>
      <% end %>
    <% end %>

    <% if content_for?(:focused) %>
      <span class="flex-1"></span>
    <% else %>
    <nav class="hidden flex-1 items-center gap-6 md:flex" aria-label="<%= t("ui.navigation") %>">
      <% shop_collections.first(4).each do |collection| %>
        <%= link_to collection.title, collection_path(collection), class: nav_link, aria: { current: ("page" if current_page?(collection_path(collection))) } %>
      <% end %>
      <%= link_to t("layouts.site.shop_all"), products_path, class: nav_link, aria: { current: ("page" if current_page?(products_path)) } %>
      <% menu_items.each do |item| %>
        <%= shop_menu_link item, class: nav_link %>
      <% end %>
      <%= yield :site_nav %>
    </nav>
    <%= render "layouts/site/search", stroke: 1.5 %>
    <% end %>

    <%= link_to cart_path, class: "relative -mr-2 grid size-10 place-items-center text-ink", id: "cart-link", aria: { label: t("layouts.site.cart_with_count", count: cart_item_count) } do %>
      <%= icon "shopping-bag", size: 22, stroke: 1.5 %>
      <% if cart_item_count.positive? %>
        <span class="absolute right-0.5 bottom-0.5 grid min-w-[1.125rem] place-items-center rounded-full bg-brand-600 px-1 text-[0.625rem] leading-[1.125rem] text-on-brand"><%= cart_item_count %></span>
      <% end %>
    <% end %>
  </div>
</header>
