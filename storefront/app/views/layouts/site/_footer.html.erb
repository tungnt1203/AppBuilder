<%# The site's footer: what shoppers look for (the collections, contact, shipping and returns, the
    owner's "footer" menu, their social pages from Settings → Theme). Redesign it for the shop, but
    keep the links to the policies and the contact page: payment providers and ad networks check
    that they're there. %>
<% socials = { "Instagram" => theme_setting(:instagram_url), "TikTok" => theme_setting(:tiktok_url), "Facebook" => theme_setting(:facebook_url) }.compact_blank %>
<footer class="mt-24 border-t border-line bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 text-sm sm:grid-cols-2 md:grid-cols-4">
    <div class="sm:col-span-2 md:col-span-1">
      <p class="font-display text-lg font-semibold text-ink"><%= current_shop.name %></p>
      <% if (tagline = theme_setting(:hero_text).presence) %>
        <p class="mt-2 max-w-xs leading-relaxed text-muted"><%= tagline %></p>
      <% end %>
      <% if socials.any? %>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="<%= t("layouts.site.follow") %>">
          <% socials.each do |name, url| %>
            <li><%= link_to name, url, class: "inline-flex rounded-full border border-line px-3 py-1.5 text-xs font-semibold text-ink hover:border-ink", target: "_blank", rel: "noopener" %></li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <nav aria-label="<%= t("layouts.site.shop") %>">
      <p class="font-semibold text-ink"><%= t("layouts.site.shop") %></p>
      <ul class="mt-3 space-y-2 text-muted">
        <li><%= link_to t("layouts.site.shop_all"), products_path, class: "hover:text-ink" %></li>
        <% collections.select { |collection| collection.product_count.to_i.positive? }.first(5).each do |collection| %>
          <li><%= link_to collection.title, collection_path(collection), class: "hover:text-ink" %></li>
        <% end %>
      </ul>
    </nav>

    <nav aria-label="<%= t("layouts.site.footer_navigation") %>">
      <p class="font-semibold text-ink"><%= t("layouts.site.help") %></p>
      <ul class="mt-3 space-y-2 text-muted">
        <li><%= link_to t("order_lookups.new.title"), new_order_lookup_path, class: "hover:text-ink" %></li>
        <li><%= link_to t("contacts.show.title"), contact_path, class: "hover:text-ink" %></li>
        <% current_shop.policies.each do |policy| %>
          <li><%= link_to policy["title"], policy_path(policy["id"]), class: "hover:text-ink" %></li>
        <% end %>
      </ul>
    </nav>

    <% if (footer_menu = shop_menu(:footer))&.items.present? %>
      <nav aria-label="<%= footer_menu.title %>">
        <p class="font-semibold text-ink"><%= footer_menu.title %></p>
        <ul class="mt-3 space-y-2 text-muted">
          <% footer_menu.items.each do |item| %>
            <li><%= shop_menu_link item, class: "hover:text-ink" %></li>
          <% end %>
        </ul>
      </nav>
    <% end %>
  </div>
  <div class="border-t border-line">
    <p class="mx-auto max-w-6xl px-4 py-5 text-xs text-muted">© <%= Date.current.year %> <%= current_shop.name %></p>
  </div>
</footer>
