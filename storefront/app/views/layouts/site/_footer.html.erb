<%# The site's footer, as Dawn has it: the shop (logo, a line about it, its social pages), then
    plain columns of links (the collections, help with the policies and contact page, the owner's
    "footer" menu), and a small last row. Keep the links to the policies and the contact page:
    payment providers and ad networks check that they're there. %>
<% socials = { "Instagram" => theme_setting(:instagram_url), "TikTok" => theme_setting(:tiktok_url), "Facebook" => theme_setting(:facebook_url) }.compact_blank %>
<% footer_menu = shop_menu(:footer) %>
<footer class="mt-20 border-t border-line bg-surface-muted md:mt-28">
  <div class="page-width grid gap-10 py-12 text-sm sm:grid-cols-2 <%= footer_menu&.items.present? ? "md:grid-cols-[minmax(0,2fr)_repeat(3,minmax(0,1fr))]" : "md:grid-cols-[minmax(0,2fr)_repeat(2,minmax(0,1fr))]" %> md:gap-12 md:py-16">
    <div class="sm:col-span-2 md:col-span-1">
      <%= link_to root_path, class: "inline-block text-ink" do %>
        <% if (logo = theme_setting(:logo).presence) %>
          <%= image_tag logo, alt: current_shop.name, class: "h-9 w-auto max-w-44 object-contain" %>
        <% else %>
          <span class="font-display text-xl"><%= current_shop.name %></span>
        <% end %>
      <% end %>
      <p class="mt-4 max-w-sm leading-relaxed text-muted"><%= theme_setting(:hero_text).presence || t("home.show.tagline") %></p>
      <% if socials.any? %>
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="<%= t("layouts.site.follow") %>">
          <% socials.each do |name, url| %>
            <li><%= link_to name, url, class: "inline-flex h-9 items-center rounded-lg border border-line bg-canvas px-3.5 text-xs text-ink transition hover:border-ink", target: "_blank", rel: "noopener" %></li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <nav aria-label="<%= t("layouts.site.shop") %>">
      <p class="text-sm font-medium text-ink"><%= t("layouts.site.shop") %></p>
      <ul class="mt-4 space-y-3 text-muted">
        <li><%= link_to t("layouts.site.shop_all"), products_path, class: "hover:text-ink hover:underline" %></li>
        <% collections.select { |collection| collection.product_count.to_i.positive? }.first(5).each do |collection| %>
          <li><%= link_to collection.title, collection_path(collection), class: "hover:text-ink hover:underline" %></li>
        <% end %>
      </ul>
    </nav>

    <nav aria-label="<%= t("layouts.site.footer_navigation") %>">
      <p class="text-sm font-medium text-ink"><%= t("layouts.site.help") %></p>
      <ul class="mt-4 space-y-3 text-muted">
        <li><%= link_to t("order_lookups.new.title"), new_order_lookup_path, class: "hover:text-ink hover:underline" %></li>
        <li><%= link_to t("contacts.show.title"), contact_path, class: "hover:text-ink hover:underline" %></li>
        <% current_shop.policies.each do |policy| %>
          <li><%= link_to policy["title"], policy_path(policy["id"]), class: "hover:text-ink hover:underline" %></li>
        <% end %>
      </ul>
    </nav>

    <% if footer_menu&.items.present? %>
      <nav aria-label="<%= footer_menu.title %>">
        <p class="text-sm font-medium text-ink"><%= footer_menu.title %></p>
        <ul class="mt-4 space-y-3 text-muted">
          <% footer_menu.items.each do |item| %>
            <li><%= shop_menu_link item, class: "hover:text-ink hover:underline" %></li>
          <% end %>
        </ul>
      </nav>
    <% end %>
  </div>
  <div class="border-t border-line">
    <div class="page-width flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-6 text-xs text-muted">
      <p>© <%= Date.current.year %>, <%= current_shop.name %></p>
      <p class="flex items-center gap-1.5"><%= icon "lock", size: 12 %> <%= t("products.show.secure_checkout") %></p>
    </div>
  </div>
</footer>
