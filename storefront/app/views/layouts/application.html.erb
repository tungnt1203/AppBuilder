<!DOCTYPE html>
<html class="h-full">
  <head>
    <%= render "layouts/head" %>
    <%= render "layouts/site/tracking_tags" %>
  </head>

  <%# The shop's site: home, catalog, product pages, cart, checkout. It's an open canvas: design
      the header, the footer and every section for this shop (see DESIGN.md). %>
  <body class="min-h-full bg-canvas font-sans text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded-lg focus:bg-surface focus:px-3 focus:py-2"><%= t("ui.skip") %></a>

    <%= render "layouts/site/announcement" %>
    <%= render "layouts/site/header" %>

    <main id="main">
      <% if flash[:notice] || flash[:alert] %>
        <div class="mx-auto max-w-6xl px-4 pt-8">
          <%= render "ui/flash" %>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <%= render "layouts/site/footer" %>
    <%= render "layouts/site/tracking_events" %>
  </body>
</html>
