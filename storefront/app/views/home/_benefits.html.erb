<%# Why it's safe to buy here, under the first screen: each line from the shop's own settings and
    products, so it stays true when the owner changes them. The owner turns it off in Settings →
    Theme. Plain icons and words in the theme's type, as Shopify themes' multicolumn has them,
    centered in one row on wide screens; an odd last line spans the row on phones. %>
<% shipping = current_shop.shipping
   lines = [
     ([ "truck", t("products.show.free_shipping_over", amount: money(shipping.free_over_cents)) ] if shipping&.free_over_cents),
     ([ "calendar-check", delivery_estimate ] if delivery_estimate),
     ([ "pencil", t(".personalize") ] if @personalized&.any?),
     ([ "paintbrush", t(".made_to_order") ] if @products&.records&.any?(&:made_to_order?)),
     ([ "mail", t(".questions") ] if current_shop.contact&.[](:email).present?)
   ].compact.first(3) + [ [ "lock", t(".secure") ] ] %>
<section class="border-b border-line">
  <ul class="page-width grid grid-cols-2 gap-x-4 gap-y-5 py-7 md:flex md:flex-wrap md:justify-center md:gap-x-16">
    <% lines.each do |name, text| %>
      <li class="flex items-center gap-3 text-sm text-ink last:odd:col-span-2">
        <%= icon name, size: 20, stroke: 1.5, class: "text-ink" %>
        <%= text %>
      </li>
    <% end %>
  </ul>
</section>
