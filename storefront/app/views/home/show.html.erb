<%# The site's home page. A plain starting point: redesign it for the shop (blocks/ has the
    sections to build from). The hero's words and photo are theme settings
    (config/theme_settings.yml), so the owner can change them in the admin. %>
<% hero_button = theme_setting(:hero_button).presence || t(".shop_all") %>
<% if (hero_image = theme_setting(:hero_image).presence) %>
  <section class="relative isolate flex min-h-[78svh] items-end overflow-hidden bg-ink md:min-h-[80vh] md:items-center">
    <%= image_tag hero_image, alt: "", class: "absolute inset-0 -z-10 size-full object-cover", fetchpriority: "high" %>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/75 via-black/25 to-transparent md:bg-gradient-to-r md:from-black/60 md:via-black/20"></div>
    <div class="mx-auto w-full max-w-6xl px-4 pt-40 pb-10 md:py-24">
      <h1 class="max-w-xl font-display text-5xl leading-[1.02] font-semibold tracking-tight text-balance text-white md:text-7xl"><%= theme_setting(:hero_title) || current_shop.name %></h1>
      <p class="mt-4 max-w-md text-lg text-white/85"><%= theme_setting(:hero_text) || t(".tagline") %></p>
      <%= link_to hero_button, products_path, class: "mt-8 inline-flex items-center rounded-full bg-white px-6 py-3.5 font-semibold text-ink transition hover:bg-white/90" %>
    </div>
  </section>
<% else %>
  <%# Without a photo, the shop's own products stand in for one. %>
  <% covers = @products.records.select(&:image).first(2) %>
  <section class="overflow-hidden border-b border-line bg-brand-50">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 sm:py-20 md:grid-cols-2">
      <div>
        <h1 class="max-w-2xl font-display text-4xl leading-tight font-semibold tracking-tight text-balance sm:text-6xl"><%= theme_setting(:hero_title) || current_shop.name %></h1>
        <p class="mt-4 max-w-xl text-lg text-muted"><%= theme_setting(:hero_text) || t(".tagline") %></p>
        <%= link_to products_path, class: "#{button_classes} mt-8 gap-2 rounded-full px-6 py-3" do %>
          <%= hero_button %> <%= icon "arrow-right", size: 18 %>
        <% end %>
      </div>
      <% if covers.any? %>
        <div class="relative mx-auto grid w-full max-w-64 grid-cols-2 gap-3 sm:max-w-md sm:gap-4" aria-hidden="true">
          <% covers.each_with_index do |product, index| %>
            <%= product_image product, size: :card, alt: "", loading: "eager", class: "aspect-4/5 w-full rounded-2xl shadow-xl #{index.odd? ? "mt-12" : "-mb-12"}" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<%= render "home/benefits" if theme_setting(:show_benefits) %>

<% if @collections.any? %>
  <section class="mx-auto max-w-6xl px-4 pt-16">
    <h2 class="font-display text-2xl font-semibold tracking-tight"><%= t(".collections") %></h2>
    <%# On phones a row to swipe (the next tile peeking in), so no count leaves a tile on its own. %>
    <ul class="-mx-4 mt-6 flex snap-x snap-mandatory scroll-px-4 gap-3 overflow-x-auto px-4 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0">
      <% @collections.each do |collection| %>
        <li class="w-[70%] shrink-0 snap-start md:w-auto">
          <%= link_to collection_path(collection), class: "group relative block aspect-[4/5] overflow-hidden rounded-xl bg-surface-muted" do %>
            <%= collection_image collection, class: "absolute inset-0 size-full transition duration-500 group-hover:scale-105" %>
            <span class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></span>
            <span class="absolute inset-x-0 bottom-0 p-4 font-display text-lg font-semibold text-white"><%= collection.title %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<%= render "blocks/personalized", products: @personalized if @personalized.any? %>

<section class="mx-auto max-w-6xl px-4 pt-16">
  <div class="flex items-end justify-between gap-4">
    <h2 class="font-display text-2xl font-semibold tracking-tight"><%= t(".new_arrivals") %></h2>
    <%= link_to t(".view_all"), products_path, class: "text-sm #{link_classes}" if @products.any? %>
  </div>
  <div class="mt-6">
    <% if @products.any? %>
      <%= render "products/grid", products: @products.records %>
    <% else %>
      <%= render "products/coming_soon" %>
    <% end %>
  </div>
</section>
