<% content_for :title, t(".title", number: @order.name) %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>

<div class="mx-auto max-w-3xl px-4 py-12">
  <% if params[:placed] && !(@order.card? && @order.pending?) %>
    <div class="mb-8 rounded-xl border border-green-200 bg-green-50 p-6 text-green-900">
      <p class="flex items-center gap-2 text-lg font-semibold"><%= icon "circle-check" %> <%= t(".thanks", name: @order.shipping_address.name) %></p>
      <p class="mt-1 text-sm"><%= t(".confirmation_sent", email: @order.email) %></p>
    </div>
  <% end %>

  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-3xl"><%= t(".title", number: @order.name) %></h1>
    <%= order_status_badge @order %>
  </div>
  <p class="mt-1 text-sm text-muted"><%= t(".placed_on_html", date: local_time(@order.placed_at)) %></p>

  <p class="mt-6 text-ink"><%= t(".status_text.#{@order.card? && @order.pending? ? "unpaid_card" : @order.status}") %></p>

  <% if @order.payment.required? %>
    <div class="mt-6 rounded-xl border border-line bg-surface p-6">
      <% if params[:payment_intent] %>
        <p class="text-sm text-muted"><%= t(".card_processing") %></p>
      <% end %>
      <%= link_to order_payment_path(@order), class: "mt-3 #{button_classes}" do %>
        <%= icon "credit-card", size: 18 %> <%= t(".pay_now", total: money(@order.total_cents, @order.currency)) %>
      <% end %>
    </div>
  <% elsif @order.pending? && !@order.card? %>
    <%# Paid another way: the shop's instructions, or word that it sends them when it has none. %>
    <div class="mt-6 rounded-xl border border-line bg-surface p-6">
      <h2 class="font-semibold"><%= t(".how_to_pay") %></h2>
      <div class="mt-2 text-sm leading-relaxed"><%= @order.payment.instructions.present? ? simple_format(@order.payment.instructions) : tag.p(t(".instructions_by_email")) %></div>
    </div>
  <% end %>

  <% if (tracking = @order.tracking) %>
    <div class="mt-6 rounded-xl border border-line bg-surface p-6">
      <h2 class="flex items-center gap-2 font-semibold"><%= icon "truck", size: 18 %> <%= t(".tracking") %></h2>
      <p class="mt-2 text-sm"><%= [ tracking.carrier, tracking.number ].compact_blank.join(" · ") %></p>
      <%= link_to t(".track"), tracking.url, class: "mt-3 inline-block text-sm #{link_classes}", target: "_blank", rel: "noopener" if tracking.url.present? %>
    </div>
  <% end %>

  <% if @order.reviewable_products.any? %>
    <div class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-surface p-6">
      <p class="flex items-center gap-2 font-semibold"><%= icon "star", size: 18 %> <%= t(".review_prompt") %></p>
      <%= link_to t(".review"), new_order_review_path(@order), class: button_classes(:secondary) %>
    </div>
  <% end %>

  <ul class="mt-8 divide-y divide-line border-y border-line">
    <% @order.items.each do |item| %>
      <li class="flex items-center justify-between gap-4 py-4 text-sm">
        <%= render "personalization/line_image", image: item.image, layers: item.preview, alt: item.title, class: "size-16 shrink-0 rounded-lg" %>
        <span class="min-w-0 flex-1">
          <%= item.quantity %> × <%= item.title %>
          <% if item.variant_title %><span class="block text-muted"><%= item.variant_title %></span><% end %>
          <% item.properties.each do |property| %><span class="block text-muted"><%= property.label %>: <%= property_value(property) %></span><% end %>
        </span>
        <span class="whitespace-nowrap"><%= money(item.line_total_cents, @order.currency) %></span>
      </li>
    <% end %>
  </ul>
  <dl class="mt-4 ml-auto max-w-xs space-y-2 text-sm">
    <div class="flex justify-between"><dt class="text-muted"><%= t(".subtotal") %></dt><dd><%= money(@order.subtotal_cents, @order.currency) %></dd></div>
    <% if @order.discount_cents.positive? %><div class="flex justify-between"><dt class="text-muted"><%= t("orders.show.discount", code: @order.discount_code) %></dt><dd>-<%= money(@order.discount_cents, @order.currency) %></dd></div><% end %>
    <div class="flex justify-between"><dt class="text-muted"><%= t(".shipping") %></dt><dd><%= money(@order.shipping_cents, @order.currency) %></dd></div>
    <% if @order.tax_cents.positive? %><div class="flex justify-between"><dt class="text-muted"><%= t("orders.show.tax") %></dt><dd><%= money(@order.tax_cents, @order.currency) %></dd></div><% end %>
    <div class="flex justify-between border-t border-line pt-2 text-base font-semibold"><dt><%= t(".total") %></dt><dd><%= money(@order.total_cents, @order.currency) %></dd></div>
  </dl>

  <div class="mt-10 grid gap-6 text-sm sm:grid-cols-2">
    <div>
      <h2 class="font-semibold"><%= t(".ship_to") %></h2>
      <p class="mt-2 text-muted"><%= safe_join(@order.shipping_address.lines, tag.br) %></p>
    </div>
    <div>
      <h2 class="font-semibold"><%= t(".contact") %></h2>
      <p class="mt-2 text-muted"><%= @order.email %></p>
      <% if (email = current_shop.contact&.email).present? %>
        <p class="mt-4"><%= t(".questions") %> <%= mail_to email, class: link_classes %></p>
      <% end %>
    </div>
  </div>
</div>
