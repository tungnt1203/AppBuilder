<%# Under a row to swipe (the rail controller on a wrapper, the row its "list" target): a track
    showing how much is seen and where, and arrows a card at a time, so a row running past the
    edge reads as more to see. Hidden when every card fits (a row that becomes a grid on desktop).
    on_color: true on a band of color (the controls take the text's color instead of the page's). %>
<% on_color = local_assigns[:on_color] %>
<div class="mt-5 flex items-center gap-4" data-rail-target="controls" hidden>
  <span class="relative h-0.5 flex-1 overflow-hidden rounded-full <%= on_color ? "bg-current/25" : "bg-line" %>" aria-hidden="true">
    <span class="absolute inset-y-0 left-0 rounded-full <%= on_color ? "bg-current" : "bg-ink" %> transition-transform duration-150" data-rail-target="thumb"></span>
  </span>
  <% { "previous" => "chevron-left", "next" => "chevron-right" }.each do |direction, glyph| %>
    <button type="button" class="grid size-9 place-items-center rounded-full border transition disabled:opacity-35 <%= on_color ? "border-current/40 text-current hover:border-current" : "border-line text-ink hover:border-ink disabled:hover:border-line" %>"
            data-rail-target="<%= direction %>" data-action="rail#<%= direction %>" aria-label="<%= direction.capitalize %>">
      <%= icon glyph, size: 16, stroke: 1.5 %>
    </button>
  <% end %>
</div>
