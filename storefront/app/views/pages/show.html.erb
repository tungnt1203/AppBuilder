<% content_for :title, @page.title %>

<%# A page the owner wrote in the admin: text, and questions with their answers. %>
<article class="mx-auto max-w-3xl px-4 py-12 leading-relaxed text-ink">
  <h1 class="font-display text-3xl font-semibold tracking-tight md:text-4xl"><%= @page.title %></h1>
  <% @page.blocks.each do |block| %>
    <% if block["type"] == "faq" %>
      <div class="mt-8 divide-y divide-line border-y border-line">
        <% Array(block["items"]).each do |item| %>
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium"><%= item["question"] %><%= icon "chevron-down", size: 18, class: "shrink-0 transition group-open:rotate-180" %></summary>
            <div class="mt-3 text-ink/90"><%= simple_format item["answer"] %></div>
          </details>
        <% end %>
      </div>
    <% else %>
      <div class="mt-4"><%= policy_text block["body"] %></div>
    <% end %>
  <% end %>
</article>
