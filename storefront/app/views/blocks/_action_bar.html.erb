    <a href="sms:+12125550142" class="grid size-12 place-items-center rounded-lg text-ink ring-1 ring-line ring-inset" aria-label="Text us"><%= icon "message-circle", size: 20 %></a>
    <a href="#book" class="flex h-12 flex-1 items-center justify-center gap-2 rounded-lg bg-brand-600 font-semibold text-white"><%= icon "calendar-check", size: 18 %> Book now</a>
  </div>
