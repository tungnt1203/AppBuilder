<%# Image with text: the shop's story, how things are made, who draws the designs. A photo on
    one side and a few true sentences on the other; for a second one further down the page, put
    the photo on the other side (md:order-last on it) so the page zigzags. The words are the
    owner's: what they told you, not "passion" and "quality". %>
<% photo = "https://images.unsplash.com/photo-1643216674491-33878507b402?ixid=M3wxMTA4ODU4fDB8MXxzZWFyY2h8Mnx8c2NyZWVuJTIwcHJpbnRpbmclMjBzdHVkaW98ZW58MXwwfHx8MTc5MjU1MDM5NXww&ixlib=rb-4.1.0&w=1200&q=80&fm=jpg&fit=max" %>
<section class="bg-surface py-16 md:py-24">
  <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 md:grid-cols-2 md:gap-16">
    <figure>
      <%= image_tag photo, alt: "Ink pulled through a screen onto a white tee", loading: "lazy", class: "aspect-[4/3] w-full rounded-2xl object-cover md:aspect-[4/5]" %>
      <figcaption class="mt-2 text-[11px] text-muted">
        Photo: <a href="https://unsplash.com/@ddography?utm_source=app_builder&utm_medium=referral" class="underline">Deniz Demirci</a> on <a href="https://unsplash.com/?utm_source=app_builder&utm_medium=referral" class="underline">Unsplash</a>
      </figcaption>
    </figure>

    <div>
      <p class="text-xs font-semibold tracking-[0.2em] text-brand-700 uppercase">How it's made</p>
      <h2 class="mt-3 text-3xl leading-tight font-bold text-balance text-ink md:text-5xl">Drawn by hand, printed one at a time</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">Every design starts in a sketchbook. When you order, your tee is printed on 100% ring-spun cotton and sent straight to you, so nothing sits in a warehouse.</p>
      <%= link_to products_path, class: "mt-8 inline-flex items-center gap-2 border-b-2 border-ink pb-1 font-semibold text-ink transition hover:gap-3" do %>
        Find your design <%= icon "arrow-right", size: 18 %>
      <% end %>
    </div>
  </div>
</section>
