<%# Why choose us: a heading on one side, three or four reasons with icons on the other. Say
    concrete things this business does (hygiene, a warranty, free parking), never "quality
    service". Find icons with bin/icons. Structure after HyperUI feature grids (MIT). %>
<section class="bg-canvas py-16 md:py-24">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 md:grid-cols-2 md:gap-16">
    <div>
      <h2 class="text-3xl leading-tight font-bold text-balance text-ink md:text-4xl">Clean comes first</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">Tools are sterilized after every client; files and buffers are single-use.</p>
    </div>

    <ul class="space-y-6">
      <% [ [ "shield-check", "Every kit sterilized", "Autoclaved at 250°F; we open the sealed pouch in front of you." ],
           [ "sparkles", "Genuine gel polish", "Lasts 3–4 weeks without lifting. Chips within 7 days are fixed free." ],
           [ "car", "Free parking", "A lot right in front of the studio, with spaces for bikes too." ] ].each do |name, title, text| %>
        <li class="flex items-start gap-4">
          <span class="grid size-12 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-700"><%= icon name, size: 22 %></span>
          <div>
            <h3 class="text-lg font-semibold text-ink"><%= title %></h3>
            <p class="mt-1 leading-relaxed text-muted"><%= text %></p>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
</section>
