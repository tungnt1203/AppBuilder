<%# Join the list: an email box for news of drops and sales, before the footer. It posts to one
    of the storefront's forms (config/forms.yml): add one with the key "newsletter" and an email
    field, and sign-ups land in the shop's inbox. Promise only what the owner will send. %>
<section class="bg-brand-950 py-16 text-white md:py-20">
  <div class="page-width flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <div class="max-w-md">
      <h2 class="text-3xl leading-tight md:text-4xl">First dibs on new drops</h2>
      <p class="mt-3 leading-relaxed text-white/75">One email when a new design lands. Nothing else.</p>
    </div>
    <%= form_with url: form_submissions_path("newsletter"), class: "flex w-full max-w-md gap-2" do %>
      <%= label_tag "newsletter_email", "Email", class: "sr-only" %>
      <%= email_field_tag "answers[email]", nil, id: "newsletter_email", required: true, autocomplete: "email", placeholder: "you@example.com",
            class: "h-12 min-w-0 flex-1 rounded-full border-0 bg-white/10 px-5 text-white placeholder:text-white/50 focus:ring-2 focus:ring-white" %>
      <%= button_tag "Join", class: "h-12 shrink-0 rounded-full bg-white px-6 font-semibold text-brand-950 transition hover:bg-white/90" %>
    <% end %>
  </div>
</section>
