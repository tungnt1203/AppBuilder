<%# A band of big numbers on the brand color: years open, customers served, rating. Only true
    numbers the owner gave; three is plenty. Structure after HyperUI stats (MIT). %>
<section class="bg-brand-700 py-12 text-white md:py-16">
  <dl class="mx-auto grid max-w-6xl grid-cols-3 gap-4 px-4 text-center">
    <% [ [ "12", "years open" ], [ "8,000+", "clients served" ], [ "4.9★", "on Google" ] ].each do |value, label| %>
      <div class="flex flex-col">
        <dt class="order-last mt-1 text-sm text-white/75 md:text-base"><%= label %></dt>
        <dd class="font-display text-3xl font-bold md:text-5xl"><%= value %></dd>
      </div>
    <% end %>
  </dl>
</section>
