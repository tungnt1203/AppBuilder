<%# A row of products to swipe: best sellers, new in, one collection. On phones the next card
    peeks in so buyers know to swipe; on wide screens four fit and the rest scroll. Pass the
    records from the controller (products(collection: "…", per_page: 8) here only for the
    blocks page). Product cards are products/_product: restyle that partial, not a copy here. %>
<% arrivals = products(per_page: 8).records %>
<section class="py-16 md:py-24">
  <div class="page-width flex items-end justify-between gap-4">
    <div>
      <h2 class="text-3xl text-ink md:text-4xl">New this week</h2>
    </div>
    <%= link_to products_path, class: "inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-ink underline-offset-4 hover:underline" do %>
      View all
    <% end %>
  </div>

  <% if arrivals.any? %>
    <div data-controller="rail">
      <ul class="page-width mt-8 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto pb-4 [scrollbar-width:none]" data-rail-target="list" data-action="scroll->rail#update">
        <% arrivals.each do |product| %>
          <li class="w-[68%] shrink-0 snap-start sm:w-[40%] md:w-[calc((100%-3rem)/4)]">
            <%= render "products/product", product: %>
          </li>
        <% end %>
      </ul>
      <div class="page-width"><%= render "ui/rail_controls" %></div>
    </div>
  <% else %>
    <div class="page-width mt-8"><%= render "products/coming_soon" %></div>
  <% end %>
</section>
