<%# Image banner, the first screen of most shops that sell from ads: one big lifestyle photo
    (people wearing or using what the shop sells), a short line on top and the way into the shop.
    The words sit low on phones, where thumbs are, and to the left on wide screens. Make the photo
    a theme setting (type image, the bin/images link as its default) so the owner can swap it,
    and keep the photo's credit. %>
<% photo = "https://images.unsplash.com/photo-1534269381359-1960882a3938?ixid=M3wxMTA4ODU4fDB8MXxzZWFyY2h8M3x8d29tYW4lMjB3ZWFyaW5nJTIwZ3JhcGhpYyUyMHQtc2hpcnQlMjBzdHJlZXR8ZW58MXwwfHx8MTc5MjU1MDM4Nnww&ixlib=rb-4.1.0&w=1600&q=80&fm=jpg&fit=max" %>
<section class="relative isolate flex min-h-[78svh] items-end overflow-hidden bg-ink md:min-h-[86vh] md:items-center">
  <%= image_tag photo, alt: "", class: "absolute inset-0 -z-10 size-full object-cover object-[60%_center]", fetchpriority: "high" %>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/75 via-black/25 to-transparent md:bg-gradient-to-r md:from-black/60 md:via-black/20"></div>

  <div class="mx-auto w-full max-w-6xl px-4 pt-40 pb-10 md:py-24">
    <h1 class="max-w-xl text-5xl leading-[1.02] text-balance text-white md:text-7xl">Wear the thing you love</h1>
    <p class="mt-4 max-w-md text-lg leading-relaxed text-white/85">Soft heavyweight tees with art drawn in our studio. Free shipping over $50.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <%= link_to products_path, class: "inline-flex items-center gap-2 rounded-full bg-white px-6 py-3.5 font-semibold text-ink transition hover:bg-white/90" do %>
        Shop the drop
      <% end %>
      <a href="#collections" class="inline-flex items-center rounded-full px-6 py-3.5 font-semibold text-white ring-1 ring-white/50 transition ring-inset hover:bg-white/10">Browse collections</a>
    </div>
  </div>

  <p class="absolute right-3 bottom-2 text-[11px] text-white/60">
    Photo: <a href="https://unsplash.com/@dennys88?utm_source=app_builder&utm_medium=referral" class="underline">Dennys Lennon</a> on <a href="https://unsplash.com/?utm_source=app_builder&utm_medium=referral" class="underline">Unsplash</a>
  </p>
</section>
