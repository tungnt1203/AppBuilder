<%# Make it yours: the products buyers personalize (a name, a date, their photo, a star map), what
    a shop of personalized gifts sells on. Says that buyers see it on the product before they buy,
    beside up to four of them. Pass `products` from the controller (the products whose
    `personalized?` is true); here alone (the blocks page) it finds them. Cards are products/_product. %>
<% picks = local_assigns.fetch(:products) { products(per_page: 24).records.select(&:personalized?) }.first(4) %>
<section class="py-16 md:py-24">
  <div class="page-width grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:items-center">
    <div>
      <h2 class="text-3xl text-ink md:text-4xl">Make it yours</h2>
      <p class="mt-4 text-muted">Add a name, a date or your own photo, and see it on the product before you buy.</p>
      <ul class="mt-6 space-y-3 text-sm text-ink">
        <li class="flex items-center gap-3"><%= icon "type", size: 18, stroke: 1.5 %> Names and words in the font you like</li>
        <li class="flex items-center gap-3"><%= icon "image-plus", size: 18, stroke: 1.5 %> Your photo, framed the way you want</li>
        <li class="flex items-center gap-3"><%= icon "eye", size: 18, stroke: 1.5 %> A live preview as you type</li>
      </ul>
    </div>
    <% if picks.any? %>
      <%# On phones a row to swipe (the next card peeking in), so three never leave one on its own. %>
      <div data-controller="rail">
        <ul class="-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:gap-y-8 md:overflow-visible md:px-0 <%= "lg:grid-cols-4" if picks.size > 3 %> <%= "lg:grid-cols-3" if picks.size == 3 %>" data-rail-target="list" data-action="scroll->rail#update">
          <% picks.each do |product| %>
            <li class="w-[44%] shrink-0 snap-start md:w-auto"><%= render "products/product", product: %></li>
          <% end %>
        </ul>
        <%= render "ui/rail_controls" %>
      </div>
    <% elsif current_shop.preview? %>
      <p class="rounded-xl border border-dashed border-line px-6 py-10 text-center text-sm text-muted">Products buyers personalize show here once the owner adds a field to them in the admin.</p>
    <% end %>
  </div>
</section>
