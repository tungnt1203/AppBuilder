<% content_for :title, t(".title") %>

<%# The cart as the big shops lay it out: the lines on the left, and on the right (under them on a
    phone) a summary that stays in view: how close the cart is to free shipping, the discount
    code, the subtotal, the button and what makes buyers trust it. %>
<div class="page-width py-10 md:py-14">
  <div class="flex items-baseline justify-between gap-4">
    <h1 class="text-3xl md:text-4xl"><%= t(".title") %></h1>
    <% if @cart && !@cart.empty? %>
      <%= link_to t(".continue"), products_path, class: "text-sm text-muted underline underline-offset-4 hover:text-ink" %>
    <% end %>
  </div>

  <% if @cart && !@cart.empty? %>
    <% threshold = current_shop.shipping.free_over_cents %>
    <% subtotal = @cart.subtotal_cents %>
    <div class="mt-8 grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_24rem] lg:gap-14">
      <ul class="divide-y divide-line border-y border-line">
        <% @cart.items.each do |item| %>
          <li class="flex gap-4 py-6 md:gap-6" id="cart_item_<%= item.id %>">
            <%= link_to product_path(item.product), class: "w-24 shrink-0 md:w-32" do %>
              <%= render "personalization/line_image", image: item.product.image, layers: item.preview, alt: item.product.title, class: "aspect-square w-24 rounded-lg md:w-32" %>
            <% end %>
            <div class="flex min-w-0 flex-1 flex-col gap-3">
              <div class="flex justify-between gap-4">
                <div class="min-w-0">
                  <%= link_to item.product.title, product_path(item.product), class: "text-ink hover:underline" %>
                  <% if item.variant.title %>
                    <p class="mt-1 text-sm text-muted"><%= item.variant.title %></p>
                  <% end %>
                  <% item.properties.each do |property| %>
                    <p class="mt-0.5 text-sm text-muted"><%= property.label %>: <span class="text-ink"><%= property_value(property) %></span></p>
                  <% end %>
                </div>
                <p class="whitespace-nowrap text-ink"><%= money(item.line_total_cents) %></p>
              </div>
              <div class="mt-auto flex items-center gap-4">
                <%= form_with url: cart_item_path(item.id), method: :patch, data: { controller: "autosubmit" } do |form| %>
                  <%= render "ui/quantity", name: :quantity, value: item.quantity, min: 0, id: "quantity_#{item.id}", data: { action: "change->autosubmit#submit" } %>
                  <noscript><%= form.button t(".update"), type: "submit", class: button_classes(:secondary, size: :sm) %></noscript>
                <% end %>
                <%= button_to cart_item_path(item.id), method: :delete, class: "grid size-10 place-items-center rounded-lg text-muted transition hover:bg-surface-muted hover:text-ink", aria: { label: "#{t(".remove")} #{item.product.title}" } do %>
                  <%= icon "trash-2", size: 18, stroke: 1.5 %>
                <% end %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>

      <aside class="rounded-xl bg-surface-muted p-5 md:p-7 lg:sticky lg:top-28">
        <% if threshold %>
          <%# The nudge that lifts order value most: how close the cart is to free shipping. %>
          <div class="mb-6">
            <p class="text-sm text-ink">
              <% if (remaining = @cart.free_shipping_remaining_cents) %>
                <%= t(".free_shipping_remaining_html", amount: money(remaining)) %>
              <% else %>
                <%= t(".free_shipping_unlocked") %>
              <% end %>
            </p>
            <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-line" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= [ subtotal * 100 / threshold, 100 ].min %>">
              <div class="h-full rounded-full bg-brand-600 transition-all" style="width: <%= [ subtotal * 100 / threshold, 100 ].min %>%"></div>
            </div>
          </div>
        <% end %>

        <% if (discount = @cart.discount) %>
          <div class="flex items-center gap-3 text-sm">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-canvas px-3 py-1 font-medium ring-1 ring-line"><%= icon "tag", size: 14 %> <%= discount.code %></span>
            <span class="flex-1"><%= discount.free_shipping? ? t(".free_shipping") : "-#{money(discount.amount_cents)}" %></span>
            <%= button_to t(".remove_code"), cart_discount_path, method: :delete, class: "text-muted underline hover:text-ink" %>
          </div>
        <% else %>
          <%= form_with url: cart_discount_path, class: "flex gap-2" do |form| %>
            <%= form.text_field :code, placeholder: t(".discount_code"), autocomplete: "off", autocapitalize: "characters", aria: { label: t(".discount_code") }, class: "h-11 uppercase placeholder:normal-case" %>
            <%= form.button t(".apply"), class: "#{button_classes(:secondary)} h-11 shrink-0" %>
          <% end %>
        <% end %>

        <dl class="mt-6 flex items-baseline justify-between border-t border-line pt-5">
          <dt class="text-ink"><%= t(".subtotal") %></dt>
          <dd class="text-xl text-ink"><%= money(subtotal) %></dd>
        </dl>
        <p class="mt-1 text-sm text-muted"><%= t(".shipping_at_checkout") %></p>
        <%= link_to new_checkout_path, class: "#{button_classes} mt-5 min-h-12 w-full text-base" do %>
          <%= icon "lock", size: 16 %> <%= t(".checkout") %>
        <% end %>
        <ul class="mt-5 space-y-2 text-sm text-muted">
          <li class="flex items-center gap-2"><%= icon "shield-check", size: 16, stroke: 1.5 %> <%= t("products.show.secure_checkout") %></li>
          <% if (estimate = delivery_estimate) %>
            <li class="flex items-center gap-2"><%= icon "truck", size: 16, stroke: 1.5 %> <%= estimate %></li>
          <% end %>
          <% if current_shop.policy?("refund") %>
            <li class="flex items-center gap-2"><%= icon "rotate-ccw", size: 16, stroke: 1.5 %> <%= link_to t("products.show.returns"), policy_path("refund"), class: "underline underline-offset-2 hover:text-ink" %></li>
          <% end %>
        </ul>
      </aside>
    </div>
  <% else %>
    <div class="mx-auto mt-10 max-w-md rounded-xl bg-surface-muted px-6 py-16 text-center">
      <%= icon "shopping-bag", size: 32, stroke: 1.25, class: "mx-auto text-muted" %>
      <p class="mt-4 text-lg text-ink"><%= t(".empty") %></p>
      <%= link_to t(".start_shopping"), products_path, class: "#{button_classes} mt-6 min-h-12 px-8" %>
    </div>
  <% end %>
</div>
