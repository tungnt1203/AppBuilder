<% content_for :title, @collection.title %>

<div class="page-width py-10 md:py-14">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <%= link_to t("products.show.shop"), products_path, class: "inline-flex items-center gap-1 text-xs text-muted hover:text-ink hover:underline" %>
      <h1 class="mt-2 text-3xl md:text-4xl"><%= @collection.title %></h1>
      <p class="mt-2 text-sm text-muted"><%= t("products.index.count", count: @page.total) %></p>
      <% if @collection.description.present? %>
        <div class="mt-3 max-w-2xl text-muted"><%= simple_format @collection.description %></div>
      <% end %>
    </div>
    <% if @page.any? %>
      <%= form_with url: collection_path(@collection), method: :get, data: { controller: "autosubmit", turbo_action: "replace" } do |form| %>
        <%= form.select :sort, ProductsController::SORTS.map { |sort| [ t("products.index.sorts.#{sort}"), sort ] }, { selected: @sort },
              aria: { label: t("products.index.sort") }, class: field_classes, data: { action: "autosubmit#submit" } %>
      <% end %>
    <% end %>
  </div>

  <div class="mt-8">
    <% if @page.any? %>
      <%= render "products/grid", products: @page.records %>
      <%= render "ui/pagination", page: @page %>
    <% else %>
      <p class="rounded-xl border border-dashed border-line px-6 py-16 text-center text-muted"><%= t(".empty") %></p>
    <% end %>
  </div>
</div>
