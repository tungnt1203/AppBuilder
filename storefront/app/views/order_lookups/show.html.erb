<% content_for :title, t(".title") %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>

<div class="mx-auto max-w-3xl px-4 py-12">
  <h1 class="font-display text-3xl font-semibold tracking-tight"><%= t(".title") %></h1>
  <p class="mt-1 text-sm text-muted"><%= t(".intro", email: @lookup.email) %></p>

  <% if @lookup.orders.empty? %>
    <p class="mt-8 text-muted"><%= t(".none") %></p>
  <% else %>
    <ul class="mt-8 space-y-4">
      <% @lookup.orders.each do |order| %>
        <li>
          <%= link_to order_path(order), class: "block rounded-xl border border-line bg-surface p-5 transition hover:border-ink/30" do %>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="font-semibold"><%= order.name %></span>
              <%= order_status_badge order %>
            </div>
            <p class="mt-1 text-sm text-muted">
              <%= local_time(order.placed_at, date_only: true) %> ·
              <%= t(".items", count: order.items.sum(&:quantity)) %> ·
              <%= money(order.total_cents, order.currency) %>
            </p>
            <p class="mt-2 truncate text-sm"><%= order.items.map(&:title).uniq.to_sentence %></p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-brand-600"><%= t(".view") %> <%= icon "arrow-right", size: 16 %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
