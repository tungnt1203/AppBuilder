<% content_for :title, t(".title") %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>

<div class="mx-auto max-w-md px-4 py-12">
  <h1 class="text-3xl"><%= t(".title") %></h1>
  <p class="mt-3 text-muted"><%= t(".intro") %></p>

  <%= form_with url: order_lookups_path, class: "mt-8 space-y-4" do |form| %>
    <div class="space-y-1.5">
      <%= label_tag :email, t(".email") %>
      <%= email_field_tag :email, @email, required: true, autocomplete: "email", autofocus: true, class: field_classes,
            aria: ({ invalid: true, describedby: "email_error" } if @error) %>
      <% if @error %><p id="email_error" class="text-sm text-red-600"><%= t(".email") %> <%= @error %></p><% end %>
    </div>
    <%= form.button class: "w-full #{button_classes}" do %>
      <%= icon "mail", size: 18 %> <%= t(".send") %>
    <% end %>
  <% end %>
</div>
