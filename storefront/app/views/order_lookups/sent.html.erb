<% content_for :title, t(".title") %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>

<div class="mx-auto max-w-md px-4 py-12">
  <%= icon "mail-check", size: 32, class: "text-brand-600" %>
  <h1 class="mt-4 font-display text-3xl font-semibold tracking-tight"><%= t(".title") %></h1>
  <p class="mt-3 text-ink"><%= @email ? t(".body", email: @email) : t(".body_no_email") %></p>
  <p class="mt-3 text-sm text-muted"><%= t(".spam") %></p>
  <p class="mt-8"><%= link_to t(".again"), new_order_lookup_path, class: link_classes %></p>
</div>
