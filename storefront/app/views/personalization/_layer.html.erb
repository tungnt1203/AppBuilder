<%# What the buyer adds, over a product photo where the shop placed it (personalize controller): a
    line of text, or their photo filling the box as they framed it. On the product page it follows
    the field named by key (a sample until they add something); on a cart or order line it carries
    its text, font and color, or its photo and framing. Keep it inside the photo's frame, after the photo. %>
<% photo = layer["kind"] == "photo" %>
<% data = { personalize_target: "layer", box: layer.slice("x", "y", "w", "h").to_json, kind: (photo ? "photo" : "text") } %>
<% data.merge!(font: layer["font"], color: layer["color"]) unless photo %>
<% data.merge!(key: layer["key"], sample: sample, photos: photos.to_json) if local_assigns[:sample] %>
<% data[:text] = layer["text"] if layer["text"] %>
<% data.merge!(photo: layer["photo"], crop: layer["crop"].to_a.join(",")) if layer["photo"] %>
<% if photo %>
  <div class="absolute touch-none overflow-hidden <%= "pointer-events-none" unless local_assigns[:sample] %>" hidden <%= tag.attributes(data: data) %>>
    <img alt="" class="size-full object-cover" draggable="false">
    <span class="absolute inset-0 grid place-items-center border-2 border-dashed border-white/80 bg-black/20 text-center text-xs font-medium text-white" hidden>
      <%= icon "image-plus", size: 20 %>
    </span>
  </div>
<% else %>
  <div class="pointer-events-none absolute flex overflow-hidden" hidden <%= tag.attributes(data: data) %>>
    <span class="w-full self-center leading-none whitespace-nowrap <%= "uppercase" if layer["uppercase"] %>" style="text-align: <%= layer["align"] %>"></span>
  </div>
<% end %>
