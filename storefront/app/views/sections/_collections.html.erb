<%# The shop's collections, four ways, for the composition the draw asks for (STOREFRONT.md).
    Render it from a page with `collections:` (those with products, from the controller), a
    `title` and a `variant`:
    - tiles  a photo for each with its name, three across (two to swipe on phones)
    - index  the names set large in a ruled list with how many products each has
    - bento  the first large, the others beside it in a mixed grid
    - row    small round photos with names, in one row to swipe
    Each is the first product's photo (collection_image). %>
<% variant = local_assigns.fetch(:variant, :tiles).to_s %>
<% title = local_assigns[:title] %>
<% return if collections.blank? %>
<section class="page-width py-12 md:py-20" data-section="collections" data-variant="<%= variant %>">
  <% if title %><h2 class="mb-6 text-2xl text-ink md:mb-8 md:text-[2rem] <%= "md:text-center" if variant == "row" %>"><%= title %></h2><% end %>

  <% case variant %>
  <% when "index" %>
    <ul class="border-t border-line">
      <% collections.each do |collection| %>
        <li class="border-b border-line">
          <%= link_to collection_path(collection), class: "group flex items-center gap-4 py-5 md:gap-6 md:py-7" do %>
            <span class="size-14 shrink-0 overflow-hidden rounded-lg bg-surface-muted md:size-20"><%= collection_image collection, class: "size-full" %></span>
            <span class="min-w-0 flex-1 font-display text-3xl text-ink underline-offset-8 group-hover:underline md:text-5xl"><%= collection.title %></span>
            <span class="shrink-0 text-sm text-muted tabular-nums"><%= t("products.index.count", count: collection.product_count.to_i) %></span>
            <%= icon "arrow-right", size: 20, stroke: 1.5, class: "text-muted transition group-hover:translate-x-1 group-hover:text-ink" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% when "bento" %>
    <%# The first takes half; the rest fill the other half whatever their number (no empty cell). %>
    <% picks = collections.first(5) %>
    <% rest_span = { 1 => "md:col-span-2 md:row-span-2", 2 => "md:row-span-2", 3 => "", 4 => "" }.fetch(picks.size - 1, "") %>
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-4 md:grid-rows-2 md:gap-4">
      <% picks.each_with_index do |collection, index| %>
        <% span = if index.zero? then "col-span-2 md:row-span-2"
                  elsif picks.size == 4 && index == 3 then "col-span-2"
                  else rest_span end %>
        <li class="<%= span %>">
          <%= link_to collection_path(collection), class: "group relative block size-full overflow-hidden rounded-xl bg-surface-muted #{index.zero? ? "aspect-square" : "aspect-4/5 md:aspect-auto md:min-h-48"}" do %>
            <%= collection_image collection, class: "absolute inset-0 size-full" %>
            <span class="absolute inset-x-2 bottom-2 rounded-lg bg-canvas/95 px-3 py-2 text-ink <%= "md:text-xl" if index.zero? %>"><%= collection.title %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% when "row" %>
    <div data-controller="rail">
      <ul class="-mx-4 flex snap-x gap-5 overflow-x-auto px-4 pb-2 [scrollbar-width:none] md:mx-0 md:flex-wrap md:justify-center md:gap-8 md:px-0" data-rail-target="list" data-action="scroll->rail#update">
        <% collections.each do |collection| %>
          <li class="shrink-0 snap-start">
            <%= link_to collection_path(collection), class: "group flex w-24 flex-col items-center gap-2 text-center md:w-32" do %>
              <span class="size-24 overflow-hidden rounded-full bg-surface-muted ring-1 ring-line md:size-32"><%= collection_image collection, class: "size-full" %></span>
              <span class="text-sm text-ink underline-offset-4 group-hover:underline"><%= collection.title %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
      <%= render "ui/rail_controls" %>
    </div>
  <% else %>
    <div data-controller="rail">
      <ul class="-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-3 overflow-x-auto px-4 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-3 md:gap-5 md:overflow-visible md:px-0" data-rail-target="list" data-action="scroll->rail#update">
        <% collections.each do |collection| %>
          <li class="w-[72%] shrink-0 snap-start md:w-auto">
            <%= link_to collection_path(collection), class: "group block" do %>
              <span class="block aspect-4/5 overflow-hidden rounded-xl bg-surface-muted"><%= collection_image collection, class: "size-full" %></span>
              <span class="mt-3 flex items-center gap-1.5 text-lg text-ink group-hover:underline"><%= collection.title %> <%= icon "arrow-right", size: 16, stroke: 1.5 %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
      <%= render "ui/rail_controls" %>
    </div>
  <% end %>
</section>
