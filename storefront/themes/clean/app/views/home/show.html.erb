<%# The home page, as Dawn lays it out: one full-width photo with a short line and a button (until
    the owner picks a photo, the newest products' own photos beside the line), the
    shop's promises, the newest products in a dense grid, the products buyers personalize, the
    collections, and the shop's story beside a photo. The words and photos are theme settings
    (config/theme_settings.yml), so the owner changes them in the admin. Keep it this plain:
    the photos and the products carry the page. %>
<% hero_button = theme_setting(:hero_button).presence || t(".shop_all") %>
<% hero_title = theme_setting(:hero_title).presence || current_shop.name %>
<% hero_text = theme_setting(:hero_text).presence || t(".tagline") %>
<% if (hero_image = theme_setting(:hero_image).presence) %>
  <section class="relative isolate grid min-h-[28rem] place-items-center overflow-hidden bg-ink md:min-h-[45rem]">
    <%= image_tag hero_image, alt: "", class: "photo absolute inset-0 -z-10 size-full object-cover", fetchpriority: "high" %>
    <div class="absolute inset-0 -z-10 bg-black/40"></div>
    <div class="mx-auto max-w-3xl px-6 py-16 text-center text-shadow-photo">
      <h1 class="text-[2.5rem] leading-tight text-balance text-white md:text-[3.25rem]"><%= hero_title %></h1>
      <p class="mt-4 text-white/90"><%= hero_text %></p>
      <%= link_to hero_button, products_path, class: "mt-8 inline-flex min-h-12 items-center px-8 text-[0.9375rem] tracking-[0.06em] text-white ring-1 ring-white transition hover:ring-2" %>
    </div>
  </section>
<% elsif (photos = @products.records.filter_map(&:cover_image).first(3)).size == 3 %>
  <%# No photo of its own yet: the shop's own products beside the line (home/_product_collage). %>
  <section class="page-width grid items-center gap-8 pt-8 pb-12 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-14 md:pt-12 md:pb-20">
    <div class="max-md:order-last max-md:text-center">
      <h1 class="text-[2.5rem] leading-[1.08] text-balance md:text-[3.5rem]"><%= hero_title %></h1>
      <p class="mt-5 max-w-md text-lg leading-relaxed text-muted max-md:mx-auto"><%= hero_text %></p>
      <div class="mt-8 flex flex-wrap gap-3 max-md:justify-center">
        <%= link_to hero_button, products_path, class: "#{button_classes} min-h-12 px-8 text-[0.9375rem]" %>
        <% if (first = @collections.first) %>
          <%= link_to first.title, collection_path(first), class: "#{button_classes(:secondary)} min-h-12 px-8 text-[0.9375rem]" %>
        <% end %>
      </div>
    </div>
    <%= render "home/product_collage", photos:, class: "aspect-[6/5]" %>
  </section>
<% else %>
  <section class="mx-auto max-w-3xl px-6 pt-14 pb-12 text-center md:pt-20 md:pb-16">
    <h1 class="text-[2.5rem] leading-tight text-balance md:text-[3.25rem]"><%= hero_title %></h1>
    <p class="mt-4 text-muted"><%= hero_text %></p>
    <%= link_to hero_button, products_path, class: "#{button_classes} mt-8 min-h-12 px-8 text-[0.9375rem]" %>
  </section>
<% end %>

<%= render "home/benefits" if theme_setting(:show_benefits) %>

<section class="page-width pt-12 md:pt-20">
  <div class="flex items-end justify-between gap-4">
    <h2 class="text-2xl md:text-[2rem]"><%= t(".new_arrivals") %></h2>
    <% if @products.any? %>
      <%= link_to products_path, class: "inline-flex shrink-0 items-center gap-1.5 text-sm text-ink underline-offset-4 hover:underline" do %>
        <%= t(".view_all") %> <%= icon "arrow-right", size: 16, stroke: 1.5 %>
      <% end %>
    <% end %>
  </div>
  <div class="mt-6 md:mt-8">
    <% if @products.any? %>
      <div class="grid grid-cols-2 gap-x-2 gap-y-8 md:grid-cols-4 md:gap-x-4 md:gap-y-12">
        <%= render partial: "products/product", collection: @new_arrivals %>
      </div>
      <div class="mt-10 text-center md:hidden">
        <%= link_to t(".view_all"), products_path, class: "#{button_classes(:secondary)} min-h-12 w-full text-[0.9375rem]" %>
      </div>
    <% else %>
      <%= render "products/coming_soon" %>
    <% end %>
  </div>
</section>

<%= render "blocks/personalized", products: @personalized if @personalized.any? %>

<% if @collections.any? %>
  <section class="page-width pt-16 md:pt-24">
    <h2 class="text-2xl md:text-[2rem]"><%= t(".collections") %></h2>
    <%# On phones a row to swipe (the next tile peeking in), so no count leaves a tile on its own. %>
    <ul class="-mx-4 mt-6 flex snap-x snap-mandatory scroll-px-4 gap-2 overflow-x-auto px-4 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0">
      <% @collections.each do |collection| %>
        <li class="w-[72%] shrink-0 snap-start md:w-auto">
          <%= link_to collection_path(collection), class: "group block" do %>
            <span class="relative block aspect-[4/5] overflow-hidden rounded-xl bg-surface-muted">
              <%= collection_image collection, class: "size-full" %>
              <span class="absolute inset-x-3 bottom-3 flex items-center justify-between gap-3 rounded-lg bg-canvas/95 px-4 py-3 text-ink shadow-sm backdrop-blur">
                <span class="min-w-0 truncate"><%= collection.title %></span>
                <%= icon "arrow-right", size: 16, stroke: 1.5, class: "transition group-hover:translate-x-0.5" %>
              </span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if (story_image = theme_setting(:story_image).presence) %>
  <section class="page-width max-md:px-0 mt-16 grid md:mt-24 md:grid-cols-2">
    <%= image_tag story_image, alt: "", loading: "lazy", class: "photo aspect-[4/3] size-full bg-surface-muted object-cover md:aspect-auto md:min-h-[30rem]" %>
    <div class="flex flex-col justify-center bg-surface-muted px-6 py-12 md:px-14">
      <h2 class="text-3xl leading-tight text-balance md:text-[2.5rem]"><%= theme_setting(:story_title) %></h2>
      <% if (story_text = theme_setting(:story_text).presence) %>
        <p class="mt-4 leading-relaxed text-muted"><%= story_text %></p>
      <% end %>
      <%= link_to hero_button, products_path, class: "mt-8 inline-flex min-h-12 w-fit items-center px-8 text-[0.9375rem] tracking-[0.06em] text-ink ring-1 ring-ink transition hover:ring-2" %>
    </div>
  </section>
<% end %>
