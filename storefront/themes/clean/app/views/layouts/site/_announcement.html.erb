<%# A line across the top of every page, written by the owner in the shop's settings: free
    shipping over $50, a code for a first order, a sale's last day. Small and quiet, as on Dawn. %>
<% if (announcement = current_shop.announcement.presence) %>
  <div class="border-b border-line bg-canvas px-4 py-2.5 text-center text-[0.8125rem] text-ink"><%= announcement %></div>
<% end %>
