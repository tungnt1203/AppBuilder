<%# The site's footer, as Ride has it: on the dark canvas, the shop's name big, then plain columns
    of links (the collections, help with the policies and contact page, the owner's "footer"
    menu) and the social pages. Keep the links to the policies and the contact page: payment
    providers and ad networks check that they're there. %>
<% socials = { "Instagram" => theme_setting(:instagram_url), "TikTok" => theme_setting(:tiktok_url), "Facebook" => theme_setting(:facebook_url) }.compact_blank %>
<% footer_menu = shop_menu(:footer) %>
<% heading = "text-sm font-semibold tracking-[0.04em] text-ink uppercase" %>
<footer class="mt-20 border-t border-line bg-canvas md:mt-28">
  <div class="page-width py-14 md:py-20">
    <p class="font-display text-4xl text-ink uppercase md:text-6xl"><%= current_shop.name %></p>
    <% if (tagline = theme_setting(:hero_text).presence) %>
      <p class="mt-4 max-w-md leading-relaxed text-muted"><%= tagline %></p>
    <% end %>

    <div class="mt-12 grid gap-10 text-sm sm:grid-cols-2 md:grid-cols-4">
      <nav aria-label="<%= t("layouts.site.shop") %>">
        <p class="<%= heading %>"><%= t("layouts.site.shop") %></p>
        <ul class="mt-4 space-y-2.5 text-muted">
          <li><%= link_to t("layouts.site.shop_all"), products_path, class: "hover:text-ink" %></li>
          <% collections.select { |collection| collection.product_count.to_i.positive? }.first(5).each do |collection| %>
            <li><%= link_to collection.title, collection_path(collection), class: "hover:text-ink" %></li>
          <% end %>
        </ul>
      </nav>

      <nav aria-label="<%= t("layouts.site.footer_navigation") %>">
        <p class="<%= heading %>"><%= t("layouts.site.help") %></p>
        <ul class="mt-4 space-y-2.5 text-muted">
          <li><%= link_to t("order_lookups.new.title"), new_order_lookup_path, class: "hover:text-ink" %></li>
          <li><%= link_to t("contacts.show.title"), contact_path, class: "hover:text-ink" %></li>
          <% current_shop.policies.each do |policy| %>
            <li><%= link_to policy["title"], policy_path(policy["id"]), class: "hover:text-ink" %></li>
          <% end %>
        </ul>
      </nav>

      <% if footer_menu&.items.present? %>
        <nav aria-label="<%= footer_menu.title %>">
          <p class="<%= heading %>"><%= footer_menu.title %></p>
          <ul class="mt-4 space-y-2.5 text-muted">
            <% footer_menu.items.each do |item| %>
              <li><%= shop_menu_link item, class: "hover:text-ink" %></li>
            <% end %>
          </ul>
        </nav>
      <% end %>

      <% if socials.any? %>
        <div>
          <p class="<%= heading %>"><%= t("layouts.site.follow") %></p>
          <ul class="mt-4 space-y-2.5 text-muted">
            <% socials.each do |name, url| %>
              <li><%= link_to name, url, class: "hover:text-ink", target: "_blank", rel: "noopener" %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
  <div class="border-t border-line">
    <p class="page-width py-6 text-xs text-muted">© <%= Date.current.year %> <%= current_shop.name %></p>
  </div>
</footer>
