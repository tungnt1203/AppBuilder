<%# A product in a grid, as Ride has it: a tall photo (its second photo on hover, when it has
    one), small badges at its bottom left (sold out, how much a sale saves, "Personalize" when the
    buyer adds their name or photo), the title in the headings' uppercase and the price under it
    ("From" when variants cost differently, the "was" price struck through before it). %>
<% low, high, was = product.min_price_cents, product.max_price_cents, product.compare_at_cents %>
<% saves = ((was - low) * 100.0 / was).round if was && low && was > low %>
<%= link_to product_path(product), class: "group block" do %>
  <div class="relative aspect-4/5 overflow-hidden rounded-xl bg-surface-muted">
    <%= product_image product, size: :card, class: "size-full transition duration-500 group-hover:scale-[1.04]" %>
    <% if product.second_image %>
      <%= product_image product, size: :card, image: product.second_image, alt: "",
            class: "absolute inset-0 size-full opacity-0 transition duration-500 group-hover:opacity-100 max-md:hidden" %>
    <% end %>
    <div class="absolute bottom-2.5 left-2.5 flex flex-wrap gap-1.5 md:bottom-3 md:left-3">
      <% if !product.available? %>
        <span class="rounded-full bg-canvas px-3 py-1 text-xs font-semibold text-ink ring-1 ring-line"><%= t("products.product.sold_out") %></span>
      <% elsif saves&.positive? %>
        <span class="rounded-full bg-ink px-3 py-1 text-xs font-semibold text-canvas"><%= t("products.product.saves", percent: saves) %></span>
      <% end %>
      <% if product.personalized? %>
        <span class="rounded-full bg-brand-600 px-3 py-1 text-xs font-semibold text-on-brand"><%= t("products.product.personalize") %></span>
      <% end %>
    </div>
  </div>
  <h3 class="mt-4 text-lg leading-tight text-ink"><%= product.title %></h3>
  <%# Real buyers' stars only, from the shop's reviews. %>
  <% if (rating = product.rating) %>
    <p class="mt-1 flex items-center gap-1.5 text-xs text-muted"><%= rating_stars rating.average, size: 12 %> <span>(<%= rating.count %>)</span></p>
  <% end %>
  <p class="mt-1.5 flex flex-wrap items-baseline gap-x-3 text-base text-ink">
    <% if saves&.positive? %><s class="text-sm text-muted"><%= money(was) %></s><% end %>
    <span><%= low == high ? money(low) : t("products.product.from", price: money(low)) %></span>
  </p>
<% end %>
