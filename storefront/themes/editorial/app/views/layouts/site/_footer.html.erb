<%# The site's footer, as Craft has it: on the deep color, plain columns of links (the
    collections, help with the policies and contact page, the owner's "footer" menu), a line
    about the shop and its social pages. Keep the links to the policies and the contact page:
    payment providers and ad networks check that they're there. %>
<% socials = { "Instagram" => theme_setting(:instagram_url), "TikTok" => theme_setting(:tiktok_url), "Facebook" => theme_setting(:facebook_url) }.compact_blank %>
<% footer_menu = shop_menu(:footer) %>
<% link = "text-on-brand/75 hover:text-on-brand hover:underline" %>
<footer class="mt-20 bg-brand-600 text-on-brand md:mt-28">
  <div class="mx-auto grid max-w-[1200px] gap-10 px-4 py-14 text-sm sm:grid-cols-2 md:grid-cols-4 md:px-10 md:py-16 xl:px-0">
    <nav aria-label="<%= t("layouts.site.shop") %>">
      <p class="font-display text-lg font-light"><%= t("layouts.site.shop") %></p>
      <ul class="mt-4 space-y-2.5">
        <li><%= link_to t("layouts.site.shop_all"), products_path, class: link %></li>
        <% collections.select { |collection| collection.product_count.to_i.positive? }.first(5).each do |collection| %>
          <li><%= link_to collection.title, collection_path(collection), class: link %></li>
        <% end %>
      </ul>
    </nav>

    <nav aria-label="<%= t("layouts.site.footer_navigation") %>">
      <p class="font-display text-lg font-light"><%= t("layouts.site.help") %></p>
      <ul class="mt-4 space-y-2.5">
        <li><%= link_to t("order_lookups.new.title"), new_order_lookup_path, class: link %></li>
        <li><%= link_to t("contacts.show.title"), contact_path, class: link %></li>
        <% current_shop.policies.each do |policy| %>
          <li><%= link_to policy["title"], policy_path(policy["id"]), class: link %></li>
        <% end %>
      </ul>
    </nav>

    <% if footer_menu&.items.present? %>
      <nav aria-label="<%= footer_menu.title %>">
        <p class="font-display text-lg font-light"><%= footer_menu.title %></p>
        <ul class="mt-4 space-y-2.5">
          <% footer_menu.items.each do |item| %>
            <li><%= shop_menu_link item, class: link %></li>
          <% end %>
        </ul>
      </nav>
    <% end %>

    <div class="<%= "md:col-span-2" unless footer_menu&.items.present? %>">
      <p class="font-display text-lg font-light"><%= current_shop.name %></p>
      <% if (tagline = theme_setting(:hero_text).presence) %>
        <p class="mt-4 max-w-sm leading-relaxed text-on-brand/75"><%= tagline %></p>
      <% end %>
      <% if socials.any? %>
        <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2" aria-label="<%= t("layouts.site.follow") %>">
          <% socials.each do |name, url| %>
            <li><%= link_to name, url, class: "underline underline-offset-4 hover:no-underline", target: "_blank", rel: "noopener" %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
  <div class="border-t border-on-brand/15">
    <p class="mx-auto max-w-[1200px] px-4 py-6 text-xs text-on-brand/60 md:px-10 xl:px-0">© <%= Date.current.year %>, <%= current_shop.name %></p>
  </div>
</footer>
