<%# The site's header, as Craft has it: search on the left, the logo (a theme setting the owner
    uploads) or the name in the serif, centered and large, the cart on the right, and the
    collections in a centered row under them. On phones: the menu button, the name in the middle,
    search and the cart. Pages can add links with content_for :site_nav, or show only the logo and the cart
    with content_for :focused (checkout: nothing to wander off to). %>
<% menu_items = shop_menu(:header)&.items.to_a %>
<% shop_collections = collections.select { |collection| collection.product_count.to_i.positive? }.first(6) %>
<% nav_link = "py-1 text-sm whitespace-nowrap text-muted underline-offset-4 hover:text-ink hover:underline aria-[current=page]:text-ink aria-[current=page]:underline" %>
<header class="sticky top-0 z-20 bg-canvas md:static">
  <div class="page-width grid h-16 grid-cols-[1fr_auto_1fr] items-center md:h-auto md:pt-8 md:pb-4">
    <div class="flex items-center">
      <% unless content_for?(:focused) %>
      <div class="md:hidden" data-controller="menu" data-action="click@window->menu#close keydown@window->menu#escape turbo:before-cache@document->menu#hide">
        <button type="button" class="group -ml-2 grid size-10 place-items-center text-ink" data-menu-target="button" data-action="menu#toggle" aria-expanded="false" aria-label="<%= t("ui.menu") %>">
          <%= icon "menu", size: 22, stroke: 1.5, class: "group-aria-expanded:hidden" %>
          <%= icon "x", size: 22, stroke: 1.5, class: "hidden group-aria-expanded:block" %>
        </button>
        <nav data-menu-target="panel" class="absolute inset-x-0 top-full hidden max-h-[calc(100svh-4rem)] overflow-y-auto border-y border-line bg-canvas px-4 pt-2 pb-6" aria-label="<%= t("ui.navigation") %>">
          <ul>
            <li><%= link_to t("layouts.site.shop_all"), products_path, class: "block py-3 font-display text-xl text-ink" %></li>
            <% shop_collections.each do |collection| %>
              <li><%= link_to collection.title, collection_path(collection), class: "block py-3 font-display text-xl text-ink" %></li>
            <% end %>
            <% menu_items.each do |item| %>
              <li><%= shop_menu_link item, class: "block py-3 font-display text-xl text-ink" %></li>
            <% end %>
          </ul>
        </nav>
      </div>
      <%= link_to products_path, class: "-ml-2 hidden size-10 place-items-center text-ink md:grid", aria: { label: t("products.index.search") } do %>
        <%= icon "search", size: 22, stroke: 1.5 %>
      <% end %>
      <% end %>
    </div>

    <%= link_to root_path, class: "flex min-w-0 justify-center text-ink" do %>
      <% if (logo = theme_setting(:logo).presence) %>
        <%= image_tag logo, alt: current_shop.name, class: "h-9 w-auto max-w-48 object-contain md:h-20" %>
      <% else %>
        <%# A long name wraps onto two balanced lines rather than losing its end. %>
        <span class="line-clamp-2 text-center font-display text-xl leading-tight font-light text-balance md:text-4xl <%= "max-md:text-base" if current_shop.name.length > 20 %>"><%= current_shop.name %></span>
      <% end %>
    <% end %>

    <div class="flex items-center justify-end">
      <% unless content_for?(:focused) %>
        <%= link_to products_path, class: "grid size-10 place-items-center text-ink md:hidden", aria: { label: t("products.index.search") } do %>
          <%= icon "search", size: 22, stroke: 1.5 %>
        <% end %>
      <% end %>
      <%= link_to cart_path, class: "relative -mr-2 grid size-10 place-items-center text-ink", id: "cart-link", aria: { label: t("layouts.site.cart_with_count", count: cart_item_count) } do %>
        <%= icon "shopping-bag", size: 22, stroke: 1.5 %>
        <% if cart_item_count.positive? %>
          <span class="absolute right-0 bottom-0.5 grid min-w-[1.125rem] place-items-center rounded-full bg-brand-600 px-1 text-[0.625rem] leading-[1.125rem] text-on-brand"><%= cart_item_count %></span>
        <% end %>
      <% end %>
    </div>
  </div>

  <% unless content_for?(:focused) %>
  <nav class="page-width hidden flex-wrap items-center justify-center gap-x-6 gap-y-1 pb-6 md:flex" aria-label="<%= t("ui.navigation") %>">
    <% shop_collections.each do |collection| %>
      <%= link_to collection.title, collection_path(collection), class: nav_link, aria: { current: ("page" if current_page?(collection_path(collection))) } %>
    <% end %>
    <%= link_to t("layouts.site.shop_all"), products_path, class: nav_link, aria: { current: ("page" if current_page?(products_path)) } %>
    <% menu_items.each do |item| %>
      <%= shop_menu_link item, class: nav_link %>
    <% end %>
    <%= yield :site_nav %>
  </nav>
  <% end %>
</header>
