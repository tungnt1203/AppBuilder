<%# A line across the top of every page, written by the owner in the shop's settings: free
    shipping over $50, a code for a first order, a sale's last day. On Sense it sits on the pale
    gradient. %>
<% if (announcement = current_shop.announcement.presence) %>
  <div class="soft-gradient px-4 py-2.5 text-center text-sm font-medium text-ink"><%= announcement %></div>
<% end %>
