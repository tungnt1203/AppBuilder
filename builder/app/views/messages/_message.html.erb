<% case message.role %>
<% when "user" %>
  <% if (attachments = Attachment.for(message)).any? %>
    <ul class="sent-attachments" aria-label="Attached files">
      <% attachments.each do |attachment| %>
        <li>
          <%= link_to project_attachment_path(message.project, message_id: message.id, name: attachment.name), target: "_blank", title: attachment.name do %>
            <% if attachment.image? %>
              <%= image_tag project_attachment_path(message.project, message_id: message.id, name: attachment.name), alt: attachment.name, loading: "lazy" %>
            <% else %>
              <span class="attachment-file"><%= icon :file, size: 14 %><span class="truncate"><%= attachment.name %></span></span>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <% if message.data["pointed"] %>
    <% pointed = PointedElement.new(message.data["pointed"]) %>
    <p class="pointed-note" title="<%= pointed.data["selector"] %>"><%= icon :target, size: 12 %><span class="truncate">“<%= pointed.label %>”</span><span class="faint">on <%= pointed.page %></span></p>
  <% end %>
  <% if message.body.present? %>
    <div class="bubble-user" data-controller="clamp">
      <div class="bubble-text" data-clamp-target="text"><%= message.body %></div>
      <button type="button" class="bubble-more" data-clamp-target="toggle" data-action="clamp#toggle" hidden>Show more</button>
    </div>
  <% end %>
<% when "assistant" %>
  <% if message.body.present? %>
    <div class="reply<%= " reply-interim trail-item" if local_assigns[:interim] %>"><%= markdown(message.body) %></div>
    <% unless local_assigns[:interim] %>
      <div class="reply-actions" data-controller="copy" data-copy-text-value="<%= message.body %>">
        <button type="button" class="reply-action" data-action="copy#copy" aria-label="Copy reply" title="Copy">
          <span class="when-idle"><%= icon :copy, size: 15 %></span><span class="when-copied"><%= icon :check, size: 15 %></span>
        </button>
      </div>
    <% end %>
  <% end %>
  <% if message.data["plan_card"].present? %>
    <%= render "messages/plan_card", plan: message.data["plan_card"], project: message.project %>
  <% end %>
  <% if message.data["questions"].present? && message == message.project.open_reply %>
    <%= render "messages/questions", message: message %>
  <% elsif message.data["proposal"] && message == message.project.latest_proposal %>
    <div class="proposal">
      <%= button_to message.project.approval_message, project_build_path(message.project), disabled: !message.project.accepts_messages?, class: "btn btn-primary" %>
      <span class="faint text-xs">or ask for changes below</span>
    </div>
  <% elsif message.data["next_steps"].present? && message == message.project.open_reply %>
    <%= render "messages/next_steps", steps: message.data["next_steps"] %>
  <% end %>
<% when "plan" %>
  <%= render "messages/plan", tasks: message.data["tasks"] if message.data["tasks"].present? %>
<% when "action" %>
  <p class="turn-done"><%= message.body %></p>
<% when "notice" %>
  <% if (look = message.data["look"]) %>
    <%= render "messages/look", look:, project: message.project %>
  <% else %>
    <div class="notice reply"><%= markdown(message.body) %></div>
  <% end %>
  <%= render "messages/version", message: message %>
<% when "result" %>
  <div class="turn-done"><%= turn_summary(message) %> <%= render "messages/version", message: message %></div>
<% when "error" %>
  <pre class="alert"><%= message.body %></pre>
  <%= render "messages/version", message: message %>
<% end %>
