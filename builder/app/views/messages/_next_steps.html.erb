<%# What the agent suggests asking for next. Choosing one puts it in the message box to send or change. %>
<div class="next-steps" data-controller="next-step">
  <p class="faint text-xs">Next, you could ask for</p>
  <% steps.each do |step| %>
    <button type="button" class="suggestion" data-action="next-step#use"><%= icon :pencil, size: 14 %><span><%= step %></span></button>
  <% end %>
</div>
