<%= t(".heading", name: @order.shipping_name.to_s.split.first) %>

<%= t(".intro") %>

<% @order.line_items.each do |item| %>
<%= item.quantity %> × <%= [ item.product_title, item.variant_title ].compact.join(" – ") %>
<% end %>

<%= t(".finish", total: money(@order.total_cents, @order.currency)) %>: <%= @order.storefront_url %>
<% if @store.contact_email.present? %>

<%= t(".questions", email: @store.contact_email) %>
<% end %>
