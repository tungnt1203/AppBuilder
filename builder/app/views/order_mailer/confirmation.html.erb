<h1><%= t(".heading", name: @order.shipping_name) %></h1>
<p><%= t(".intro", number: @order.name) %></p>

<%= render "order_mailer/summary", order: @order %>

<% if @order.pending? && !@order.card? %>
  <h2><%= t(".payment") %></h2>
  <%= @store.payment_instructions.present? ? simple_format(@store.payment_instructions) : tag.p(t(".payment_by_email")) %>
<% end %>

<p><%= email_button t(".view"), @order.storefront_url %></p>
