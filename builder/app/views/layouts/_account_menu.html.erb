<%# Who is signed in, with the way out; administrators also reach the accounts page. %>
<% user = Current.user %>
<details class="relative" data-controller="keep-open" data-keep-open-dismissible-value="true">
  <summary class="account-button on-glass glass capsule" aria-label="Account" title="<%= user.name %>">
    <%= user.name.first.upcase %>
  </summary>
  <div class="popover glass glass-frost absolute top-12 right-0 z-30 w-60 rounded-[20px] p-1.5" role="menu">
    <div class="px-3 pt-2 pb-2.5">
      <p class="truncate text-sm font-semibold"><%= user.name %></p>
      <p class="faint truncate text-[0.8125rem]"><%= user.email_address %></p>
    </div>
    <% if user.administrator? %>
      <%= link_to admin_users_path, class: "menu-item", role: "menuitem" do %><%= icon :users %> Accounts<% end %>
    <% end %>
    <%= button_to session_path, method: :delete, class: "menu-item", role: "menuitem", form: { class: "contents" } do %>
      <%= icon :logout %> Sign out
    <% end %>
  </div>
</details>
