<!DOCTYPE html>
<%# Every email: a white card on a light page, the shop's name at the top (the app's for staff
    emails), and a line on replying at the bottom. Styles inline or in the head: clients drop the rest. %>
<% brand = @brand || ActsAsTenant.current_tenant&.name %>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
      body { margin: 0; padding: 0; background: #f4f4f5; }
      .card h1 { margin: 0 0 12px; font-size: 22px; line-height: 1.3; color: #111827; }
      .card h2 { margin: 28px 0 8px; font-size: 16px; color: #111827; }
      .card p, .card li, .card td { font-size: 15px; line-height: 1.55; color: #374151; }
      .card small { font-size: 13px; color: #6b7280; }
      .card a { color: #111827; }
    </style>
  </head>
  <body style="margin: 0; padding: 0; background: #f4f4f5;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background: #f4f4f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;">
      <tr>
        <td align="center" style="padding: 32px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px;">
            <% if brand %>
              <tr><td style="padding: 0 4px 16px; font-size: 18px; font-weight: 700; color: #111827;"><%= brand %></td></tr>
            <% end %>
            <tr>
              <td class="card" style="background: #ffffff; border-radius: 12px; padding: 32px 28px; border: 1px solid #e5e7eb;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td style="padding: 16px 4px; font-size: 12px; line-height: 1.5; color: #9ca3af;">
                <%= t("mailer.footer", app: brand || t("mailer.app")) %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
