<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ content_for(:title), "Studio" ].compact.join(" – ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Studio">
    <meta name="theme-color" content="#0e3b43">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_refresh_method_tag :morph %>
    <%= turbo_refresh_scroll_tag :preserve %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <script>
      if (navigator.userAgentData?.brands?.some(({ brand }) => brand === "Chromium")) document.documentElement.classList.add("lens")
    </script>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="glass">
    <%= render "layouts/lens" %>
    <div class="backdrop" data-turbo-permanent id="backdrop"></div>
    <%= yield %>
  </body>
</html>
