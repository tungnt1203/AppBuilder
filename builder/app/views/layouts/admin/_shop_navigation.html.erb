<%# The picked shop's screens (ShopAdminHelper#admin_screens), then its storefront. %>
<% admin_screens.each do |label, path, icon_name, match| %>
  <% active = match ? request.path.start_with?(match) : current_page?(path) %>
  <%= link_to path, class: "admin-link", "aria-current": (active ? "page" : nil) do %><%= icon icon_name, size: 17 %> <%= label %><% end %>
<% end %>
<%= link_to storefront_url, class: "admin-link", target: "_blank", rel: "noopener" do %><%= icon :external, size: 17 %> <%= t("shop_admin.layout.view_site") %><% end %>
