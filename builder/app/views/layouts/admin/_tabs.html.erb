<%# On a phone, what an owner opens most, always at the thumb: the dashboard, orders, customers
    and products. The rest is under Menu. %>
<% base = shop_admin_root_path %>
<nav class="admin-tabs" aria-label="<%= t("shop_admin.layout.shortcuts") %>">
  <% [ [ t("shop_admin.layout.dashboard"), base, :history, nil ],
       [ t("shop_admin.layout.orders"), shop_admin_orders_path, "package", "#{base}/orders" ],
       [ t("shop_admin.layout.customers"), shop_admin_customers_path, "users", "#{base}/customers" ],
       [ t("shop_admin.layout.products"), shop_admin_products_path, "shirt", "#{base}/products" ] ].each do |label, path, icon_name, match| %>
    <% active = match ? request.path.start_with?(match) : current_page?(path) %>
    <%= link_to path, class: "admin-tab", "aria-current": (active ? "page" : nil) do %><%= icon icon_name, size: 20 %><span><%= label %></span><% end %>
  <% end %>
</nav>
