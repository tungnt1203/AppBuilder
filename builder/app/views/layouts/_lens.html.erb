<%# Refraction for glass: a soft displacement field bends the backdrop like a lens.
    Only Chromium renders url() in backdrop-filter, so .lens is added there only. %>
<svg aria-hidden="true" width="0" height="0" style="position:absolute">
  <filter id="lens" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.006 0.009" numOctaves="2" seed="11" result="noise" />
    <feGaussianBlur in="noise" stdDeviation="3" result="field" />
    <feDisplacementMap in="SourceGraphic" in2="field" scale="28" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>
