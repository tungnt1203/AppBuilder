<%# The look: the Hallmark material the agent chose, then the four layouts; switching a layout
    replaces the header, footer, home page and product card and keeps the material. %>
<% material = @themes.material %>
<section class="design-group" aria-labelledby="design_theme">
  <% if @themes.trying? %>
    <%# Trying a look on: nothing is saved until Keep. %>
    <div class="look-trying" role="status">
      <p class="text-sm"><span class="font-semibold">Trying <%= material&.name || @themes.trying.titleize %> on.</span> <span class="faint">It isn't saved or published until you keep it.</span></p>
      <div class="mt-2 flex flex-wrap gap-2">
        <%= button_to "Keep it", keep_look_project_design_path(@project), class: "btn btn-primary h-8 px-3 text-sm", disabled: !@project.accepts_messages? %>
        <%= button_to "Go back", revert_look_project_design_path(@project), class: "btn btn-ghost h-8 px-3 text-sm" %>
      </div>
    </div>
  <% end %>
  <% if material %>
    <h2 class="design-heading">Look</h2>
    <div class="look-card" aria-current="true">
      <%= image_tag look_project_design_path(@project, material.slug), alt: "", class: "look-picture", loading: "lazy" %>
      <div class="min-w-0">
        <p class="font-semibold"><%= material.name %> <span class="faint text-xs font-normal">in use</span></p>
        <p class="faint line-clamp-3 text-xs"><%= material.summary.upcase_first %>.</p>
      </div>
    </div>
    <% if (looks = @themes.other_looks).any? %>
      <p class="faint mt-4 mb-2 text-xs">Other looks Hallmark picked for this shop. Try one on in seconds, free; the agent can then rebuild the shop in it, keeping everything you asked for.</p>
      <ul class="look-grid">
        <% looks.each do |look| %>
          <li class="look-card look-card-small">
            <%= image_tag look_project_design_path(@project, look["slug"]), alt: "", class: "look-picture", loading: "lazy" %>
            <p class="font-semibold"><%= look["name"] %></p>
            <p class="faint line-clamp-3 text-xs" title="<%= look["summary"].upcase_first %>"><%= look["summary"].upcase_first %>.</p>
            <%= button_to "Try it on", try_look_project_design_path(@project, look["slug"]), class: "btn btn-primary h-8 w-full text-xs",
                  disabled: !@project.accepts_messages?, title: "See the shop in it now, free; keep it or go back" %>
            <%= form_with model: [ @project, Message.new ], data: { turbo_frame: "_top" } do |form| %>
              <%= form.hidden_field :body, id: nil, value: "Switch the shop's look to Hallmark's #{look["name"]} material (bin/theme material #{look["slug"]}). Keep the layout, the words and everything I asked for, and update DESIGN.md." %>
              <%= hidden_field_tag "message[plan]", "0", id: nil %>
              <%= form.button "Have the agent rebuild in it", class: "btn btn-ghost h-7 w-full text-[0.6875rem]", disabled: !@project.accepts_messages? %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <div class="mb-4"></div>
  <% end %>
  <h2 id="design_theme" class="design-heading">Layout</h2>
  <% if local_assigns[:notice] %><p class="flash" role="status"><%= notice %></p><% end %>
  <% if @theme_error %>
    <p class="alert" role="alert"><%= @theme_error %></p>
  <% elsif @theme_conflict %>
    <div class="design-conflict" role="alert">
      <p>Switching to <%= @theme_conflict[:name].capitalize %> replaces these, which were changed for this shop:</p>
      <ul class="mt-1 list-disc pl-5 font-mono text-xs"><% @theme_conflict[:files].each do |path| %><li><%= path %></li><% end %></ul>
      <p class="mt-1">History keeps them, so you can go back.</p>
      <%= button_to "Switch anyway", theme_project_design_path(@project), params: { theme: @theme_conflict[:name], force: "1" },
            class: "btn btn-ghost mt-2", form: { class: "inline" } %>
    </div>
  <% end %>
  <ul class="design-themes">
    <% @themes.themes.each do |theme| %>
      <li class="design-theme" <%= "aria-current=true" if theme.current %>>
        <div class="min-w-0 flex-1">
          <p class="font-semibold"><%= theme.name.capitalize %></p>
          <p class="faint line-clamp-2 text-xs"><%= theme.summary %></p>
        </div>
        <% if theme.current %>
          <span class="faint text-right text-xs"><%= theme.changed ? safe_join([ "In use,", tag.br, "changed for this shop" ]) : "In use" %></span>
        <% else %>
          <%= button_to "Use", theme_project_design_path(@project), params: { theme: theme.name }, class: "btn btn-ghost h-8 px-3 text-sm",
                disabled: !@project.accepts_messages?, form: { data: { turbo_confirm: material ? "Switch to the #{theme.name.capitalize} layout? Its header, footer, home page and product card replace this shop's; the #{material.name} look stays. You can go back from History." : "Switch to #{theme.name.capitalize}? Its header, footer, home page, product card, colors and fonts replace this shop's. You can go back from History." } } %>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
