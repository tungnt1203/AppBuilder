<%# The Design tab's contents, in place of the chat: the theme, then colors, fonts and shape
    (tried on in the preview as the owner goes, kept as a version on Save), then words and photos
    (the shop's theme settings). Each part saves on its own. %>
<div class="design-body">
  <%= render "projects/designs/themes", notice: (notice if local_assigns[:section] == :theme) if @themes.available? %>
  <% if @design.available? %>
    <%= render "projects/designs/look", notice: (notice if local_assigns[:section] == :look) %>
  <% else %>
    <p class="muted text-sm">This app was made before themes, so its colors and fonts can only be changed by asking in the chat.</p>
  <% end %>
  <%= render "projects/designs/content", notice: (notice if local_assigns[:section] == :content) if @content.available? %>
</div>
