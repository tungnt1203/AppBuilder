<%# Colors, fonts and shape: each change is tried on in the preview (design controller → the
    template's preview probe) and kept as a version on Save. %>
<%= form_with model: @design, scope: :design, url: project_design_path(@project), method: :patch, class: "design-group",
      data: { controller: "design", design_settings_value: @design.preview_settings.to_json, action: "input->design#preview change->design#preview" } do |form| %>
  <% if local_assigns[:notice] %><p class="flash" role="status"><%= notice %></p><% end %>
  <% if @design.errors.any? %>
    <p class="alert" role="alert"><%= @design.errors.full_messages.to_sentence %></p>
  <% end %>

  <fieldset class="design-group">
    <legend class="design-heading">Colors</legend>
    <% { brand: "Buttons and links", background: "Background", text: "Text", accent: "Second color" }.each do |key, label| %>
      <label class="design-row">
        <span><%= label %></span>
        <span class="design-color">
          <%= form.color_field key, data: { design_target: "color" } %>
          <output class="faint tabular-nums" data-design-target="hex"><%= @design.public_send(key) %></output>
        </span>
      </label>
    <% end %>
    <p class="design-warning" data-design-target="warning" hidden></p>
  </fieldset>

  <fieldset class="design-group">
    <legend class="design-heading">Fonts</legend>
    <label class="design-row"><span>Headings</span><%= form.select :heading_font, @design.fonts, {}, class: "field h-9 w-44 py-0 text-sm" %></label>
    <label class="design-row"><span>Text</span><%= form.select :text_font, @design.fonts, {}, class: "field h-9 w-44 py-0 text-sm" %></label>
  </fieldset>

  <fieldset class="design-group">
    <legend class="design-heading">Shape</legend>
    <div class="design-row">
      <span id="corners_label">Corners</span>
      <div class="segmented" role="radiogroup" aria-labelledby="corners_label">
        <% ProjectDesign::CORNERS.each_key do |corners| %>
          <label class="design-choice"><%= form.radio_button :corners, corners %><span><%= corners.capitalize %></span></label>
        <% end %>
      </div>
    </div>
    <div class="design-row">
      <span id="width_label">Page width</span>
      <div class="segmented" role="radiogroup" aria-labelledby="width_label">
        <% ProjectDesign::WIDTHS.each_key do |width| %>
          <label class="design-choice"><%= form.radio_button :width, width %><span><%= width.capitalize %></span></label>
        <% end %>
      </div>
    </div>
  </fieldset>

  <p class="faint text-xs">Changes show in the preview as you make them. Save keeps them as a version; the agent works from them next time.</p>
  <div class="design-actions">
    <button type="button" class="btn btn-ghost" data-action="design#discard">Discard</button>
    <%= form.button "Save", class: "btn btn-primary ml-auto", disabled: !@project.accepts_messages?,
          title: (@project.accepts_messages? ? nil : "Wait until the current step finishes") %>
  </div>
<% end %>
