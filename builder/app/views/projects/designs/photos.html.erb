<% if @page > 1 %>
  <%= turbo_frame_tag "photos_#{@key}_page_#{@page}", class: "contents" do %>
    <%= render "projects/designs/photo_page" %>
  <% end %>
<% else %>
  <turbo-frame id="photos_<%= @key %>">
    <% if @search_error %>
      <p class="design-warning"><%= @search_error %></p>
    <% elsif @photos.empty? %>
      <p class="faint text-xs"><%= @query.present? ? "No photos for “#{@query}”. Try other words, in English." : "Type what the photo should show, in English." %></p>
    <% else %>
      <ul class="design-photos"><%= render "projects/designs/photo_page" %></ul>
      <p class="faint text-xs">Free photos from <%= StockPhotos.source %>; each is credited in the app. Pick one to use it.</p>
    <% end %>
  </turbo-frame>
<% end %>
