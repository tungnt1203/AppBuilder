<%# The app itself, and a screen over it whenever it isn't ready to look at. The stage is
    never morphed (see preview_controller.js), so page refreshes don't reload the app. %>
<% state = project.preview_state %>
<section class="bezel relative min-h-[70vh] lg:min-h-0" aria-label="Preview" data-preview-target="bezel">
  <div id="preview" class="stage" data-preview-target="stage" data-loading>
    <iframe src="<%= project.preview_url %>" title="Preview of <%= project.name %>"
            data-preview-target="frame" data-action="load->preview#loaded"
            onload="this.parentElement.removeAttribute('data-loading')"><%# a first load can beat the controller %></iframe>
    <div class="veil" aria-hidden="true"><span class="spinner"></span></div>

    <%# Errors the app reports while the owner tries it (the template's preview probe), filled in by preview_controller.js. %>
    <div class="preview-error glass glass-frost" role="alert" hidden data-preview-target="errorBox">
      <span class="stage-icon stage-icon-danger"><%= icon :alert, size: 18 %></span>
      <div class="min-w-0 flex-1">
        <p class="text-sm font-semibold"><span data-preview-target="errorTitle"></span> <span class="faint font-normal" data-preview-target="errorPage"></span></p>
        <p class="error-message" data-preview-target="errorMessage"></p>
      </div>
      <%= form_with model: [ project, Message.new ], class: "flex-none", data: { action: "submit->preview#errorSent" } do |form| %>
        <%= form.hidden_field :body, id: nil, data: { preview_target: "errorRequest" } %>
        <%= hidden_field_tag "message[plan]", "0", id: nil %>
        <%= form.button "Fix this error", class: "btn btn-primary h-8 px-3.5 text-[0.8125rem]", data: { preview_target: "errorFix" } %>
      <% end %>
      <button type="button" class="btn btn-ghost btn-icon h-8 w-8 flex-none" data-action="preview#dismissErrors" aria-label="Dismiss" title="Dismiss">&times;</button>
    </div>
  </div>

  <%# The Code tab, over the app. Loaded when first shown (preview_controller.js) and left out of page refreshes like the stage;
      it reloads when the preview restarts on new code. %>
  <div class="code-pane">
    <%= turbo_frame_tag "code", data: { preview_target: "code", src: project_code_path(project) } do %>
      <div class="grid h-full place-items-center"><span class="spinner"></span></div>
    <% end %>
  </div>

  <%# Only in full screen, where the header is out of sight. %>
  <div class="fullscreen-bar glass capsule">
    <%= render "projects/devices" %>
    <button type="button" class="btn btn-ghost h-7 px-3 text-xs" data-action="preview#toggleFullscreen"><%= icon :shrink, size: 14 %>Exit full screen</button>
  </div>

  <% case state %>
  <% when "setup" %>
    <div class="stage-screen" role="status">
      <div class="stage-card">
        <span class="spinner spinner-lg"></span>
        <% if project.name_pending? %>
          <h2>Thinking of a name</h2>
          <p>From your description. You can rename the app later from its card.</p>
        <% else %>
          <h2>Setting up <%= project.name %></h2>
          <p>Copying the starter app, installing gems and preparing the database. This takes about a minute.</p>
        <% end %>
      </div>
    </div>
  <% when "blank" %>
    <% step, status = blank_preview_status(project) %>
    <div class="stage-screen stage-blank" role="status">
      <div class="blank">
        <div class="blank-sketch" aria-hidden="true">
          <span class="sk-bar"></span>
          <span class="sk-hero"></span>
          <span class="sk-card"></span><span class="sk-card"></span><span class="sk-card"></span>
        </div>
        <h2 class="blank-title"><%= project.name %></h2>
        <ol class="blank-steps">
          <% [ "Describe", "Plan", "Build" ].each_with_index do |label, index| %>
            <li class="<%= index < step ? "done" : ("current" if index == step) %>"><%= label %></li>
          <% end %>
        </ol>
        <% if project.working? %>
          <p class="blank-status"><span class="activity-dot"></span><span class="live-activity"><%= project.activity || "Planning" %></span></p>
        <% end %>
        <p class="blank-hint"><%= status %></p>
        <button type="button" class="btn btn-ghost on-card" data-action="preview#peek"><%= icon :eye %>See the starter app</button>
      </div>
    </div>
    <div class="peek-pill glass capsule" role="status">
      <span>The starter app, before anything is built</span>
      <button type="button" class="btn btn-ghost h-7 px-3 text-xs" data-action="preview#unpeek"><%= icon :eye_off, size: 14 %>Hide</button>
    </div>
  <% when "building" %>
    <%# The first build has no earlier version worth showing through. %>
    <div class="stage-screen <%= "stage-screen-clear" if project.built? %>" role="status">
      <div class="stage-card">
        <span class="spinner spinner-lg"></span>
        <h2>Building your changes</h2>
        <p class="live-activity"><%= project.activity || "Working" %></p>
        <p class="faint">The preview comes back when this step is done. Until then the app may be halfway through a change.</p>
        <button type="button" class="btn btn-ghost on-card" data-action="preview#peek"><%= icon :eye %>Look at it anyway</button>
      </div>
    </div>
    <div class="peek-pill glass capsule" role="status">
      <span class="activity-dot"></span>
      <span>Still building, so this may look broken</span>
      <button type="button" class="btn btn-ghost h-7 px-3 text-xs" data-action="preview#unpeek"><%= icon :eye_off, size: 14 %>Hide</button>
    </div>
  <% when "starting" %>
    <div class="stage-screen" role="status">
      <div class="stage-card">
        <span class="spinner spinner-lg"></span>
        <h2>Starting the preview</h2>
        <p>Running any new migrations and booting the app.</p>
      </div>
    </div>
  <% when "broken" %>
    <div class="stage-screen" role="alert">
      <div class="stage-card stage-card-wide">
        <span class="stage-icon stage-icon-danger"><%= icon :alert, size: 22 %></span>
        <h2>The preview has a problem</h2>
        <p>The app didn't open. The agent can usually fix this on its own.</p>
        <pre class="alert text-left"><%= project.preview_error %></pre>
        <div class="flex flex-wrap items-center justify-center gap-2">
          <%= form_with model: [ project, Message.new ] do |form| %>
            <%= form.hidden_field :body, value: fix_request(project) %>
            <%= hidden_field_tag "message[plan]", "0", id: nil %>
            <%= form.button "Ask the agent to fix it", class: "btn btn-primary", disabled: !project.accepts_messages? %>
          <% end %>
          <%= button_to "Try again", project_preview_path(project), class: "btn btn-ghost on-card", disabled: !project.accepts_messages? %>
          <button type="button" class="btn btn-ghost on-card" data-action="preview#peek"><%= icon :eye %>Show the page</button>
        </div>
      </div>
    </div>
    <div class="peek-pill glass capsule" role="status">
      <span class="stage-dot-danger"></span>
      <span>The preview has a problem</span>
      <button type="button" class="btn btn-ghost h-7 px-3 text-xs" data-action="preview#unpeek">Details</button>
    </div>
  <% end %>
</section>
