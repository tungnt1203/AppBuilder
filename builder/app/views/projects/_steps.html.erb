<details class="steps" <%= "open" if open %>>
  <summary><%= icon :steps, size: 14 %><span><%= steps_summary(actions) %></span><%= icon :chevron, size: 14 %></summary>
  <ol>
    <% actions.each do |action| %>
      <li title="<%= action.body %>"><%= action.body %></li>
    <% end %>
  </ol>
</details>
