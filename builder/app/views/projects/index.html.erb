<% content_for :title, "Apps" %>
<%= @everyone ? turbo_stream_from(:projects) : turbo_stream_from(Current.user, :projects) %>

<div class="home">
  <header class="home-bar">
    <%= link_to "Studio", root_path, class: "wordmark" %>
    <div class="flex items-center gap-2">
      <%= render "layouts/theme_toggle", class: "btn btn-ghost btn-icon on-glass glass capsule" %>
      <%= render "layouts/account_menu" %>
    </div>
  </header>

  <main class="flex flex-col gap-16 pb-20">
    <section class="home-start" data-controller="suggestion">
      <div class="home-intro">
        <h1 class="home-title">What do you want to build?</h1>
        <p class="mt-4 max-w-80 text-[0.9375rem] leading-relaxed muted">Describe it in your own words. It's built while you watch, and it runs on your own server.</p>
      </div>

      <div class="min-w-0">
        <%= form_with model: @project, class: "prompt glass glass-frost sheet",
              data: { controller: "composer attachments", action: "keydown->composer#submitOnShortcut dragover->attachments#dragOver dragleave->attachments#dragLeave drop->attachments#drop" } do |form| %>
          <% if @project.errors.any? %>
            <p class="alert mx-5 mt-5"><%= @project.errors.full_messages.to_sentence %></p>
          <% elsif Current.user.over_budget? %>
            <p class="flash mx-5 mt-5"><%= Current.user.budget_message %></p>
          <% elsif Current.user.app_limit_reached? %>
            <p class="flash mx-5 mt-5">You have <%= pluralize(Current.user.app_limit, "app") %>, as many as an account can have. Delete one to build another.</p>
          <% end %>

          <%= text_area_tag "project[request]", params.dig(:project, :request), id: "project_request", rows: 4, autofocus: true,
                "aria-label": "What the app should do",
                placeholder: "A print-on-demand shop for funny retro cat T-shirts and hoodies, sizes S to 3XL. Paste a link or a screenshot of a site you like.",
                data: { suggestion_target: "request", composer_target: "input", attachments_target: "body", action: "input->composer#resize paste->attachments#paste" },
                class: "prompt-input" %>
          <ul class="attachment-list prompt-attachments" data-attachments-target="list" hidden></ul>

          <div class="prompt-tools">
            <%= form.file_field :files, multiple: true, accept: "image/png,image/jpeg,image/gif,image/webp,image/svg+xml,application/pdf,text/plain,text/csv",
                  hidden: true, data: { attachments_target: "input", action: "change->attachments#add" } %>
            <button type="button" class="btn btn-ghost btn-icon h-9 w-9" data-action="attachments#pick"
                    aria-label="Attach files" title="Attach a logo, photos, a sketch or a screenshot of a site you like… or paste one"><%= icon :paperclip, size: 18 %></button>
            <%= form.text_field :name, placeholder: "Name (optional)", "aria-label": "App name, or leave it empty to have one suggested",
                  data: { suggestion_target: "name" }, class: "field order-first h-9 w-auto min-w-0 flex-1 basis-full py-0 text-sm sm:order-none sm:max-w-56 sm:basis-0" %>
            <%= form.select :language, Project::LANGUAGES.map { |code, info| [ info[:name], code ] }, {},
                  "aria-label": "The language you chat in (apps are in English)", class: "field h-9 w-auto py-0 text-sm" %>
            <label class="plan-toggle" title="Show me a plan first, and ask me if anything is unclear">
              <%= hidden_field_tag "project[plan]", "0", id: nil %>
              <%= check_box_tag "project[plan]", "1", params.dig(:project, :plan) == "1", id: "project_plan" %>
              Plan first
            </label>
            <%= form.button class: "btn btn-primary ml-auto h-9 px-4", title: "Build app (⌘↵)", disabled: Current.user.app_limit_reached? || Current.user.over_budget? do %>
              Build <%= icon :send, size: 15 %>
            <% end %>
          </div>
        <% end %>

        <p id="ideas_label" class="mt-8 mb-3 text-sm muted">Or start from one of these:</p>
        <ul class="starters" aria-labelledby="ideas_label">
          <% suggestions.each do |idea| %>
            <li>
              <button type="button" class="idea starter" title="<%= idea[:request] %>"
                      data-action="suggestion#use" data-suggestion-name-param="<%= idea[:name] %>" data-suggestion-request-param="<%= idea[:request] %>">
                <span class="starter-name"><%= idea[:name] %></span>
                <span class="starter-request"><%= idea[:request] %></span>
              </button>
            </li>
          <% end %>
        </ul>

        <%# Looks: Hallmark materials to start the shop in. The radios belong to the form above (form=). %>
        <p id="looks_label" class="mt-8 mb-3 text-sm muted">Pick a look, or let it be chosen for your shop:</p>
        <ul class="looks" aria-labelledby="looks_label">
          <li>
            <label class="look-pick look-pick-auto">
              <input type="radio" name="project[look]" value="" form="new_project" class="sr-only" checked>
              <span class="look-pick-art" aria-hidden="true"><%= icon "sparkles", size: 22, stroke: 1.5 %></span>
              <span class="look-pick-name">Chosen for you</span>
            </label>
          </li>
          <% HallmarkLook.all.each do |look| %>
            <li>
              <label class="look-pick" title="<%= look.material.upcase_first %>">
                <input type="radio" name="project[look]" value="<%= look.slug %>" form="new_project" class="sr-only">
                <%= image_tag look_path(look), alt: "", loading: "lazy", class: "look-pick-art" %>
                <span class="look-pick-name"><%= look.name %></span>
              </label>
            </li>
          <% end %>
        </ul>
      </div>
    </section>

    <% if @projects.any? || @everyone %>
      <section class="home-apps" aria-labelledby="apps_heading">
        <div class="mb-5 flex flex-wrap items-center gap-x-5 gap-y-3">
          <h2 id="apps_heading" class="on-glass flex items-baseline gap-2 text-xl font-semibold">
            <%= @everyone ? "All apps" : "Your apps" %> <span class="text-sm font-medium tabular-nums faint"><%= @projects.size %></span>
          </h2>
          <% if Current.user.monthly_budget && !@everyone %>
            <% spent = Current.user.spent_this_month %>
            <div class="budget" title="What the agent cost for your apps this month, and your monthly budget">
              <span class="muted text-sm tabular-nums"><%= number_to_currency(spent) %> of <%= number_to_currency(Current.user.monthly_budget, precision: 0) %> this month</span>
              <meter class="budget-meter" min="0" max="<%= Current.user.monthly_budget %>" high="<%= Current.user.monthly_budget * 0.8 %>" value="<%= spent %>"></meter>
            </div>
          <% end %>
          <% if Current.user.administrator? %>
            <nav class="page-switch glass capsule ml-auto" aria-label="Whose apps">
              <%= link_to "Mine", root_path, "aria-current": (@everyone ? nil : "page") %>
              <%= link_to "Everyone's", root_path(apps: "all"), "aria-current": (@everyone ? "page" : nil) %>
            </nav>
          <% end %>
        </div>

        <ul class="app-grid">
          <% @projects.each do |project| %>
            <%= render "projects/card", project: project, everyone: @everyone %>
          <% end %>
        </ul>
      </section>
    <% end %>
  </main>
</div>
