<% content_for :title, "Apps" %>

<main class="mx-auto flex min-h-full max-w-3xl flex-col gap-6 px-4 py-16 sm:py-24">
  <%= form_with model: @project, class: "glass glass-frost sheet p-6 sm:p-8" do |form| %>
    <h1 class="text-[1.75rem] leading-tight font-semibold tracking-[-0.02em]">Describe the app you need</h1>
    <p class="muted mt-1.5 text-[0.9375rem]">It's built while you watch, and you run it on your own server.</p>

    <% if @project.errors.any? %>
      <p class="alert mt-5"><%= @project.errors.full_messages.to_sentence %></p>
    <% end %>

    <%= text_area_tag "project[request]", params.dig(:project, :request), id: "project_request", rows: 5, autofocus: true,
          "aria-label": "What the app should do",
          placeholder: "Lễ tân quản lý bệnh nhân và đặt lịch hẹn với bác sĩ. Màn hình chính là lịch hẹn hôm nay.",
          class: "field mt-6 resize-none text-base leading-relaxed" %>

    <div class="mt-4 grid gap-3 sm:grid-cols-[1fr_auto_auto]">
      <%= form.text_field :name, required: true, placeholder: "App name", "aria-label": "App name", class: "field" %>
      <%= form.select :language, Project::LANGUAGES.map { |code, info| [ info[:name], code ] }, {}, "aria-label": "Language of the app", class: "field sm:w-40" %>
      <%= form.button "Build app", class: "btn btn-primary h-11 px-6 sm:h-auto" %>
    </div>

    <label class="muted mt-4 flex items-center gap-2 text-sm">
      <%= hidden_field_tag "project[plan]", "0", id: nil %>
      <%= check_box_tag "project[plan]", "1", true, id: "project_plan", class: "size-4 accent-[var(--color-jade)]" %>
      Show me a plan first, and ask me if anything is unclear
    </label>
  <% end %>

  <% if @projects.any? %>
    <section class="glass sheet overflow-hidden" aria-label="Your apps">
      <ul class="divide-y divide-white/30">
        <% @projects.each do |project| %>
          <li>
            <%= link_to project, class: "flex items-center gap-4 px-6 py-4 text-white transition-colors hover:bg-white/10" do %>
              <span class="min-w-0 flex-1">
                <span class="block truncate font-semibold"><%= project.name %></span>
                <span class="block text-sm text-white/65">
                  <% if live = project.live_deployment %>
                    Live at <%= project.publish_host %>, version <%= live.version %>
                  <% else %>
                    Not published yet
                  <% end %>
                </span>
              </span>
              <span class="chip rounded-full px-3 py-1"><%= status_label(project) %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</main>
