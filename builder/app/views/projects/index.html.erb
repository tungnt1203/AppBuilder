<% content_for :title, "Apps" %>
<%= @everyone ? turbo_stream_from(:projects) : turbo_stream_from(Current.user, :projects) %>

<div class="fixed top-4 right-4 z-30 flex items-center gap-2">
  <%= render "layouts/theme_toggle", class: "btn btn-ghost btn-icon on-glass glass capsule" %>
  <%= render "layouts/account_menu" %>
</div>

<main class="mx-auto flex min-h-full max-w-6xl flex-col gap-14 px-4 pt-[12vh] pb-16 sm:px-6">
  <section class="mx-auto w-full max-w-3xl" data-controller="suggestion">
    <h1 class="on-glass text-center text-[2rem] leading-tight font-semibold tracking-[-0.025em] text-balance sm:text-[2.75rem]">What do you want to build?</h1>
    <p class="mt-3 text-center text-[0.9375rem] text-white/75">Describe it in your own words. It's built while you watch, and it runs on your own server.</p>

    <%= form_with model: @project, class: "prompt glass glass-frost sheet mt-8",
          data: { controller: "composer", action: "keydown->composer#submitOnShortcut" } do |form| %>
      <% if @project.errors.any? %>
        <p class="alert mx-5 mt-5"><%= @project.errors.full_messages.to_sentence %></p>
      <% elsif Current.user.over_budget? %>
        <p class="flash mx-5 mt-5"><%= Current.user.budget_message %></p>
      <% elsif Current.user.app_limit_reached? %>
        <p class="flash mx-5 mt-5">You have <%= pluralize(Current.user.app_limit, "app") %>, as many as an account can have. Delete one to build another.</p>
      <% end %>

      <%= text_area_tag "project[request]", params.dig(:project, :request), id: "project_request", rows: 3, autofocus: true,
            "aria-label": "What the app should do",
            placeholder: "Lễ tân quản lý bệnh nhân và đặt lịch hẹn với bác sĩ. Màn hình chính là lịch hẹn hôm nay.",
            data: { suggestion_target: "request", composer_target: "input", action: "input->composer#resize" },
            class: "prompt-input" %>

      <div class="flex flex-wrap items-center gap-2 border-t border-[var(--line)] px-3 py-3">
        <%= form.text_field :name, placeholder: "Name (optional)", "aria-label": "App name, or leave it empty to have one suggested",
              data: { suggestion_target: "name" }, class: "field h-9 w-auto min-w-0 flex-1 py-0 text-sm sm:max-w-56" %>
        <%= form.select :language, Project::LANGUAGES.map { |code, info| [ info[:name], code ] }, {},
              "aria-label": "The language you chat in (apps are in English)", class: "field h-9 w-auto py-0 text-sm" %>
        <label class="plan-toggle" title="Show me a plan first, and ask me if anything is unclear">
          <%= hidden_field_tag "project[plan]", "0", id: nil %>
          <%= check_box_tag "project[plan]", "1", params.dig(:project, :plan) == "1", id: "project_plan" %>
          Plan first
        </label>
        <%= form.button class: "btn btn-primary ml-auto h-9 px-4", title: "Build app (⌘↵)", disabled: Current.user.app_limit_reached? || Current.user.over_budget? do %>
          Build <%= icon :send, size: 15 %>
        <% end %>
      </div>
    <% end %>

    <ul class="mt-5 flex flex-wrap justify-center gap-2" aria-label="Ideas to start from">
      <% suggestions.each do |idea| %>
        <li>
          <button type="button" class="idea glass capsule" title="<%= idea[:request] %>"
                  data-action="suggestion#use" data-suggestion-name-param="<%= idea[:name] %>" data-suggestion-request-param="<%= idea[:request] %>">
            <%= idea[:name] %>
          </button>
        </li>
      <% end %>
    </ul>
  </section>

  <% if @projects.any? || @everyone %>
    <section aria-labelledby="apps_heading">
      <div class="mb-4 flex items-center gap-3 px-1">
        <h2 id="apps_heading" class="on-glass flex items-baseline gap-2 text-lg font-semibold">
          <%= @everyone ? "All apps" : "Your apps" %> <span class="text-sm font-medium text-white/60"><%= @projects.size %></span>
        </h2>
        <% if Current.user.monthly_budget && !@everyone %>
          <span class="text-sm text-white/70" title="What the agent cost for your apps this month, and your monthly budget">
            <%= number_to_currency(Current.user.spent_this_month) %> of <%= number_to_currency(Current.user.monthly_budget, precision: 0) %> this month
          </span>
        <% end %>
        <% if Current.user.administrator? %>
          <nav class="page-switch glass capsule ml-auto" aria-label="Whose apps">
            <%= link_to "Mine", root_path, "aria-current": (@everyone ? nil : "page") %>
            <%= link_to "Everyone's", root_path(apps: "all"), "aria-current": (@everyone ? "page" : nil) %>
          </nav>
        <% end %>
      </div>

      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% @projects.each do |project| %>
          <%= render "projects/card", project: project, everyone: @everyone %>
        <% end %>
      </ul>
    </section>
  <% end %>
</main>
