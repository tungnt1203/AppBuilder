<% if deployment.in_progress? %>
  <span class="status status-working pr-1 text-white/90"><%= deployment.building? ? "Building" : "Deploying" %> version <%= deployment.version %></span>
<% elsif deployment.live? %>
  <%= link_to project.publish_url, target: "_blank", class: "btn btn-ghost h-8 gap-1.5 px-3 text-white", title: "Open the published app" do %>
    <span class="size-2 rounded-full bg-[#7ff0c9] shadow-[0_0_10px_#7ff0c9]"></span>Version <%= deployment.version %> is live<%= icon :external, size: 14 %>
  <% end %>
<% else %>
  <details class="relative">
    <summary class="btn btn-ghost h-8 list-none px-3 text-[#ffd2c4]">Version <%= deployment.version %> failed</summary>
    <div class="glass glass-frost absolute right-0 z-10 mt-2 w-[min(34rem,90vw)] rounded-[20px] p-4">
      <p class="mb-2 text-sm font-medium">
        <% if live = project.live_deployment %>
          Version <%= live.version %> is still running at <%= link_to project.publish_host, project.publish_url, target: "_blank", class: "underline" %>.
        <% else %>
          Nothing was published. Fix the problem below and publish again.
        <% end %>
      </p>
      <pre class="max-h-80 overflow-auto rounded-xl bg-white/60 p-3 font-mono text-xs whitespace-pre-wrap text-ink/80"><%= deployment.log %></pre>
    </div>
  </details>
<% end %>
