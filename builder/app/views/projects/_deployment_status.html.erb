<% if deployment.in_progress? %>
  <span class="flex items-center gap-1.5 text-gray-600">
    <span class="size-2 animate-pulse rounded-full bg-indigo-500"></span>
    <%= deployment.building? ? "Building" : "Deploying" %> v<%= deployment.version %>…
  </span>
<% elsif deployment.live? %>
  <%= link_to "v#{deployment.version} live ↗", project.publish_url, target: "_blank", class: "font-medium text-green-700 hover:underline" %>
<% else %>
  <details class="relative">
    <summary class="cursor-pointer list-none font-medium text-red-700">Publish v<%= deployment.version %> failed</summary>
    <div class="absolute right-0 z-10 mt-2 w-[32rem] rounded-lg border border-gray-200 bg-white p-3 shadow-lg">
      <% if live = project.live_deployment %>
        <p class="mb-2 text-xs text-gray-600">v<%= live.version %> is still live at <%= link_to project.publish_url, project.publish_url, target: "_blank", class: "underline" %>.</p>
      <% end %>
      <pre class="max-h-80 overflow-auto text-xs whitespace-pre-wrap text-gray-700"><%= deployment.log %></pre>
    </div>
  </details>
<% end %>
