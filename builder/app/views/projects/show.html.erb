<% content_for :title, @project.name %>
<%= turbo_stream_from @project %>

<%# Two panels edge to edge on wide screens (chat, then the app), each with its own slim bar,
    so the preview gets as much of the window as it can. On phones they stack. %>
<div class="studio" data-controller="preview tour"
     data-tour-auto-value="<%= !Current.user.toured_at? %>" data-tour-seen-url-value="<%= tour_path %>"
     data-preview-version-value="<%= @project.preview_version %>" data-preview-state-value="<%= @project.preview_state %>"
     data-preview-accepts-value="<%= @project.accepts_messages? || @project.accepts_messages_while_working? %>">
    <aside class="studio-panel studio-chat" aria-label="Chat" data-preview-target="chat">
      <%# Narrow (the chat column on a laptop, a phone), the tour and theme buttons and the long
          labels make way, so the status never runs over the buttons. %>
      <header class="studio-bar @container">
        <%= link_to root_path, class: "btn btn-ghost btn-icon h-8 w-8", "aria-label": "All apps", title: "All apps" do %><%= icon :back %><% end %>
        <%# The app shows its own name in the preview; the bar says what's going on and which chat this is,
            and the chat's name opens the others. %>
        <h1 class="sr-only"><%= @project.name %></h1>
        <div class="flex min-w-0 flex-1 items-center gap-1">
          <span class="chip inline-flex shrink-0 rounded-md px-2 py-1 text-xs" title="<%= strip_tags(status_label(@project)) %>"><%= status_label(@project) %></span>
          <details class="relative min-w-0" data-controller="keep-open" data-keep-open-dismissible-value="true" id="chats">
            <summary class="chat-title" title="Chats" aria-label="Chats: <%= @project.chat.display_title %>">
              <%= icon :branch, size: 13, class: "fork-mark" if @project.chat.forked_from_id %><span class="truncate"><%= @project.chat.display_title %></span><%= icon :chevron, size: 14 %>
            </summary>
            <div class="popover glass glass-frost fixed inset-x-3 top-16 z-30 rounded-xl p-1.5 sm:absolute sm:inset-x-auto sm:top-auto sm:left-0 sm:mt-2 sm:w-[24rem]">
              <%= render "projects/chats", project: @project %>
            </div>
          </details>
        </div>
        <% new_chat_off = @project.busy? ? "Wait until the agent finishes" : nil %>
        <%# Narrow, "New chat" stays in the chats menu (the chat's name) and the name gets the room. %>
        <%= button_to project_chats_path(@project), class: "btn btn-ghost btn-icon h-8 w-8", form_class: "@max-[30rem]:hidden", disabled: new_chat_off.present?,
              title: new_chat_off || "New chat", "aria-label": "New chat" do %><%= icon :compose %><% end %>
        <button type="button" class="btn btn-ghost btn-icon h-8 w-8 @max-[30rem]:hidden" data-action="tour#start" aria-label="Show the tour" title="Show the tour"><%= icon :help %></button>
        <%= render "layouts/theme_toggle", class: "btn btn-ghost btn-icon h-8 w-8 @max-[30rem]:hidden" %>
        <details class="relative" data-controller="keep-open" data-keep-open-dismissible-value="true" id="history">
          <summary class="btn btn-ghost btn-icon h-8 w-8 list-none" title="Version history" aria-label="Version history"
                   data-tour-step="6" data-tour-title="Nothing is lost"
                   data-tour-text="Every change is saved as a version. Open this to go back to any of them."><%= icon :history %></summary>
          <div class="popover glass glass-frost fixed inset-x-3 top-16 z-30 rounded-xl p-2 sm:absolute sm:inset-x-auto sm:top-auto sm:right-0 sm:mt-2 sm:w-[26rem] lg:right-auto lg:left-0">
            <div id="versions"><%= render "projects/versions", project: @project %></div>
          </div>
        </details>
        <details class="relative" data-controller="keep-open" data-keep-open-dismissible-value="true" id="instructions">
          <summary class="btn btn-ghost btn-icon h-8 w-8 list-none" title="Instructions for the agent" aria-label="Instructions for the agent"><%= icon :sliders %></summary>
          <div class="popover glass glass-frost fixed inset-x-3 top-16 z-30 rounded-xl p-4 sm:absolute sm:inset-x-auto sm:top-auto sm:right-0 sm:mt-2 sm:w-[26rem] lg:right-auto lg:left-0">
            <%= render "projects/instructions", project: @project %>
          </div>
        </details>
        <details class="relative" data-controller="keep-open" data-keep-open-dismissible-value="true" id="share">
          <summary class="btn btn-ghost btn-icon h-8 w-8 list-none" title="Share" aria-label="Share"
                   data-tour-step="7" data-tour-title="See it on your phone"
                   data-tour-text="Make a preview link here: it comes with a QR code, so you can open the shop on your phone the way buyers from ads will."><%= icon :share %></summary>
          <div class="popover glass glass-frost fixed inset-x-3 top-16 z-30 rounded-xl p-4 sm:absolute sm:inset-x-auto sm:top-auto sm:right-0 sm:mt-2 sm:w-[24rem] lg:right-auto lg:left-0">
            <%= render "projects/share", project: @project %>
          </div>
        </details>
        <% if deployment = @project.latest_deployment %>
          <%= render "projects/deployment_status", project: @project, deployment: deployment %>
        <% end %>
        <%= button_to "Publish", project_deployments_path(@project), disabled: !@project.publishable?, class: "btn btn-primary h-8 px-3.5",
              title: publish_hint(@project),
              form: { data: { tour_step: 8, tour_title: "Put it online",
                              tour_text: "Once the first build is done, Publish gives your app its own address. Publish again whenever you want the latest changes live." } } %>
      </header>

      <%# The Design tab takes the chat's place, loaded the first time it's opened. %>
      <turbo-frame id="design" class="design-frame" data-preview-target="design" data-src="<%= project_design_path(@project) %>"
                   data-action="turbo:submit-end->preview#designed" hidden></turbo-frame>

      <div id="messages" class="thread min-h-0 flex-1 overflow-y-auto" data-controller="autoscroll">
        <% items = chat_items(@project.messages) %>
        <% if items.empty? && @project.chats.many? %>
          <div class="chat-empty">
            <p class="chat-empty-title">New chat</p>
            <p class="muted">The agent starts fresh and catches up from the app's code. Your app, its versions and settings stay as they are.</p>
          </div>
        <% end %>
        <% items.each_with_index do |item, index| %>
          <% if item.is_a?(Array) %>
            <%= render "projects/steps", actions: item, open: @project.working? && index == items.size - 1 %>
          <% else %>
            <%# A reply followed by more steps is the agent thinking aloud, not its answer. %>
            <%= render item, interim: items[index + 1].is_a?(Array) %>
          <% end %>
        <% end %>

        <div id="draft" class="reply draft" data-turbo-permanent></div>
        <button type="button" class="jump-latest" data-autoscroll-target="jump" data-action="autoscroll#jump" aria-label="Go to the newest message" title="Go to the newest message" hidden><%= icon :down, size: 16 %></button>
      </div>

      <%# In the flow under the chat: as the message grows, the chat above gets shorter instead of hidden. %>
      <div class="composer-dock">
        <% if @project.accepts_messages? && @project.built? %>
          <%= render "projects/update", project: @project %>
        <% end %>
        <% if @project.setting_up? || @project.working? %>
          <div class="activity"
               data-controller="elapsed" data-elapsed-since-value="<%= (@project.working_since || @project.updated_at).to_i %>" aria-live="polite">
            <span id="activity-text" class="live-activity min-w-0 flex-1 truncate"><%= @project.setting_up? ? "Setting up the project" : (@project.activity || "Working") %></span>
            <span class="faint tabular-nums" data-elapsed-target="clock"></span>
          </div>
          <%= turbo_frame_tag "worker-check", src: project_worker_check_path(@project), data: { controller: "poll" } %>
        <% end %>

        <%= form_with model: [ @project, Message.new ], data: { empty: "", controller: "composer attachments", action: "dragover->attachments#dragOver dragleave->attachments#dragLeave drop->attachments#drop" } do |form| %>
          <ul class="attachment-list" data-attachments-target="list" hidden></ul>
          <div class="pointed-chip glass" data-preview-target="pointedChip" hidden>
            <%= icon :target, size: 14 %>
            <span class="min-w-0 flex-1 truncate" data-preview-target="pointedLabel"></span>
            <button type="button" class="btn btn-ghost btn-icon h-6 w-6" data-action="preview#clearPick" aria-label="Forget the part you pointed at">&times;</button>
          </div>
          <%= hidden_field_tag "message[pointed]", "", id: nil, data: { preview_target: "pointed" } %>
          <% can_send = @project.accepts_messages? || @project.accepts_messages_while_working? %>
          <div class="composer glass" data-tour-step="1" data-tour-title="Ask in your own words"
               data-tour-text="Describe what you want: a new page, other colors, a size chart. The agent builds it while you watch, and you can keep chatting to change anything.">
            <%= form.text_area :body, rows: 1, disabled: !can_send, required: true, "aria-label": "Ask for a change",
                  placeholder: @project.accepts_messages? ? "Ask for a change" : (can_send ? "Add to the request while it works" : "Wait for the current step to finish"),
                  data: { action: "keydown->composer#submitOnShortcut input->composer#resize paste->attachments#paste", composer_target: "input", attachments_target: "body" },
                  class: "composer-input" %>
            <div class="composer-actions">
              <%= hidden_field_tag "message[plan]", "0", id: nil %>
              <%= form.file_field :files, multiple: true, accept: "image/png,image/jpeg,image/gif,image/webp,image/svg+xml,application/pdf,text/plain,text/csv",
                    hidden: true, disabled: !can_send, data: { attachments_target: "input", action: "change->attachments#add" } %>
              <button type="button" class="btn btn-ghost btn-icon h-8 w-8" data-action="attachments#pick" <%= "disabled" unless can_send %>
                      data-tour-step="2" data-tour-title="Show, don't just tell"
                      data-tour-text="Attach your logo, photos or a menu as a PDF. You can also paste a screenshot straight into the message."
                      aria-label="Attach files" title="Attach a logo, photos, a menu (PDF)… or paste a screenshot"><%= icon :paperclip, size: 18 %></button>
              <label class="plan-toggle" title="The agent proposes a plan first and builds it when you approve">
                <%= check_box_tag "message[plan]", "1", @project.plans_by_default?, id: "message_plan", disabled: !@project.accepts_messages? %>
                <span>Plan first</span>
              </label>
              <span class="composer-hint">⌘↵</span>
              <%# While the agent works, Send turns into Stop until there's something to send. %>
              <% if @project.working? && !@project.chore_running? %>
                <%= form.button type: "submit", formaction: project_stop_path(@project), formmethod: "post", formnovalidate: true,
                      disabled: @project.stop_requested? && !@project.stranded?, class: "btn btn-primary btn-icon composer-stop h-9 w-9",
                      "aria-label": "Stop", title: @project.stop_requested? && !@project.stranded? ? "Stopping…" : "Stop the agent; what's done so far is kept" do %><%= icon :stop, size: 18 %><% end %>
              <% end %>
              <%= form.button disabled: !can_send, class: "btn btn-primary btn-icon composer-send h-9 w-9", "aria-label": "Send", title: "Send (⌘↵)" do %><%= icon :send %><% end %>
            </div>
          </div>
        <% end %>
      </div>
    </aside>

    <section class="studio-panel studio-main" aria-label="App" data-tour-step="3" data-tour-side="left" data-tour-align="center" data-tour-title="Your app, live"
             data-tour-text="This is the real app, running. Click around and try it the way your customers will.">
      <header class="studio-bar">
        <div class="segmented segmented-labels" role="tablist" aria-label="Show">
          <button type="button" role="tab" aria-selected="true" data-preview-target="tab" data-preview-tab-param="preview" data-action="preview#showTab"><%= icon :play, size: 13 %>Preview</button>
          <button type="button" role="tab" aria-selected="false" data-preview-target="tab" data-preview-tab-param="code" data-action="preview#showTab"><%= icon :code, size: 14 %>Code</button>
          <button type="button" role="tab" aria-selected="false" data-preview-target="tab" data-preview-tab-param="design" data-action="preview#showTab"
                  title="The look, colors, fonts, words and photos, without a turn of the agent"
                  data-tour-step="5" data-tour-title="Try on a look"
                  data-tour-text="The shop's look, its colors and fonts, words and photos. Try another look on in seconds, for free, and keep it or go back."><%= icon :contrast, size: 14 %>Design</button>
        </div>
        <div class="hidden md:block"><%= render "projects/devices" %></div>
        <span class="url ml-1 hidden min-w-0 flex-1 truncate md:block"><%= @project.preview_url %></span>
        <div class="ml-auto flex items-center gap-0.5">
          <button type="button" class="btn btn-ghost btn-icon h-8 w-8" data-action="preview#togglePick" data-preview-target="pickButton" aria-pressed="false"
                  data-tour-step="4" data-tour-title="Point at it"
                  data-tour-text="Click this, then click any part of the preview. Your next message will be about exactly that part."
                  aria-label="Point at something in the preview" title="Point at a part of the page to ask about it"><%= icon :target, size: 15 %></button>
          <button type="button" class="btn btn-ghost btn-icon h-8 w-8" data-action="preview#reload" aria-label="Reload preview" title="Reload preview"><%= icon :reload, size: 15 %></button>
          <%= link_to project_preview_path(@project), target: "_blank", class: "btn btn-ghost btn-icon h-8 w-8", "aria-label": "Open preview in a new tab", title: "Open preview in a new tab" do %><%= icon :external, size: 15 %><% end %>
          <button type="button" class="btn btn-ghost btn-icon hidden h-8 w-8 md:inline-flex" data-action="preview#toggleFullscreen" aria-label="Full screen preview" title="Full screen (Esc to leave)"><%= icon :expand, size: 15 %></button>
        </div>
      </header>
      <%= render "projects/preview", project: @project %>
    </section>
</div>
