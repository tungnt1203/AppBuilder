<% content_for :title, @project.name %>
<%= turbo_stream_from @project %>

<div class="flex min-h-full flex-col gap-3 p-3 sm:gap-4 sm:p-4 lg:h-full">
  <header class="glass capsule z-30 flex items-center gap-2 py-1.5 pr-1.5 pl-2" data-controller="preview" data-preview-version-value="<%= @project.preview_version %>">
    <%= link_to root_path, class: "btn btn-ghost btn-icon text-white", "aria-label": "All apps" do %><%= icon :back %><% end %>

    <div class="flex min-w-0 flex-1 items-center gap-3 pr-2 md:flex-none">
      <h1 class="truncate font-semibold text-white"><%= @project.name %></h1>
      <span class="chip hidden rounded-full px-2.5 py-0.5 sm:inline-flex"><%= status_label(@project) %></span>
    </div>

    <div class="well mx-auto hidden min-w-0 items-center gap-1 rounded-full py-1 pr-1 pl-4 md:flex">
      <span class="url truncate"><%= @project.preview_url %></span>
      <button type="button" class="btn btn-ghost btn-icon h-7 w-7" data-action="preview#reload" aria-label="Reload preview" title="Reload preview"><%= icon :reload, size: 14 %></button>
      <%= link_to @project.preview_url, target: "_blank", class: "btn btn-ghost btn-icon h-7 w-7", "aria-label": "Open preview in a new tab", title: "Open preview in a new tab" do %><%= icon :external, size: 14 %><% end %>
    </div>

    <div class="ml-auto flex items-center gap-1 sm:gap-2 md:ml-0">
      <details class="relative" data-controller="keep-open" id="history">
        <summary class="btn btn-ghost on-glass h-8 list-none gap-1.5 px-2.5 sm:px-3" title="Version history"><%= icon :history %><span class="hidden sm:inline">History</span></summary>
        <div class="glass glass-frost fixed inset-x-3 top-20 z-20 rounded-[22px] p-2 sm:absolute sm:inset-x-auto sm:top-auto sm:right-0 sm:mt-2 sm:w-[26rem]">
          <%= render "projects/versions", project: @project %>
        </div>
      </details>

      <% if deployment = @project.latest_deployment %>
        <%= render "projects/deployment_status", project: @project, deployment: deployment %>
      <% end %>
      <%= button_to "Publish", project_deployments_path(@project), disabled: !@project.publishable?, class: "btn btn-primary",
            title: (@project.publish_url if @project.live_deployment) %>
    </div>
  </header>

  <div class="grid min-h-0 flex-1 gap-3 sm:gap-4 lg:grid-cols-[minmax(340px,420px)_1fr]">
    <aside class="glass glass-frost sheet flex min-h-[60vh] flex-col overflow-hidden lg:min-h-0" aria-label="Chat">
      <div id="messages" class="flex-1 space-y-4 overflow-y-auto px-5 pt-5 pb-3" data-controller="autoscroll">
        <% items = chat_items(@project.messages) %>
        <% items.each_with_index do |item, index| %>
          <% if item.is_a?(Array) %>
            <%= render "projects/steps", actions: item, open: @project.working? && index == items.size - 1 %>
          <% else %>
            <%= render item %>
          <% end %>
        <% end %>

        <% if @project.setting_up? || @project.working? %>
          <p class="status status-working pt-1"><%= @project.setting_up? ? "Setting up the project" : "Working on it" %></p>
        <% end %>
      </div>

      <%= form_with model: [ @project, Message.new ], class: "p-3", data: { controller: "composer" } do |form| %>
        <div class="glass capsule flex items-end gap-2 py-1.5 pr-1.5 pl-4 !shadow-none">
          <%= form.text_area :body, rows: 1, disabled: !@project.accepts_messages?, required: true, "aria-label": "Ask for a change",
                placeholder: @project.accepts_messages? ? "Ask for a change" : "Wait for the current step to finish",
                data: { action: "keydown->composer#submitOnShortcut input->composer#resize", composer_target: "input" },
                class: "max-h-40 min-h-9 flex-1 resize-none bg-transparent py-2 text-[0.9375rem] leading-snug outline-none placeholder:text-[var(--text-faint)] disabled:opacity-60" %>
          <%= form.button disabled: !@project.accepts_messages?, class: "btn btn-primary btn-icon", "aria-label": "Send", title: "Send (⌘↵)" do %><%= icon :send %><% end %>
        </div>
      <% end %>
    </aside>

    <section class="glass bezel relative min-h-[70vh] lg:min-h-0" aria-label="Preview">
      <div id="preview" class="absolute inset-[10px]" data-turbo-permanent>
        <iframe id="preview-frame" src="<%= @project.preview_url %>" title="Preview of <%= @project.name %>" class="h-full w-full"></iframe>
      </div>
      <% if @project.setting_up? %>
        <div class="cover absolute inset-[10px] flex items-center justify-center rounded-[21px] text-sm">The preview opens once the project is set up.</div>
      <% end %>
    </section>
  </div>
</div>
