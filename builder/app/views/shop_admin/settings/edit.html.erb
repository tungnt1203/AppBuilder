<%= page_header t(".title"), t(".description") %>

<%= render "shop_admin/settings/tabs" %>

<div class="max-w-2xl space-y-6">
  <%= card class: "space-y-4", id: "payments" do %>
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-sm font-semibold text-ink"><%= t(".stripe.title") %></h2>
      <% if @store.stripe_connected? %>
        <%= @store.stripe_test_mode? ? badge(t(".stripe.test_mode"), tone: :yellow) : badge(t(".stripe.live"), tone: :green) %>
      <% end %>
    </div>

    <% if @store.stripe_connected? %>
      <p class="text-sm text-muted"><%= t(".stripe.connected_html", account: @store.stripe_account_name) %></p>
      <% if @store.stripe_test_mode? %>
        <%= alert t(".stripe.test_mode_hint"), tone: :warning %>
      <% end %>

      <% unless @store.stripe_publishable_key %>
        <%= alert tone: :warning do %>
          <p><%= t(".stripe.publishable_key_missing") %></p>
          <%= form_with url: shop_admin_stripe_connection_path, method: :patch, class: "mt-2 flex flex-wrap gap-2" do |form| %>
            <%= form.text_field :publishable_key, required: true, autocomplete: "off", spellcheck: false, placeholder: @store.stripe_test_mode? ? "pk_test_…" : "pk_live_…",
                  class: "#{field_classes} flex-1", "aria-label": t(".stripe.publishable_key") %>
            <%= form.button t(".stripe.save_publishable_key"), class: button_classes(:secondary, size: :sm) %>
          <% end %>
        <% end %>
      <% end %>

      <% if @store.stripe_webhook_url.present? && @store.stripe_webhook_url == stripe_webhook_url %>
        <p class="flex items-center gap-2 text-sm text-muted"><%= icon "circle-check", size: 16, class: "text-green-600" %> <%= t(".stripe.webhook_on") %></p>
      <% elsif Store.public_url?(stripe_webhook_url) %>
        <%= alert tone: :warning do %>
          <p><%= t(".stripe.webhook_moved") %></p>
          <%= button_to t(".stripe.webhook_register"), shop_admin_stripe_connection_path, method: :patch, class: "mt-2 #{button_classes(:secondary, size: :sm)}" %>
        <% end %>
      <% else %>
        <p class="text-sm text-muted"><%= t(".stripe.webhook_later") %></p>
      <% end %>

      <%= button_to t(".stripe.disconnect"), shop_admin_stripe_connection_path, method: :delete, class: button_classes(:secondary, size: :sm),
            form: { data: { turbo_confirm: t(".stripe.confirm_disconnect") } } %>
    <% else %>
      <p class="text-sm text-muted"><%= t(".stripe.intro") %></p>
      <%= form_with url: shop_admin_stripe_connection_path, class: "space-y-3" do |form| %>
        <div class="space-y-1.5">
          <%= form.label :secret_key, t(".stripe.secret_key"), class: "block text-sm font-medium text-ink" %>
          <%= form.password_field :secret_key, required: true, autocomplete: "off", spellcheck: false, placeholder: "sk_live_… or rk_live_…", class: field_classes %>
          <p class="text-xs text-muted"><%= t(".stripe.secret_key_hint_html", link: link_to("dashboard.stripe.com/apikeys", "https://dashboard.stripe.com/apikeys", target: "_blank", rel: "noopener", class: link_classes)) %></p>
        </div>
        <div class="space-y-1.5">
          <%= form.label :publishable_key, t(".stripe.publishable_key"), class: "block text-sm font-medium text-ink" %>
          <%= form.text_field :publishable_key, required: true, autocomplete: "off", spellcheck: false, placeholder: "pk_live_… or pk_test_…", class: field_classes %>
          <p class="text-xs text-muted"><%= t(".stripe.publishable_key_hint") %></p>
        </div>
        <%= form.button t(".stripe.connect"), class: button_classes %>
      <% end %>
    <% end %>
  <% end %>

  <%= form_with model: @store, url: shop_admin_settings_path, method: :patch, class: "space-y-6" do |form| %>
    <%= form.errors %>

    <%= card class: "space-y-4" do %>
      <h2 class="text-sm font-semibold text-ink"><%= t(".manual.title") %></h2>
      <% if @store.stripe_connected? %>
        <label class="flex items-start gap-3 text-sm">
          <%= form.check_box :manual_payments, class: "mt-0.5" %>
          <span><span class="font-medium text-ink"><%= t(".manual.accept") %></span><span class="block text-muted"><%= t(".manual.accept_hint") %></span></span>
        </label>
      <% end %>
      <%= form.field :payment_instructions, :text_area, rows: 4, hint: t(".payment_hint") %>
      <% if @store.stripe_connected? %>
        <label class="flex items-start gap-3 text-sm">
          <%= form.check_box :stripe_tax, class: "mt-0.5" %>
          <span><span class="font-medium text-ink"><%= Store.human_attribute_name(:stripe_tax) %></span><span class="block text-muted"><%= t(".stripe_tax_hint") %></span></span>
        </label>
      <% end %>
    <% end %>

    <%= card class: "space-y-4" do %>
      <h2 class="text-sm font-semibold text-ink"><%= t(".store") %></h2>
      <div class="space-y-1.5">
        <%= form.label :currency %>
        <%= form.select :currency, Store::CURRENCIES.keys %>
        <p class="text-xs text-muted"><%= t(".currency_hint") %></p>
      </div>
      <%= form.field :announcement, placeholder: t(".announcement_placeholder"), hint: t(".announcement_hint") %>
      <%= form.field :low_stock_threshold, :number_field, min: 0, step: 1, hint: t(".low_stock_hint") %>
    <% end %>

    <%= card class: "space-y-4" do %>
      <h2 class="text-sm font-semibold text-ink"><%= t(".shipping") %></h2>
      <% if @store.printify_connected? %>
        <p class="text-sm text-muted"><%= t(".shipping_printify") %></p>
      <% end %>
      <div class="grid gap-4 sm:grid-cols-2">
        <%= form.field :shipping_first_item, :number_field, step: 0.01, min: 0 %>
        <%= form.field :shipping_additional_item, :number_field, step: 0.01, min: 0 %>
      </div>
      <%= form.field :free_shipping_threshold, :number_field, step: 0.01, min: 0, hint: t(".free_shipping_hint") %>
      <div class="grid gap-4 sm:grid-cols-2">
        <%= form.field :delivery_days_min, :number_field, min: 1, max: 90, step: 1 %>
        <%= form.field :delivery_days_max, :number_field, min: 1, max: 90, step: 1 %>
      </div>
      <p class="-mt-2 text-xs text-muted"><%= t(".delivery_hint") %></p>
      <%= form.field :ship_to_countries_text, label: Store.human_attribute_name(:ship_to_countries), placeholder: "US, CA, GB, AU", hint: t(".countries_hint") %>
    <% end %>

    <%= card class: "space-y-4", id: "ads" do %>
      <div>
        <h2 class="text-sm font-semibold text-ink"><%= t(".ads.title") %></h2>
        <p class="mt-1 text-sm text-muted"><%= t(".ads.intro") %></p>
      </div>
      <%= form.field :meta_pixel_id, placeholder: "123456789012345", inputmode: "numeric", hint: t(".ads.meta_hint") %>
      <% if @store.meta_error.present? %>
        <%= alert @store.meta_error, tone: :warning %>
      <% end %>
      <%= form.field :meta_access_token, :password_field, value: nil, autocomplete: "off", spellcheck: false,
            placeholder: (t(".ads.meta_token_saved") if @store.meta_access_token.present?), hint: t(".ads.meta_token_hint") %>
      <% if @store.meta_access_token.present? %>
        <label class="-mt-2 flex items-center gap-2 text-sm text-muted">
          <%= check_box_tag :remove_meta_access_token, "1", false %> <%= t(".ads.meta_token_remove") %>
        </label>
        <%= form.field :meta_test_event_code, placeholder: "TEST12345", hint: t(".ads.meta_test_code_hint") %>
      <% end %>
      <%= form.field :meta_ad_account_id, placeholder: "act_123456789012345", hint: t(".ads.meta_ad_account_hint") %>
      <% if @store.meta_ad_spend_error.present? %>
        <%= alert @store.meta_ad_spend_error, tone: :warning %>
      <% elsif @store.meta_ad_spend_synced_at %>
        <p class="-mt-2 text-xs text-muted"><%= t(".ads.meta_ad_spend_synced", time: time_ago_in_words(@store.meta_ad_spend_synced_at)) %></p>
      <% end %>
      <%= form.field :tiktok_pixel_id, placeholder: "C4ABCDEFGHIJ1234567", class: "uppercase", hint: t(".ads.tiktok_hint") %>
      <%= form.field :google_tag_id, placeholder: "G-XXXXXXXXXX", class: "uppercase", hint: t(".ads.google_hint") %>
      <div class="space-y-1.5">
        <label for="products_feed_url" class="block text-sm font-medium text-ink"><%= t(".ads.feed") %></label>
        <input id="products_feed_url" type="text" readonly value="<%= storefront_url("/feeds/products.xml") %>" class="<%= field_classes %> font-mono text-xs">
        <p class="text-xs text-muted"><%= t(".ads.feed_hint") %></p>
      </div>
    <% end %>

    <%= form.submit t(".save") %>
  <% end %>
</div>
