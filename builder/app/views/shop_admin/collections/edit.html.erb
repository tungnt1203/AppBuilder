<%= page_header @collection.title, breadcrumbs: [ [ t("shop_admin.collections.index.title"), shop_admin_collections_path ], [ @collection.title, nil ] ] do %>
  <%= link_to t(".view"), storefront_url("/collections/#{@collection.slug}"), class: button_classes(:secondary), target: "_blank" %>
  <%= button_to t(".delete"), shop_admin_collection_path(@collection), method: :delete, class: button_classes(:danger),
        form: { data: { turbo_confirm: t(".confirm_delete", title: @collection.title) } } %>
<% end %>

<%= render "form", collection: @collection %>
