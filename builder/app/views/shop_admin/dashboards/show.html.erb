<%= page_header t(".title"), t(".welcome", name: Current.user.name) %>

<% unless @store.ready_to_sell? %>
  <%# Until the shop can sell: what's done, and a link to each step left. %>
  <% steps = @store.setup_steps %>
  <% links = { product: new_shop_admin_product_path, payments: edit_shop_admin_settings_path(anchor: "payments"),
               policies: edit_shop_admin_policies_path, printify: shop_admin_printify_connection_path } %>
  <%= card class: "mb-6" do %>
    <h2 class="font-semibold text-ink"><%= t(".setup.title") %></h2>
    <ul class="mt-3 space-y-2 text-sm">
      <% steps.each do |step, done| %>
        <% next if step != :product && !shop_administrator? %>
        <li class="flex items-start gap-2">
          <% if done %>
            <%= icon "circle-check", size: 18, class: "mt-px shrink-0 text-emerald-600" %>
            <span class="text-muted"><%= t(".setup.#{step}_done") %></span>
          <% else %>
            <%= icon "circle", size: 18, class: "mt-px shrink-0 text-muted" %>
            <%= link_to t(".setup.#{step}"), links[step], class: link_classes %>
          <% end %>
        </li>
      <% end %>
      <li class="flex items-start gap-2">
        <%= icon "external-link", size: 18, class: "mt-px shrink-0 text-muted" %>
        <%= link_to t(".setup.view"), storefront_url, class: link_classes, target: "_blank" %>
      </li>
    </ul>
  <% end %>
<% end %>

<%# What's waiting on someone, only when something is. %>
<% if @pending_count.positive? || @to_ship_count.positive? %>
  <div class="mb-6 flex flex-wrap gap-3">
    <% { "to_ship" => @to_ship_count, "pending" => @pending_count }.each do |filter, count| %>
      <% next if count.zero? %>
      <%= link_to shop_admin_orders_path(filter:), class: "inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-2 text-sm text-ink hover:border-ink" do %>
        <%= icon filter == "to_ship" ? "package" : "clock", size: 16 %> <%= t(".waiting.#{filter}", count:) %> <%= icon "arrow-right", size: 14, class: "text-muted" %>
      <% end %>
    <% end %>
  </div>
<% end %>

<div class="mb-4 flex flex-wrap items-end justify-between gap-3">
  <h2 class="text-sm font-semibold text-ink"><%= t(".period_title", count: @report.days) %></h2>
  <nav class="flex gap-1 rounded-full border border-line bg-surface p-1 text-sm" aria-label="<%= t(".period") %>">
    <% ShopReport::PERIODS.each do |key, days| %>
      <%= link_to t(".days", count: days), shop_admin_root_path(period: key),
            class: class_names("rounded-full px-3 py-1", key == @report.period ? "bg-ink text-canvas" : "text-muted hover:text-ink"),
            "aria-current": (key == @report.period ? "page" : nil) %>
    <% end %>
  </nav>
</div>

<% totals = @report.totals %>
<% kpis = [ [ :sales, money(totals.sales_cents, @store.currency), :sales_cents ],
            [ :orders, number_with_delimiter(totals.orders), :orders ],
            [ :average, money(totals.average_cents, @store.currency), :average_cents ],
            [ :left, money(totals.left_cents, @store.currency), :left_cents ] ] %>
<% if @report.ad_spend.positive? %>
  <% kpis += [ [ :ad_spend, money(@report.ad_spend, @store.currency), nil ],
               [ :roas, t(".roas_value", times: number_with_precision(@report.return_on_ad_spend, precision: 2)), nil ],
               [ :profit, money(@report.profit_cents, @store.currency), :profit_cents ] ] %>
<% end %>
<div class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <% kpis.each do |key, value, measure| %>
    <% change = measure && @report.change(measure) %>
    <div class="rounded-xl border border-line bg-surface p-5">
      <p class="text-sm text-muted"><%= t(".kpi.#{key}") %></p>
      <p class="mt-1 text-2xl font-semibold tracking-tight text-ink tabular-nums"><%= value %></p>
      <p class="mt-1 flex items-center gap-1 text-xs text-muted">
        <% if change %>
          <%= icon change.negative? ? "arrow-down-right" : "arrow-up-right", size: 13, class: "text-ink" %>
          <span><%= change >= 4 ? t(".times", times: (change + 1).round, count: @report.days) : t(".change", percent: number_to_percentage(change.abs * 100, precision: 0), count: @report.days) %></span>
        <% elsif t(".kpi.#{key}_hint", default: "").present? %>
          <%= t(".kpi.#{key}_hint") %>
        <% elsif key == :orders %>
          <%= t(".today", count: @orders_today) %>
        <% else %>
          <%= t(".no_before", count: @report.days) %>
        <% end %>
      </p>
    </div>
  <% end %>
</div>
<% if @report.ad_spend.zero? %>
  <p class="-mt-2 mb-6 text-sm text-muted">
    <%= t(".add_ad_spend_lead") %> <%= link_to t(".add_ad_spend"), shop_admin_ad_spends_path, class: link_classes %>
  </p>
<% end %>

<%= render "shop_admin/dashboards/sales_chart", report: @report, currency: @store.currency %>

<%= render "shop_admin/dashboards/funnel", report: @report %>

<div class="mb-6 grid gap-6 lg:grid-cols-2">
  <%= card do %>
    <h2 class="text-sm font-semibold text-ink"><%= t(".top_products") %></h2>
    <% top = @report.top_products %>
    <% if top.any? %>
      <% most = top.first.sales_cents.nonzero? || 1 %>
      <ol class="mt-4 space-y-3">
        <% top.each do |line| %>
          <li>
            <div class="flex items-baseline justify-between gap-4 text-sm">
              <span class="min-w-0 truncate text-ink"><%= line.title %></span>
              <span class="shrink-0 tabular-nums text-ink"><%= money(line.sales_cents, @store.currency) %></span>
            </div>
            <div class="mt-1.5 flex items-center gap-3">
              <span class="h-1.5 flex-1 rounded-full bg-surface-muted"><span class="block h-full rounded-full bg-ink" style="width: <%= (line.sales_cents * 100.0 / most).round(1) %>%"></span></span>
              <span class="w-16 shrink-0 text-right text-xs text-muted"><%= t(".sold", count: line.quantity) %></span>
            </div>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="mt-4 text-sm text-muted"><%= t(".nothing_sold") %></p>
    <% end %>
  <% end %>

  <%= card do %>
    <h2 class="text-sm font-semibold text-ink"><%= t(".sources") %></h2>
    <% sources = @report.sources %>
    <% if sources.any? %>
      <% most = sources.map(&:sales_cents).max.nonzero? || 1 %>
      <ul class="mt-4 space-y-3">
        <% sources.each do |source| %>
          <li>
            <div class="flex items-baseline justify-between gap-4 text-sm">
              <span class="min-w-0 truncate text-ink"><%= t(".source_names.#{source.name}", default: source.name.humanize) %></span>
              <span class="shrink-0 tabular-nums text-ink"><%= money(source.sales_cents, @store.currency) %></span>
            </div>
            <div class="mt-1.5 flex items-center gap-3">
              <span class="h-1.5 flex-1 rounded-full bg-surface-muted"><span class="block h-full rounded-full bg-ink" style="width: <%= (source.sales_cents * 100.0 / most).round(1) %>%"></span></span>
              <span class="w-16 shrink-0 text-right text-xs text-muted"><%= t(".source_orders", count: source.orders) %></span>
            </div>
            <% if source.spent_cents.positive? %>
              <p class="mt-1 text-xs text-muted"><%= t(".source_spend", spent: money(source.spent_cents, @store.currency), times: number_with_precision(source.return_on_ad_spend, precision: 2)) %></p>
            <% end %>
          </li>
        <% end %>
      </ul>
      <p class="mt-4 text-xs text-muted"><%= t(".sources_hint") %></p>
    <% else %>
      <p class="mt-4 text-sm text-muted"><%= t(".sources_empty") %></p>
    <% end %>
  <% end %>
</div>

<%= card padded: false do %>
  <div class="flex items-center justify-between border-b border-line px-6 py-4">
    <h2 class="text-sm font-semibold text-ink"><%= t(".recent_orders") %></h2>
    <%= link_to t(".all_orders"), shop_admin_orders_path, class: "text-sm #{link_classes}" if @recent_orders.any? %>
  </div>
  <% if @recent_orders.any? %>
    <ul class="divide-y divide-line">
      <%= render partial: "shop_admin/orders/order", collection: @recent_orders %>
    </ul>
  <% else %>
    <p class="px-6 py-10 text-center text-sm text-muted"><%= t(".no_orders") %></p>
  <% end %>
<% end %>
