<%# What the buyer adds (BuyerInputs): a line of text, a photo, one of the product's pictures
    (Choice) or a background color, and where it shows on the product's photos as they add it: a
    box drawn on a photo and the photos it shows on; for text its font and color and the fonts and
    colors the buyer may pick; a photo box can be split into several (a collage); the pictures and
    colors a buyer picks from. Parts for one kind show only for it (data-for-kinds). %>
<% preview = row["preview"] || {} %>
<% photos = product.persisted? ? product.images.select(&:representable?) : [] %>
<div class="space-y-3 rounded-lg border border-line p-4" data-controller="placement">
  <div class="grid gap-3 sm:grid-cols-[1fr_7rem_8rem_6rem_auto] sm:items-center">
    <%= text_field_tag "product[buyer_inputs][][label]", row["label"], placeholder: t(".label"), aria: { label: t(".label") }, class: field_classes %>
    <%= select_tag "product[buyer_inputs][][kind]", options_for_select(BuyerInputs::KINDS.map { |kind| [ t(".kinds.#{kind}"), kind ] }, row["kind"] || "text"), id: nil,
          aria: { label: t(".kind") }, class: field_classes, data: { placement_target: "kind", action: "placement#restyle" } %>
    <%= text_field_tag "product[buyer_inputs][][key]", row["key"], placeholder: t(".key"), aria: { label: t(".key") }, class: field_classes %>
    <%= number_field_tag "product[buyer_inputs][][max_length]", row["max_length"], min: 1, max: BuyerInputs::MAX_LENGTH, placeholder: "40", aria: { label: t(".max") }, class: field_classes,
          data: { for_kinds: "text" } %>
    <label class="flex items-center gap-2 text-sm">
      <%= check_box_tag "product[buyer_inputs][][required]", "1", row["required"] == true, id: nil, class: "size-4 rounded border-line accent-brand-600" %>
      <%= t(".required") %>
    </label>
  </div>

  <fieldset data-for-kinds="choice">
    <legend class="text-sm font-medium text-ink"><%= t(".options") %></legend>
    <% if product.artwork.attached? %>
      <div class="mt-2 flex flex-wrap gap-2">
        <% product.artwork.each do |art| %>
          <label class="relative w-16 cursor-pointer text-center">
            <%= check_box_tag "product[buyer_inputs][][options][]", art.id, row["options"].nil? || row["options"].include?(art.id), id: nil, class: "peer absolute top-1 left-1 size-4 accent-brand-600" %>
            <%= image_tag art.variant(:thumb), alt: "", class: "size-16 rounded-md bg-surface-muted object-contain p-1 ring-2 ring-transparent peer-checked:ring-brand-500" %>
            <span class="block truncate text-xs text-muted"><%= art.filename.base.humanize %></span>
          </label>
        <% end %>
      </div>
    <% else %>
      <p class="mt-1 text-xs text-muted"><%= t(".options_empty") %></p>
    <% end %>
  </fieldset>

  <% if photos.any? %>
    <details class="group" <%= "open" if row["preview"] %>>
      <summary class="cursor-pointer text-sm font-medium text-ink"><%= t(".show_on_photos") %></summary>
      <div class="mt-3 grid gap-4 md:grid-cols-[minmax(0,18rem)_1fr]">
        <div class="space-y-2">
          <div class="relative touch-none select-none overflow-hidden rounded-lg bg-surface-muted" data-placement-target="stage"
               data-action="pointerdown->placement#start pointermove->placement#drag pointerup->placement#stop pointercancel->placement#stop">
            <%= image_tag (photos.find { |photo| preview["images"].to_a.include?(photo.id) } || photos.first).variant(:large), alt: "", class: "block h-auto w-full", draggable: false, data: { placement_target: "photo" } %>
            <div class="pointer-events-none absolute flex overflow-hidden outline-2 outline-dashed outline-brand-500" data-placement-target="box" hidden>
              <span class="w-full self-center leading-none whitespace-nowrap" data-placement-target="sample"
                    data-text="<%= row["label"].presence || t(".sample") %>" data-photo="<%= t(".sample_photo") %>" data-choice="<%= t(".sample_choice") %>" data-color="<%= t(".sample_color") %>"><%= row["label"].presence || t(".sample") %></span>
            </div>
          </div>
          <p class="text-xs text-muted"><%= t(".draw_hint") %></p>
          <button type="button" class="text-xs text-muted underline hover:text-ink" data-action="placement#clear"><%= t(".clear") %></button>
          <% %w[ x y w h ].each do |side| %>
            <%= hidden_field_tag "product[buyer_inputs][][preview][#{side}]", preview[side], id: nil, data: { placement_target: side } %>
          <% end %>
        </div>

        <div class="space-y-4">
          <fieldset>
            <legend class="text-sm font-medium text-ink"><%= t(".photos") %></legend>
            <p class="text-xs text-muted"><%= t(".photos_hint") %></p>
            <div class="mt-2 flex flex-wrap gap-2">
              <% photos.each do |photo| %>
                <label class="relative cursor-pointer">
                  <%= check_box_tag "product[buyer_inputs][][preview][images][]", photo.id, preview["images"].to_a.include?(photo.id), id: nil, class: "peer absolute top-1 left-1 size-4 accent-brand-600",
                        data: { action: "placement#use", large: url_for(photo.variant(:large)) } %>
                  <%= product_image product, image: photo, size: :thumb, class: "size-16 rounded-md ring-2 ring-transparent peer-checked:ring-brand-500" %>
                </label>
              <% end %>
            </div>
          </fieldset>

          <div class="space-y-1.5" data-for-kinds="photo">
            <%= label_tag nil, t(".layout"), class: "text-sm font-medium text-ink" %>
            <%= select_tag "product[buyer_inputs][][layout]", options_for_select(BuyerInputs::LAYOUTS.keys.map { |layout| [ t(".layouts.#{layout}"), layout ] }, "1x1"), id: nil, class: field_classes %>
            <p class="text-xs text-muted"><%= t(".layout_hint") %></p>
          </div>

          <div class="space-y-4" data-for-kinds="text">
          <div class="grid gap-3 sm:grid-cols-3">
            <div class="space-y-1.5">
              <%= label_tag nil, t(".font"), class: "text-sm font-medium text-ink" %>
              <%= select_tag "product[buyer_inputs][][preview][font]", options_for_select(BuyerInputs::FONTS, preview["font"]), id: nil, class: field_classes, data: { placement_target: "font", action: "placement#restyle" } %>
            </div>
            <div class="space-y-1.5">
              <%= label_tag nil, t(".color"), class: "text-sm font-medium text-ink" %>
              <%= color_field_tag "product[buyer_inputs][][preview][color]", preview["color"] || "#111111", id: nil, class: "h-10 w-full rounded-lg border border-line", data: { placement_target: "color", action: "placement#restyle" } %>
            </div>
            <div class="space-y-1.5">
              <%= label_tag nil, t(".align"), class: "text-sm font-medium text-ink" %>
              <%= select_tag "product[buyer_inputs][][preview][align]", options_for_select(BuyerInputs::ALIGNS.map { |align| [ t(".aligns.#{align}"), align ] }, preview["align"] || "center"), id: nil, class: field_classes, data: { placement_target: "align", action: "placement#restyle" } %>
            </div>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="space-y-1.5">
              <%= label_tag nil, t(".style"), class: "text-sm font-medium text-ink" %>
              <%= select_tag "product[buyer_inputs][][preview][style]", options_for_select(BuyerInputs::STYLES.map { |style| [ t(".styles.#{style}"), style ] }, preview["style"] || "plain"), id: nil, class: field_classes %>
            </div>
            <div class="space-y-1.5">
              <%= label_tag nil, t(".curve"), class: "text-sm font-medium text-ink" %>
              <%= range_field_tag "product[buyer_inputs][][preview][curve]", preview["curve"].to_i, min: -BuyerInputs::MAX_CURVE, max: BuyerInputs::MAX_CURVE, step: 10, id: nil, class: "w-full accent-brand-600" %>
              <p class="text-xs text-muted"><%= t(".curve_hint") %></p>
            </div>
          </div>
          <label class="flex items-center gap-2 text-sm">
            <%= check_box_tag "product[buyer_inputs][][preview][uppercase]", "1", preview["uppercase"] == true, id: nil, class: "size-4 rounded border-line accent-brand-600", data: { placement_target: "uppercase", action: "placement#restyle" } %>
            <%= t(".uppercase") %>
          </label>

          <fieldset>
            <legend class="text-sm font-medium text-ink"><%= t(".fonts") %></legend>
            <p class="text-xs text-muted"><%= t(".fonts_hint") %></p>
            <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
              <% BuyerInputs::FONTS.each do |font| %>
                <label class="flex items-center gap-1.5 text-sm" style="font-family: '<%= font %>'">
                  <%= check_box_tag "product[buyer_inputs][][preview][fonts][]", font, preview["fonts"].to_a.include?(font), id: nil, class: "size-4 rounded border-line accent-brand-600" %>
                  <%= font %>
                </label>
              <% end %>
            </div>
          </fieldset>
          </div>
          <div class="space-y-1.5" data-for-kinds="text color">
            <%= label_tag nil, t(".colors"), class: "text-sm font-medium text-ink" %>
            <%= text_field_tag "product[buyer_inputs][][preview][colors]", preview["colors"].to_a.join(", "), id: nil, placeholder: "#111111, #ffffff, #c8a15a", class: field_classes %>
            <p class="text-xs text-muted" data-for-kinds="text"><%= t(".colors_hint") %></p>
            <p class="text-xs text-muted" data-for-kinds="color"><%= t(".background_hint") %></p>
          </div>
          <fieldset data-for-kinds="photo">
            <legend class="text-sm font-medium text-ink"><%= t(".filters") %></legend>
            <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
              <% BuyerInputs::FILTERS.each do |filter| %>
                <label class="flex items-center gap-1.5 text-sm">
                  <%= check_box_tag "product[buyer_inputs][][preview][filters][]", filter, preview["filters"].to_a.include?(filter), id: nil, class: "size-4 rounded border-line accent-brand-600" %>
                  <%= t(".filter_names.#{filter}") %>
                </label>
              <% end %>
            </div>
            <p class="mt-1 text-xs text-muted"><%= t(".filters_hint") %></p>
          </fieldset>
          <p class="text-sm text-muted" data-for-kinds="photo"><%= t(".photo_hint") %></p>
          <p class="text-sm text-muted" data-for-kinds="choice"><%= t(".choice_hint") %></p>
        </div>
      </div>
    </details>
  <% elsif product.persisted? %>
    <p class="text-xs text-muted"><%= t(".add_photos_first") %></p>
  <% end %>
</div>
