<%# Where Printify's print area of one side (front, back) sits on one of the product's photos of that
    side (Product#print_areas): what the buyer adds in the fields printing on that side is placed on
    its print file from there, so the shop prints it by itself. Drawn like a field's box (placement
    controller); without it personalized orders wait for staff. The back's is only needed when a
    field prints on the back. %>
<% area = product.print_areas[side].to_h %>
<% photos = product.images.select(&:representable?) %>
<% used = product.print_sides.include?(side) %>
<details class="rounded-lg border border-line p-4" data-controller="placement" data-placement-kind="area" <%= "open" if area.present? || used || (side == "front" && product.printify_product_id) %>>
  <summary class="cursor-pointer text-sm font-medium text-ink">
    <%= t(".title", side: t(".sides.#{side}")) %>
    <span class="ml-2 text-xs font-normal <%= area.present? ? "text-green-700" : "text-muted" %>"><%= area.present? ? t(".set") : t(used || side == "front" ? ".not_set" : ".not_needed") %></span>
  </summary>
  <p class="mt-2 text-xs text-muted"><%= t(".hint.#{side}") %></p>
  <% if product.printify_product_id && Store.current.printify %>
    <%# Its own form can't sit in the product's: the button is tied to the hidden form below with form=. %>
    <button type="submit" form="<%= dom_id(product, :find_print_area) %>" name="position" value="<%= side %>" class="mt-3 <%= button_classes(:secondary, size: :sm) %>"><%= t(".find") %></button>
    <p class="mt-1 text-xs text-muted"><%= t(".find_hint") %></p>
  <% end %>
  <div class="mt-3 grid gap-4 md:grid-cols-[minmax(0,18rem)_1fr]">
    <div class="space-y-2">
      <div class="relative touch-none select-none overflow-hidden rounded-lg bg-surface-muted" data-placement-target="stage"
           data-action="pointerdown->placement#start pointermove->placement#drag pointerup->placement#stop pointercancel->placement#stop">
        <%= image_tag photos.first.variant(:large), alt: "", class: "block h-auto w-full", draggable: false, data: { placement_target: "photo" } %>
        <div class="pointer-events-none absolute flex overflow-hidden bg-brand-500/10 outline-2 outline-dashed outline-brand-500" data-placement-target="box" hidden>
          <span class="w-full self-center leading-none whitespace-nowrap" data-placement-target="sample" data-area="<%= t(".sample") %>"><%= t(".sample") %></span>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <% if area.present? && used %>
          <%= link_to t(".sample_file"), shop_admin_product_print_file_path(product, side:), target: "_blank", class: "text-xs font-medium text-brand-700 underline" %>
        <% end %>
        <button type="button" class="text-xs text-muted underline hover:text-ink" data-action="placement#clear"><%= t(".clear") %></button>
      </div>
      <% %w[ x y w h ].each do |edge| %>
        <%= hidden_field_tag "product[print_areas][#{side}][#{edge}]", area[edge], id: nil, data: { placement_target: edge } %>
      <% end %>
    </div>
    <div>
      <p class="text-sm font-medium text-ink"><%= t(".photo") %></p>
      <div class="mt-2 flex flex-wrap gap-2">
        <% photos.each do |photo| %>
          <button type="button" class="size-14 overflow-hidden rounded-md ring-1 ring-line hover:ring-brand-500" data-action="placement#use" data-large="<%= url_for(photo.variant(:large)) %>">
            <%= product_image product, image: photo, size: :thumb, class: "size-full" %>
          </button>
        <% end %>
      </div>
      <p class="mt-1 text-xs text-muted"><%= t(".photo_hint") %></p>
    </div>
  </div>
</details>
