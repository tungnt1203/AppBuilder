<%# Where Printify's print area sits on one of the product's photos (Product#print_area): what the
    buyer adds is placed on the print file from there, so the shop prints it by itself. Drawn like a
    field's box (placement controller); without it personalized orders wait for staff. %>
<% area = product.print_area %>
<% photos = product.images.select(&:representable?) %>
<details class="rounded-lg border border-line p-4" data-controller="placement" data-placement-kind="area" <%= "open" if area.present? %>>
  <summary class="cursor-pointer text-sm font-medium text-ink">
    <%= t(".title") %>
    <span class="ml-2 text-xs font-normal <%= area.present? ? "text-green-700" : "text-muted" %>"><%= area.present? ? t(".set") : t(".not_set") %></span>
  </summary>
  <p class="mt-2 text-xs text-muted"><%= t(".hint") %></p>
  <div class="mt-3 grid gap-4 md:grid-cols-[minmax(0,18rem)_1fr]">
    <div class="space-y-2">
      <div class="relative touch-none select-none overflow-hidden rounded-lg bg-surface-muted" data-placement-target="stage"
           data-action="pointerdown->placement#start pointermove->placement#drag pointerup->placement#stop pointercancel->placement#stop">
        <%= image_tag photos.first.variant(:large), alt: "", class: "block h-auto w-full", draggable: false, data: { placement_target: "photo" } %>
        <div class="pointer-events-none absolute flex overflow-hidden bg-brand-500/10 outline-2 outline-dashed outline-brand-500" data-placement-target="box" hidden>
          <span class="w-full self-center leading-none whitespace-nowrap" data-placement-target="sample" data-area="<%= t(".sample") %>"><%= t(".sample") %></span>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <% if area.present? && product.buyer_inputs.any? %>
          <%= link_to t(".sample_file"), shop_admin_product_print_file_path(product), target: "_blank", class: "text-xs font-medium text-brand-700 underline" %>
        <% end %>
        <button type="button" class="text-xs text-muted underline hover:text-ink" data-action="placement#clear"><%= t(".clear") %></button>
      </div>
      <% %w[ x y w h ].each do |side| %>
        <%= hidden_field_tag "product[print_area][#{side}]", area[side], id: nil, data: { placement_target: side } %>
      <% end %>
    </div>
    <div class="space-y-4">
      <div class="space-y-1.5">
        <%= label_tag nil, t(".position"), class: "text-sm font-medium text-ink" %>
        <%= select_tag "product[print_area][position]", options_for_select(Product::PRINT_POSITIONS.map { |position| [ t(".positions.#{position}"), position ] }, area["position"] || "front"), id: nil, class: field_classes %>
      </div>
      <div>
        <p class="text-sm font-medium text-ink"><%= t(".photo") %></p>
        <div class="mt-2 flex flex-wrap gap-2">
          <% photos.each do |photo| %>
            <button type="button" class="size-14 overflow-hidden rounded-md ring-1 ring-line hover:ring-brand-500" data-action="placement#use" data-large="<%= url_for(photo.variant(:large)) %>">
              <%= product_image product, image: photo, size: :thumb, class: "size-full" %>
            </button>
          <% end %>
        </div>
        <p class="mt-1 text-xs text-muted"><%= t(".photo_hint") %></p>
      </div>
    </div>
  </div>
</details>
