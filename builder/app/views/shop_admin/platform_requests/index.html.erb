<%= page_header t(".title"), t(".description") %>

<% if @requests.any? %>
  <%= card padded: false do %>
    <ul class="divide-y divide-line">
      <% @requests.each do |request| %>
        <li class="flex flex-col gap-3 px-6 py-4 sm:flex-row sm:items-start sm:justify-between" id="<%= dom_id(request) %>">
          <div class="min-w-0 space-y-1">
            <p class="text-sm whitespace-pre-line text-ink"><%= request.body %></p>
            <p class="text-xs text-muted">
              <%= t(".asked", time: time_ago_in_words(request.updated_at)) %>
              <% if request.times_asked > 1 %>(<%= t(".times", count: request.times_asked) %>)<% end %>
            </p>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <%= badge t(".statuses.#{request.status}"), tone: { "open" => :yellow, "done" => :green, "declined" => :gray }.fetch(request.status) %>
            <% if Current.user.administrator? %>
              <% (PlatformRequest::STATUSES - [ request.status ]).each do |status| %>
                <%= button_to t(".mark.#{status}"), shop_admin_platform_request_path(request), method: :patch, params: { status: }, class: button_classes(:secondary, size: :sm) %>
              <% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
<% else %>
  <%= empty_state t(".empty_title"), t(".empty_description") %>
<% end %>
