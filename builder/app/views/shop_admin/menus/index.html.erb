<%= page_header t(".title"), t(".description") do %>
  <%= link_to t(".new"), new_shop_admin_menu_path, class: button_classes %>
<% end %>

<% if @menus.any? %>
  <%= card padded: false do %>
    <ul class="divide-y divide-line">
      <% @menus.each do |menu| %>
        <li>
          <%= link_to edit_shop_admin_menu_path(menu), class: "flex items-center justify-between gap-4 px-6 py-3 hover:bg-surface-muted" do %>
            <span class="text-sm font-medium text-ink"><%= menu.title %></span>
            <span class="font-mono text-xs text-muted"><%= menu.key %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% else %>
  <%= empty_state t(".empty_title"), t(".empty_description") do %>
    <%= link_to t(".new"), new_shop_admin_menu_path, class: button_classes %>
  <% end %>
<% end %>
