<%= page_header t(".title"), t(".description") %>

<%= render "shop_admin/settings/tabs" %>

<% if @theme_setting.schema.blank? %>
  <%# Before the storefront is published, its words and photos are changed in the studio's Design tab. %>
  <% project = current_shop.project %>
  <%= empty_state t(".empty_title"), t(project ? ".empty_description_studio" : ".empty_description") do %>
    <%= link_to t(".open_design"), project_path(project, anchor: "design"), class: button_classes(:secondary) if project %>
  <% end %>
<% else %>
  <%= form_with url: shop_admin_theme_setting_path, method: :patch, scope: :theme_setting, multipart: true, class: "max-w-2xl space-y-6" do |form| %>
    <%= @theme_setting.errors.full_messages.to_sentence if @theme_setting.errors.any? %>
    <%= card class: "space-y-4" do %>
      <% @theme_setting.schema.each do |field| %>
        <% key = field["key"] %>
        <div class="space-y-1.5">
          <% if field["type"] == "boolean" %>
            <label class="flex items-center gap-2 text-sm">
              <%= hidden_field_tag "theme_setting[values][#{key}]", "0" %>
              <%= check_box_tag "theme_setting[values][#{key}]", "1", @theme_setting.resolved[key] == true, class: "size-4 rounded border-line accent-brand-600" %>
              <%= field["label"] %>
            </label>
          <% elsif field["type"] == "image" %>
            <%= label_tag key, field["label"], class: "block text-sm font-medium text-ink" %>
            <% if (attachment = @theme_setting.image_attachment(key)) %>
              <%= image_tag attachment, alt: "", class: "h-24 rounded-lg object-cover" if attachment.representable? %>
              <p class="text-sm text-muted"><%= attachment.filename %></p>
              <label class="flex items-center gap-2 text-sm text-muted">
                <%= check_box_tag "theme_setting[remove_images][]", key, false, class: "size-4 rounded border-line accent-brand-600" %>
                <%= t(".remove_image") %>
              </label>
            <% elsif field["default"] %>
              <%= image_tag field["default"], alt: "", class: "h-24 rounded-lg object-cover" %>
              <p class="text-sm text-muted"><%= t(".default_image") %></p>
            <% end %>
            <%= file_field_tag "theme_setting[images][#{key}]", accept: "image/*", class: field_classes %>
          <% elsif field["type"] == "select" %>
            <%= label_tag key, field["label"], class: "block text-sm font-medium text-ink" %>
            <%= select_tag "theme_setting[values][#{key}]", options_for_select(field["options"], @theme_setting.resolved[key]), class: field_classes %>
          <% elsif field["type"] == "color" %>
            <%= label_tag key, field["label"], class: "block text-sm font-medium text-ink" %>
            <div class="flex items-center gap-2" data-controller="color-field">
              <input type="color" class="h-10 w-14 shrink-0 cursor-pointer rounded-lg border border-line bg-surface p-1" aria-label="<%= field["label"] %>"
                     data-color-field-target="picker" data-action="input->color-field#pick">
              <%= text_field_tag "theme_setting[values][#{key}]", @theme_setting.values[key], id: key, placeholder: t(".theme_color"), class: field_classes,
                    data: { color_field_target: "code", action: "input->color-field#show" } %>
            </div>
          <% elsif field["type"].in?(%w[ richtext ]) %>
            <%= label_tag key, field["label"], class: "block text-sm font-medium text-ink" %>
            <%= text_area_tag "theme_setting[values][#{key}]", @theme_setting.resolved[key], rows: 4, class: field_classes %>
          <% else %>
            <%= label_tag key, field["label"], class: "block text-sm font-medium text-ink" %>
            <%= text_field_tag "theme_setting[values][#{key}]", @theme_setting.resolved[key], class: field_classes %>
          <% end %>
        </div>
      <% end %>
    <% end %>
    <%= form.submit t(".save") %>
  <% end %>
<% end %>
