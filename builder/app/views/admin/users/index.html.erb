<% content_for :title, "Accounts" %>

<div class="admin-header">
  <div>
    <h1 class="admin-title">Accounts</h1>
    <p class="muted text-sm">Anyone can sign up and build their own apps. Admins can also open everyone's apps and manage accounts.</p>
  </div>
</div>

<div class="max-w-3xl">
  <ul class="admin-card admin-list overflow-hidden">
    <% @users.each do |user| %>
      <li class="account-row" id="<%= dom_id(user) %>">
        <span class="avatar" aria-hidden="true"><%= user.name.first.upcase %></span>
        <div class="min-w-0">
          <p class="truncate font-semibold">
            <%= user.name %>
            <% if user == Current.user %><span class="faint text-[0.8125rem] font-medium">(you)</span><% end %>
          </p>
          <p class="faint truncate text-[0.8125rem]">
            <%= user.email_address %> · <%= pluralize(user.projects_count, "app") %> ·
            <%= number_to_currency(user.spent_this_month) %><%= " of #{number_to_currency(user.monthly_budget, precision: 0)}" if user.monthly_budget %> this month
          </p>
        </div>

        <div class="flex items-center gap-1.5">
          <% if user.role_changeable_by?(Current.user) %>
            <%= button_to admin_user_path(user), method: :patch, params: { user: { role: user.admin? ? "member" : "admin" } },
                  class: "btn btn-ghost h-8 px-3 text-[0.8125rem]", form: { class: "contents" },
                  title: user.admin? ? "Can no longer open others' apps or manage accounts" : "Can open everyone's apps and manage accounts" do %>
              <%= user.admin? ? "Remove admin" : "Make admin" %>
            <% end %>
          <% end %>
          <span class="faint min-w-14 text-right text-[0.8125rem] font-medium"><%= user.role.capitalize %></span>
          <% if user.removable_by?(Current.user) %>
            <%= button_to admin_user_path(user), method: :delete, class: "btn btn-ghost btn-icon h-8 w-8 text-[var(--danger)]",
                  form: { class: "contents", data: { turbo_confirm: "Remove #{user.name}'s account?" } },
                  "aria-label": "Remove #{user.name}", title: "Remove account" do %>
              <%= icon :trash, size: 15 %>
            <% end %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
</div>
