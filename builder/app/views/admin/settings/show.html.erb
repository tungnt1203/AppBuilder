<% content_for :title, "Settings" %>

<div class="admin-header">
  <div>
    <h1 class="admin-title">Settings</h1>
    <p class="muted text-sm">Set your payments, Printify and ad accounts once. Every shop you build gets them, now and when you make or publish a new one.</p>
  </div>
</div>

<div class="grid max-w-5xl gap-8 xl:grid-cols-[minmax(0,1fr)_20rem]">
  <%= form_with model: @setting, url: admin_settings_path, method: :patch, class: "admin-card flex flex-col gap-6 p-5 sm:p-6" do |form| %>
    <% if @setting.errors.any? %>
      <p class="admin-alert"><%= @setting.errors.full_messages.to_sentence %></p>
    <% end %>

    <section class="flex flex-col gap-2">
      <h2 class="font-semibold">Card payments: Stripe</h2>
      <p class="muted text-sm">Your Stripe secret and publishable keys (Developers → API keys). Test keys (sk_test_…, pk_test_…) let you try buying with card 4242 4242 4242 4242.</p>
      <% if @setting.stripe_secret_key.present? %>
        <p class="text-sm">Connected: <span class="font-mono"><%= BusinessSetting.masked(@setting.stripe_secret_key) %></span><%= " (test mode)" if @setting.stripe_test_mode? %></p>
      <% end %>
      <%= form.password_field :stripe_secret_key, value: nil, autocomplete: "off", class: "admin-field",
            placeholder: @setting.stripe_secret_key.present? ? "Paste a new key to replace it" : "sk_live_… or sk_test_…", "aria-label": "Stripe secret key" %>
      <%= form.text_field :stripe_publishable_key, autocomplete: "off", spellcheck: false, class: "admin-field",
            placeholder: "Publishable key: pk_live_… or pk_test_…", "aria-label": "Stripe publishable key" %>
      <% if @setting.stripe_secret_key.present? %>
        <label class="muted flex items-center gap-2 text-sm"><%= form.check_box :clear_stripe_secret_key %> Disconnect Stripe from all my shops</label>
      <% end %>
    </section>

    <section class="flex flex-col gap-2">
      <h2 class="font-semibold">Printing: Printify</h2>
      <p class="muted text-sm">A personal access token from Printify (Account → Connections), and the Printify shop your products are in. Each shop of yours imports its products from there.</p>
      <% if @setting.printify_token.present? %>
        <p class="text-sm">Connected<%= ": #{@setting.printify_shop_title}" if @setting.printify_shop_title %></p>
      <% end %>
      <%= form.password_field :printify_token, value: nil, autocomplete: "off", class: "admin-field",
            placeholder: @setting.printify_token.present? ? "Paste a new token to replace it" : "Printify personal access token", "aria-label": "Printify token" %>
      <% if @printify_shops.present? && @printify_shops.many? %>
        <%= form.select :printify_shop_id, @printify_shops.map { |shop| [ shop["title"], shop["id"] ] }, { include_blank: "Pick the Printify shop" },
              class: "admin-field", "aria-label": "Printify shop" %>
      <% end %>
      <% if @setting.printify_token.present? %>
        <label class="muted flex items-center gap-2 text-sm"><%= form.check_box :clear_printify_token %> Disconnect Printify from all my shops</label>
      <% end %>
    </section>

    <section class="flex flex-col gap-2">
      <h2 class="font-semibold">Ads</h2>
      <p class="muted text-sm">Your shops send page views, add to cart and purchases to the accounts you fill in.</p>
      <div class="grid gap-2 sm:grid-cols-2">
        <%= form.text_field :meta_pixel_id, class: "admin-field", placeholder: "Meta Pixel ID", "aria-label": "Meta Pixel ID", inputmode: "numeric" %>
        <%= form.password_field :meta_access_token, value: nil, autocomplete: "off", class: "admin-field",
              placeholder: @setting.meta_access_token.present? ? "Conversions API token: saved" : "Conversions API token (optional)", "aria-label": "Meta Conversions API token" %>
        <%= form.text_field :tiktok_pixel_id, class: "admin-field", placeholder: "TikTok Pixel ID", "aria-label": "TikTok Pixel ID" %>
        <%= form.text_field :google_tag_id, class: "admin-field", placeholder: "Google tag (G-… or AW-…)", "aria-label": "Google tag ID" %>
      </div>
      <% if @setting.meta_access_token.present? %>
        <label class="muted flex items-center gap-2 text-sm"><%= form.check_box :clear_meta_access_token %> Remove the Conversions API token</label>
      <% end %>
    </section>

    <div class="flex items-center gap-3">
      <%= form.button "Save and apply to my shops", class: "admin-button" %>
      <p class="faint text-[0.8125rem]">Keys are stored encrypted.</p>
    </div>
  <% end %>

  <% if @shops.any? %>
    <section aria-labelledby="shops_heading">
      <h2 id="shops_heading" class="admin-section-title">Your shops</h2>
      <ul class="admin-card admin-list overflow-hidden">
        <% @shops.each do |shop| %>
          <% result = shop.business_sync_result || {} %>
          <% errors = Array(result["errors"]) %>
          <li class="flex flex-col gap-1 px-4 py-3">
            <div class="flex items-center justify-between gap-3">
              <%= link_to shop.name, edit_shop_admin_settings_path(shop), class: "truncate text-sm font-semibold" %>
              <span class="faint shrink-0 text-[0.8125rem]">
                <%= shop.business_synced_at ? "Applied #{time_ago_in_words(shop.business_synced_at)} ago" : "Not applied yet" %>
              </span>
            </div>
            <% if shop.business_synced_at %>
              <p class="text-[0.8125rem] <%= errors.any? ? "text-[var(--danger)]" : "muted" %>">
                <%= [ ("Stripe: #{result["stripe"]}" if result["stripe"]), ("Printify: #{result["printify"]}" if result["printify"]),
                      ("Ads: #{result["pixels"]}" if result["pixels"]), *errors ].compact.join("; ") %>
              </p>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
