<% content_for :title, "Orders" %>

<div class="admin-header">
  <div>
    <h1 class="admin-title">Orders</h1>
    <p class="muted text-sm">All your shops, the last 30 days.</p>
  </div>
  <%= button_to admin_orders_refresh_path, class: "admin-button admin-button-secondary", form: { class: "contents" } do %>
    <%= icon :reload, size: 15 %> Refresh
  <% end %>
</div>

<% if @projects.empty? %>
  <p class="admin-card p-6 text-sm">You have no shops yet. Build one from the <%= link_to "Apps", root_path, class: "underline" %> page.</p>
<% else %>
  <% @totals.each do |currency, totals| %>
    <ul class="mb-8 grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="Last 30 days<%= " in #{currency}" if @totals.many? %>">
      <% [ [ "Sales", shop_money(totals["sales_cents"], currency) ], [ "Orders", totals["orders"] ],
           [ "You keep", (shop_money(totals["margin_cents"], currency) if totals["margin_cents"].nonzero?) || "—" ],
           [ "Need you", totals["needs_action"] ] ].each do |label, value| %><%# Printify's problems are among them %>
        <li class="admin-card admin-stat">
          <span class="faint text-[0.8125rem]"><%= label %></span>
          <span class="admin-stat-value"><%= value %></span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <div class="grid gap-8 xl:grid-cols-[minmax(0,1fr)_20rem]">
    <section aria-labelledby="latest_heading">
      <h2 id="latest_heading" class="admin-section-title">Latest orders</h2>
      <% if @orders.any? %>
        <ul class="admin-card admin-list overflow-hidden">
          <% @orders.each do |order| %>
            <% project = order["project"] %>
            <% url = ShopOrders.order_url(project, order["token"]) || project_path(project) %>
            <li>
              <%= link_to url, class: "admin-row", target: (url.start_with?("http") ? "_blank" : nil) do %>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-semibold">#<%= order["number"] %> · <%= order["name"] %></p>
                  <p class="faint truncate text-[0.8125rem]">
                    <%= project.name %><%= " (preview)" if project.orders_summary_source == "preview" %> ·
                    <%= time_ago_in_words(Time.iso8601(order["placed_at"])) %> ago
                  </p>
                  <% if order["problem"] %><p class="truncate text-[0.8125rem] text-[var(--danger)]"><%= order["problem"] %></p><% end %>
                </div>
                <span class="faint hidden text-[0.8125rem] sm:block"><%= order["status"].humanize %></span>
                <span class="w-24 text-right text-sm font-medium tabular-nums"><%= shop_money(order["total_cents"], order["currency"]) %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="admin-card p-6 text-sm muted">No orders yet. They show here as soon as someone buys from one of your shops.</p>
      <% end %>
    </section>

    <section aria-labelledby="shops_heading">
      <h2 id="shops_heading" class="admin-section-title">Your shops</h2>
      <ul class="admin-card admin-list overflow-hidden">
        <% @projects.each do |project| %>
          <% summary = project.orders_summary || {} %>
          <li class="admin-row">
            <div class="min-w-0 flex-1">
              <%= link_to project.name, project_path(project), class: "block truncate text-sm font-semibold" %>
              <p class="faint truncate text-[0.8125rem]">
                <% if summary["errors"].present? %>
                  <span class="text-[var(--danger)]"><%= summary["errors"].first %></span>
                <% elsif project.orders_summary_at %>
                  <%= pluralize(summary["orders"].to_i, "order") %> · <%= shop_money(summary["sales_cents"].to_i, summary["currency"]) %>
                  <%= "· #{summary["needs_action"]} to handle" if summary["needs_action"].to_i.positive? %>
                  <%= "· #{pluralize(summary["problems"], "Printify problem")}" if summary["problems"].to_i.positive? %>
                <% else %>
                  Not checked yet
                <% end %>
              </p>
              <p class="faint text-[0.75rem]">
                <%= project.orders_summary_source == "live" ? "Published" : "Preview" %><%= " · #{time_ago_in_words(project.orders_summary_at)} ago" if project.orders_summary_at %>
              </p>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  </div>
<% end %>
