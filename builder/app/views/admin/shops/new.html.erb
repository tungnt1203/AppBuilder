<% content_for :title, "New shop" %>

<div class="admin-header">
  <div>
    <h1 class="admin-title">New shop</h1>
    <p class="muted text-sm">Its name, and the address its storefront is published at. You can add people to run it with you afterwards.</p>
  </div>
</div>

<%= form_with model: @shop, url: admin_shops_path, class: "admin-card flex max-w-xl flex-col gap-4 p-5 sm:p-6" do |form| %>
  <% if @shop.errors.any? %>
    <p class="admin-alert"><%= @shop.errors.full_messages.to_sentence %></p>
  <% end %>

  <div class="flex flex-col gap-1.5">
    <%= form.label :name, class: "text-sm font-medium" %>
    <%= form.text_field :name, required: true, autofocus: true, class: "admin-field", placeholder: "Good Things Co." %>
  </div>

  <div class="flex flex-col gap-1.5">
    <%= form.label :subdomain, "Address", class: "text-sm font-medium" %>
    <div class="flex items-center gap-2">
      <%= form.text_field :subdomain, required: true, class: "admin-field", placeholder: "goodthings", autocapitalize: "none", spellcheck: false %>
      <span class="muted shrink-0 text-sm">.<%= Rails.configuration.x.publish_domain %></span>
    </div>
    <p class="faint text-[0.8125rem]">Lowercase letters, numbers and dashes.</p>
  </div>

  <div class="flex flex-col gap-1.5">
    <%= form.label :currency, class: "text-sm font-medium" %>
    <%= form.select :currency, Store::CURRENCIES.keys, {}, class: "admin-field" %>
  </div>

  <div><%= form.button "Open the shop", class: "admin-button" %></div>
<% end %>
