<% content_for :title, "Reset your password" %>

<div>
  <h1 class="text-xl font-semibold tracking-tight">Reset your password</h1>
  <p class="mt-1.5 text-sm text-[var(--text-muted)]">We'll email you a link to choose a new one.</p>
</div>

<%= form_with url: passwords_path, class: "flex flex-col gap-4" do |form| %>
  <div class="field-group">
    <%= form.label :email_address, "Email" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "field" %>
  </div>

  <%= form.submit "Email me a link", class: "btn btn-primary mt-1 h-10 w-full" %>
<% end %>

<% content_for :footer do %>
  <%= link_to "Back to sign in", new_session_path, class: "font-semibold underline" %>
<% end %>
